//! Address spaces: the mappings threads run in.
//!
//! The lower half of the 64-bit address space belongs to the program,
//! from USER_START to USER_TOP; the kernel lives in the upper half, which
//! user code cannot reach. Frames are mapped and unmapped with the `map`
//! and `unmap` system calls.
//!
//! Since Phase 8 an address space also holds anonymous memory, as POSIX's
//! `mmap` makes it: zeroed pages the kernel makes when they are first
//! touched (`map_anonymous`), or filled from a file when they are first
//! touched (`map_file`). Each page of it is charged to the resource domain of the
//! process the space belongs to while the space maps it, so a domain's
//! limit bounds its programs' memory. A forked process (radix-process(2))
//! gets the same pages, shared until either side writes to one, which
//! then gets a copy of its own, unless the mapping is SHARED, when both
//! keep writing to the same pages, those first touched after the fork
//! included.
//!
//! Futexes (`futex_wait`, `futex_wake`) are the waiting that a C library's
//! locks and condition variables are built on, as Linux's: a thread waits
//! on a 32-bit word of this address space while it holds a value, until a
//! thread wakes the word's waiters. A word of memory other address spaces
//! map too (a SHARED mapping, a frame, a ring) is the same word in each,
//! wherever each maps it, so a wake in one process reaches the waiters in
//! another.

module address_space;

/// The lowest address a mapping may start at; the pages below it stay
/// unmapped, so a null pointer always faults.
const USER_START: u64 = 0x10000;
/// The end of the addresses a mapping may use.
const USER_TOP: u64 = 0x7ffffffff000;
/// The size of a page, in bytes.
const PAGE_SIZE: u64 = 4096;
/// Where the kernel puts anonymous memory it chooses the place of: the
/// highest free range below this address.
const ANONYMOUS_TOP: u64 = 0x7fe000000000;

/// How `map_anonymous` and `map_file` place and share what they map.
flags MapFlags: u32 {
    /// Map at `address` exactly, replacing whatever is mapped there.
    fixed = 0;
    /// Map at `address` exactly, failing with already_mapped if anything
    /// is mapped there.
    fixed_no_replace = 1;
    /// Keep the pages shared with processes forked from this one, rather
    /// than giving each side a copy when it writes: anonymous memory, and
    /// since Phase 16 the memory files of `/devices/shm` (`map_file`).
    shared = 2;
}

/// How `remap` may place the mapping it changes, as Linux's `mremap`
/// flags. (Since version 5, ADR 0629.)
flags RemapFlags: u32 {
    /// Move it elsewhere if it cannot grow where it is.
    may_move = 0;
    /// With may_move: move it to `to`, whatever is mapped there going
    /// first.
    fixed = 1;
    /// With may_move: move it, its size unchanged, and keep its old place
    /// mapped as it was, empty: private memory only.
    keep_old = 2;
}

/// How `futex_wait_set` waits. (Since version 4, ADR 0617.)
flags FutexWaitFlags: u32 {
    /// `timeout_ns` is a time on the clock, not a time from now.
    absolute = 0;
    /// With absolute: the clock is the wall clock, in nanoseconds since
    /// 1970, rather than the monotonic one, as Linux's
    /// FUTEX_CLOCK_REALTIME.
    realtime = 1;
    /// Wait as long as it takes: `timeout_ns` is ignored.
    forever = 2;
}

/// The bit set that `futex_wait` waits with, and `futex_wake` wakes:
/// all of them, as Linux's FUTEX_BITSET_MATCH_ANY.
const FUTEX_ALL: u32 = 0xffffffff;
/// The most entries of a robust list that are looked at when a thread
/// ends, as Linux's ROBUST_LIST_LIMIT. (Since version 4, ADR 0617.)
const ROBUST_LIST_MAX: u32 = 2048;

/// A virtual address space.
interface address_space = 0x0003 version 5 {
    kind = address_space;
    /// Whether a page is mapped at `address`, and with which rights.
    method query = 1 (address: addr) -> (mapped: bool, rights: Rights)
        raises [no_such_slot, empty_slot, missing_rights, invalid_argument];
    /// Maps `size` bytes (rounded up to whole pages) of zeroed anonymous
    /// memory with `rights`: any of read, write and execute, and none for
    /// memory that cannot be touched yet. Write and execute go together
    /// only for private memory of the caller's own address space when its
    /// process has memory.jit (radix-jit(2), ADR 0624); otherwise they are
    /// invalid_argument, and they always are with shared. With fixed or
    /// fixed_no_replace it goes at `address` (a page boundary); otherwise
    /// `address` is a hint, and the kernel takes the highest free range
    /// below it, or below ANONYMOUS_TOP, that fits. Returns where it went.
    /// Needs the control right.
    method map_anonymous = 2 (address: addr, size: u64, rights: Rights, flags: MapFlags)
        -> (address: addr)
        raises [no_such_slot, empty_slot, missing_rights, invalid_argument, no_memory,
                already_mapped];
    /// Gives the anonymous memory in the `size` bytes from `address` (a
    /// page boundary) the access `rights` allows, as `map_anonymous`
    /// takes them. Every page must be anonymous memory. Write with
    /// execute is missing_rights for a file's pages or shared memory, even
    /// with memory.jit. Needs the control right.
    method protect = 3 (address: addr, size: u64, rights: Rights) -> ()
        raises [no_such_slot, empty_slot, missing_rights, invalid_argument, no_memory,
                not_mapped];
    /// Unmaps whatever is mapped in the `size` bytes from `address` (a
    /// page boundary): anonymous memory and frames alike; pages that hold
    /// nothing are passed over. Needs the control right.
    method discard = 4 (address: addr, size: u64) -> ()
        raises [no_such_slot, empty_slot, missing_rights, invalid_argument, no_memory];
    /// Maps `size` bytes of the file in slot `file`, from byte `offset` (a
    /// multiple of the page size), as `map_anonymous` does: each page is
    /// filled the first time it is touched, with the file's contents from
    /// there and zeros past its end. Once filled, a page is the process's
    /// own copy: neither side sees what the other writes later. Needs the
    /// control right, and the read right on the file.
    ///
    /// With shared, a memory file of `/devices/shm` (radix-directory(2)'s
    /// `shm`, ADR 0490) is mapped itself: every process that maps it maps
    /// the same pages, and sees every write to them, and `read` and
    /// `write` of the file too; a page past the file's end faults
    /// (SIGBUS). Writing needs the write right on the file too, and
    /// `protect` never makes a mapping without it writable
    /// (missing_rights). A shared mapping of another file that may be
    /// written fails with no_device; one that may only be read is mapped
    /// as without shared.
    method map_file = 5 (address: addr, size: u64, rights: Rights, flags: MapFlags, file: slot,
                         offset: u64) -> (address: addr)
        raises [no_such_slot, empty_slot, wrong_kind, missing_rights, invalid_argument,
                no_memory, already_mapped, is_directory, no_device, io, corrupt];
    /// Waits while the 32-bit word at `address` (4-byte aligned) holds
    /// `expected`, until `futex_wake` wakes it, for at most `timeout_ns`
    /// nanoseconds (0: no limit). Fails with would_block at once if the
    /// word holds another value, timed_out once the time has passed, and
    /// interrupted when a signal comes. Needs the control right.
    method futex_wait = 6 (address: addr, expected: u32, timeout_ns: u64) -> ()
        raises [no_such_slot, empty_slot, missing_rights, invalid_argument, bad_address,
                would_block, timed_out, interrupted];
    /// Wakes up to `count` of the threads waiting on the word at `address`
    /// in this address space, or on the same word of shared memory in
    /// another, first come first woken, and returns how many it woke.
    /// Needs the control right.
    method futex_wake = 7 (address: addr, count: u32) -> (woken: u32)
        raises [no_such_slot, empty_slot, missing_rights, invalid_argument];
    /// Detaches the System V segment that radix-directory(2)'s
    /// `ipc_attach` attached at `address` (shmdt(2), ADR 0490): unmaps
    /// what is left of that mapping, and notes the caller's process and
    /// the time in the segment's status. Fails with invalid_argument if
    /// no segment is attached there. Needs the control right.
    method detach = 8 (address: addr) -> ()
        raises [no_such_slot, empty_slot, missing_rights, invalid_argument];
    /// Lets go of the pages of the anonymous memory mapped in the `size`
    /// bytes from `address` (a page boundary), and keeps the mappings: a
    /// page touched again is made again, zeroed, or filled from its file,
    /// or found in the shared memory it maps, as Linux's MADV_DONTNEED
    /// leaves a private mapping (since version 3). Pages of frames, rings
    /// and devices are passed over. Fails with not_mapped, having let go
    /// of nothing, if a page of the range is not mapped. Needs the control
    /// right.
    method forget = 9 (address: addr, size: u64) -> ()
        raises [no_such_slot, empty_slot, missing_rights, invalid_argument, not_mapped];
    /// Waits as `futex_wait` does, with the bit set `bits` (not 0): only
    /// a wake whose bits share one with it wakes the thread, as Linux's
    /// FUTEX_WAIT_BITSET. `futex_wait` waits with FUTEX_ALL. `timeout_ns`
    /// is a time from now unless `flags` has absolute (0 from now ends the
    /// wait at once, once the word is found to hold `expected`); a time on
    /// the wall clock is taken as a time on the monotonic clock once, as
    /// the wait begins. Fails as `futex_wait` does, and with
    /// invalid_argument for `bits` 0 or realtime without absolute. (Since
    /// version 4, ADR 0617.)
    method futex_wait_set = 10 (address: addr, expected: u32, bits: u32, timeout_ns: u64,
                                flags: FutexWaitFlags) -> ()
        raises [no_such_slot, empty_slot, missing_rights, invalid_argument, bad_address,
                would_block, timed_out, interrupted];
    /// Wakes up to `count` of the threads waiting on the word at
    /// `address` whose bit sets share a bit with `bits` (not 0), as
    /// Linux's FUTEX_WAKE_BITSET, and returns how many it woke. (Since
    /// version 4, ADR 0617.)
    method futex_wake_set = 11 (address: addr, count: u32, bits: u32) -> (woken: u32)
        raises [no_such_slot, empty_slot, missing_rights, invalid_argument];
    /// Wakes up to `count` of the threads waiting on the word at
    /// `address`, and moves up to `moved` of the others to wait on the
    /// word at `to` instead, where `futex_wake` of `to` wakes them, as
    /// Linux's FUTEX_REQUEUE; with `compare`, first checks that the word
    /// at `address` holds `expected`, and fails with would_block if it
    /// does not, as FUTEX_CMP_REQUEUE. Returns how many it woke and how
    /// many it moved. `address` and `to` may be in this address space or
    /// in shared memory, each as `futex_wake` takes it, and may be the
    /// same word, whose moved threads stay where they are. A thread there
    /// is no memory to move is woken instead, and counted as moved: a
    /// waiter allows for an early wake-up anyway. With `compare`, this
    /// must be the caller's own address space (invalid_argument
    /// otherwise). (Since version 4, ADR 0617.)
    method futex_requeue = 12 (address: addr, count: u32, to: addr, moved: u32,
                               expected: u32, compare: bool) -> (woken: u32, moved: u32)
        raises [no_such_slot, empty_slot, missing_rights, invalid_argument, bad_address,
                would_block];
    /// Changes the word at `to` by `operation`, Linux's FUTEX_WAKE_OP
    /// encoding of an operation, an argument, a comparison and its
    /// argument, in one atomic step, then wakes up to `count` threads
    /// waiting on `address` and, if the word's old value compares true,
    /// up to `count_to` of those waiting on `to`; returns how many it
    /// woke in all. This must be the caller's own address space
    /// (invalid_argument otherwise). A word `to` that cannot be written
    /// fails with bad_address, and an unknown operation or comparison with
    /// not_supported, as Linux's ENOSYS, each having changed nothing.
    /// (Since version 4, ADR 0617.)
    method futex_wake_op = 13 (address: addr, count: u32, to: addr, count_to: u32,
                               operation: u32) -> (woken: u32)
        raises [no_such_slot, empty_slot, missing_rights, invalid_argument, bad_address,
                not_supported];
    /// Changes the mapping of the `size` bytes from `address` (a page
    /// boundary) to `new_size` bytes, both rounded up to whole pages, and
    /// returns where it is now, as Linux's `mremap`. Shrinking unmaps the
    /// bytes past `new_size`, whatever is mapped there, and needs only a
    /// mapping at `address`. Growing extends it where the pages after it
    /// are free, if it ends its mapping; with may_move it moves elsewhere
    /// if it cannot, at `to` if `to` is free, or where `map_anonymous`
    /// would put it, and with fixed it moves to `to`. A move takes the
    /// pages with it, never copying them: each keeps its memory, or its
    /// place in swap, and its access. `size` 0 maps a shared mapping's
    /// pages from `address` a second time, the old mapping staying.
    /// Otherwise the `size` bytes must lie in one mapping of anonymous
    /// memory, private, shared or filled from a file (not_mapped if they
    /// do not); a frame's, a ring's or a card's cannot grow or move
    /// (wrong_kind). Fails with no_memory if it cannot grow where it is
    /// and may not move, or finds no room, and with invalid_argument for a
    /// `new_size` of 0, flags that need may_move without it, keep_old with
    /// sizes that differ or for shared memory, `size` 0 for private
    /// memory, or a `to` that is not a page boundary or meets the old
    /// mapping. Needs the control right. (Since version 5, ADR 0629.)
    method remap = 14 (address: addr, size: u64, new_size: u64, flags: RemapFlags, to: addr)
        -> (address: addr)
        raises [no_such_slot, empty_slot, missing_rights, invalid_argument, no_memory,
                not_mapped, wrong_kind];
}
