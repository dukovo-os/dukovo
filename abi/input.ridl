//! Keyboards and pointers (Phase 9, ADR 0097; Phase 11a, ADR 0148): the
//! keys pressed on them, and how pointers move, as events.
//!
//! _/devices/kbd_ (radix-files(7)) is every keyboard of the machine as one:
//! the built-in PS/2 one behind the i8042 controller, which is QEMU's
//! default keyboard and how laptops such as the reference Dell connect
//! theirs, and since Phase 11a USB keyboards, with their media keys. A read
//! returns whole Event structures, as many as fit, the oldest the reader
//! has not read: each description keeps its own place, so two readers each
//! see every event, and a new description starts with the events after it
//! was opened, never the keys typed before. A read waits for an event
//! unless the file is non-blocking, and fails with invalid_argument if the
//! buffer cannot hold one; one that falls more than EVENTS_KEPT events
//! behind fails with gone once, then goes on with the oldest kept. `poll`
//! finds it readable while an event waits.
//!
//! The kernel turns no key into text: consoled(8) does, with its key map,
//! and handles the virtual terminal keys (Alt+F1 to Alt+F6). Key codes are
//! Linux's (<linux/input-event-codes.h>), so that key maps and programs
//! made for Linux's evdev read them as they would there. A key held down
//! repeats: the events after the first are REPEATED. A PS/2 keyboard
//! repeats a key itself; a USB keyboard does not, so the kernel repeats the
//! last key one pressed while it is held, 250 ms after it went down and
//! then every 33 ms, as Linux does.
//!
//! _/devices/mouse_ is every pointer as one: USB mice, and tablets such as
//! QEMU's `usb-tablet`, which say where they point rather than how far they
//! moved. It is read as _/devices/kbd_ is, in whole Motion structures, each
//! what one report of one pointer changed; a reader that falls more than
//! MOTIONS_KEPT behind fails with gone once.
//!
//! _/devices/input/N_ (release 1.1, ADR 0706) is one device: a keyboard, a
//! mouse, a tablet. A number is never used twice, so an old file never
//! means a new device. A read returns whole InputEvent structures: what
//! one report of the device said, then an EV_SYN event with SYN_REPORT.
//! Every event of a report carries the time of the interrupt that brought
//! it. Keys and buttons are EV_KEY events with Linux's codes, 1 for down
//! and 0 for up, and never repeat. A mouse's movement is EV_REL, in the
//! counts it reported: no speed curve, no scaling. A wheel is
//! REL_WHEEL_HI_RES, in 120ths of a notch, so a plain wheel says 120 a
//! notch. Where a device points is EV_ABS, within the range INPUT_AXIS
//! gives.
//!
//! Each description has the events it has not read in a ring of its own,
//! which grows from 4 KiB to INPUT_EVENTS_KEPT events. A reader that
//! falls further behind loses what waited and reads an EV_SYN event with
//! SYN_DROPPED: it drops the report it was in the middle of and asks
//! INPUT_STATE what is down.
//!
//! Input follows the screen (ADR 0706). INPUT_TIE ties a description to a
//! holder of radix-display(2), once. From then on events reach it only
//! while that holder is in front. When the holder goes to the back the
//! reader reads SYN_PAUSED and then nothing: it takes every key as let
//! go. When the holder is in front again it reads SYN_RESUMED and asks
//! INPUT_STATE. A description tied to no holder reads everything, as a
//! reader of _/devices/kbd_ or _/devices/mouse_ that is tied to none
//! does; the files are root's.
//!
//! Ctrl+Alt+Delete is the secure key (ADR 0708). The kernel sees it on
//! any keyboard before any reader does. If a program holds
//! _/devices/display/attention_, the kernel brings that holder to the
//! front and pauses every other description of every input file, tied or
//! not, until that holder ends it (radix-display(2)'s ATTENTION_END); the
//! press of Delete reaches no reader at all.
//!
//! _/devices/input/control_ says which devices there are: INPUT_LIST
//! lists them, and a read returns InputChange structures, one for each
//! device that came or went since the description was opened.

module input;

/// How many events _/devices/kbd_ keeps for readers that fall behind.
const EVENTS_KEPT: u32 = 512;

/// The key went up.
const RELEASED: u16 = 0;
/// The key went down.
const PRESSED: u16 = 1;
/// The key is held down, and the keyboard repeats it.
const REPEATED: u16 = 2;

/// radix-file(2)'s `control` request on _/devices/kbd_ that lights the
/// lock lights of every keyboard: `argument` holds LED_* bits, and the lights
/// whose bits are clear go out. Needs the write right.
const SET_LEDS: u32 = 0x4b420001;
/// The Scroll Lock light.
const LED_SCROLL_LOCK: u32 = 1;
/// The Num Lock light.
const LED_NUM_LOCK: u32 = 2;
/// The Caps Lock light.
const LED_CAPS_LOCK: u32 = 4;

/// One key going down, repeating or going up.
struct Event {
    /// When: nanoseconds since boot, on the clock radix-process(2)'s
    /// `clock` calls monotonic.
    time_ns: u64;
    /// Which key: a KEY_* code.
    code: u16;
    /// What it did: RELEASED, PRESSED or REPEATED.
    value: u16;
    /// Always 0.
    reserved: u32;
}

/// How many motions _/devices/mouse_ keeps for readers that fall behind.
const MOTIONS_KEPT: u32 = 512;

/// The left button, in Motion's `buttons`.
const BUTTON_LEFT: u32 = 1;
/// The right button.
const BUTTON_RIGHT: u32 = 2;
/// The middle button, or the wheel pressed.
const BUTTON_MIDDLE: u32 = 4;
/// The side button nearer the user: back, in a browser.
const BUTTON_SIDE: u32 = 8;
/// The side button farther from the user: forward.
const BUTTON_EXTRA: u32 = 16;

/// The most of Motion's `x` and `y`.
const POSITION_MAX: u32 = 65535;

/// Motion's `flags`: `x` and `y` say where the pointer points.
const MOTION_ABSOLUTE: u32 = 1;

/// What one report of a pointer changed.
struct Motion {
    /// When: nanoseconds since boot, as Event's.
    time_ns: u64;
    /// How far it moved, in the device's counts: right is more.
    dx: i32;
    /// Down is more.
    dy: i32;
    /// The wheel's detents: away from the user is more.
    wheel: i32;
    /// The horizontal wheel's: right is more.
    pan: i32;
    /// Where it points, with MOTION_ABSOLUTE: from 0 at the screen's left
    /// edge to POSITION_MAX at its right.
    x: u32;
    /// From 0 at its top to POSITION_MAX at its bottom.
    y: u32;
    /// The buttons down after it: BUTTON_* bits, then a bit for each
    /// further button.
    buttons: u32;
    /// MOTION_ABSOLUTE, or 0.
    flags: u32;
}

/// How many events a description of _/devices/input/N_ keeps at most
/// for a reader that falls behind: 64 KiB of them.
const INPUT_EVENTS_KEPT: u32 = 4096;
/// How many it has room for before its ring first grows: 4 KiB of them.
const INPUT_EVENTS_FIRST: u32 = 256;
/// How many changes a description of _/devices/input/control_ keeps.
const INPUT_CHANGES_KEPT: u32 = 64;

/// The kind of an InputEvent that ends what one report said (SYN_REPORT)
/// or is a mark from the kernel (the other SYN_* codes). The kinds and
/// the codes are Linux's (<linux/input-event-codes.h>).
const EV_SYN: u16 = 0;
/// A key or a button: `code` is a KEY_* or a BTN_*, `value` 1 as it goes
/// down and 0 as it goes up.
const EV_KEY: u16 = 1;
/// A movement: `code` is a REL_*, `value` how far, in the device's counts.
const EV_REL: u16 = 2;
/// A position: `code` is an ABS_*, `value` where, within the axis's range.
const EV_ABS: u16 = 3;
/// A switch: `code` is a SW_*, `value` 1 as it goes on and 0 as it goes
/// off.
const EV_SW: u16 = 5;
/// A light. No event has this kind; INPUT_BITS says which lights a
/// device has.
const EV_LED: u16 = 0x11;

/// The end of what one report said.
const SYN_REPORT: u16 = 0;
/// Events were lost because the reader fell too far behind.
const SYN_DROPPED: u16 = 3;
/// The reader's holder is no longer in front, or the secure key was
/// pressed: no event follows until SYN_RESUMED. Radix's own, as is
/// SYN_RESUMED; Linux has no code this high.
const SYN_PAUSED: u16 = 0x10;
/// Events reach the reader again.
const SYN_RESUMED: u16 = 0x11;

/// Right is more.
const REL_X: u16 = 0;
/// Down is more.
const REL_Y: u16 = 1;
/// The wheel, in 120ths of a notch: away from the user is more.
const REL_WHEEL_HI_RES: u16 = 0x0b;
/// The horizontal wheel, in 120ths of a notch: right is more.
const REL_HWHEEL_HI_RES: u16 = 0x0c;

/// From the left edge.
const ABS_X: u16 = 0;
/// From the top edge.
const ABS_Y: u16 = 1;

/// The lid of a laptop: on when it is shut.
const SW_LID: u16 = 0;

/// The Num Lock light, in INPUT_BITS's answer for EV_LED.
const LED_NUML: u16 = 0;
/// The Caps Lock light.
const LED_CAPSL: u16 = 1;
/// The Scroll Lock light.
const LED_SCROLLL: u16 = 2;

/// The left button. A pointer's further buttons follow BTN_TASK, up to
/// the sixteenth at 0x11f.
const BTN_LEFT: u16 = 0x110;
/// The right button.
const BTN_RIGHT: u16 = 0x111;
/// The middle button, or the wheel pressed.
const BTN_MIDDLE: u16 = 0x112;
/// The side button nearer the user.
const BTN_SIDE: u16 = 0x113;
/// The side button farther from the user.
const BTN_EXTRA: u16 = 0x114;
/// Forward.
const BTN_FORWARD: u16 = 0x115;
/// Back.
const BTN_BACK: u16 = 0x116;
/// The eighth button.
const BTN_TASK: u16 = 0x117;
/// A pen's tip, on a tablet.
const BTN_TOOL_PEN: u16 = 0x140;
/// A finger on a touch screen or a touchpad.
const BTN_TOUCH: u16 = 0x14a;

/// How many codes each kind has: INPUT_BITS's and INPUT_STATE's answers
/// have a bit for each, the code's eighth in the byte and the rest the
/// bit in it.
const KEY_CODES: u32 = 0x300;
/// REL_* codes.
const REL_CODES: u32 = 0x10;
/// ABS_* codes.
const ABS_CODES: u32 = 0x40;
/// SW_* codes.
const SW_CODES: u32 = 0x20;
/// LED_* codes.
const LED_CODES: u32 = 0x10;
/// EV_* kinds.
const EV_KINDS: u32 = 0x20;

/// How a device is connected, in InputInfo's `bus`: by USB. Linux's
/// numbers.
const BUS_USB: u16 = 0x03;
/// Made by a virtual machine's host: virtio, Hyper-V.
const BUS_VIRTUAL: u16 = 0x06;
/// The PS/2 controller.
const BUS_I8042: u16 = 0x11;
/// I2C, as a laptop's touchpad is.
const BUS_I2C: u16 = 0x18;

/// radix-file(2)'s `control` request on _/devices/input/N_ that fills the
/// buffer with the device's InputInfo. Returns its size.
const INPUT_INFO: u32 = 0x494e0001;
/// Fills the buffer with a bit for each code of the kind `argument` names
/// (an EV_*) that the device has, as much as fits; for EV_SYN, a bit for
/// each kind it has. Returns the bytes of the whole answer.
const INPUT_BITS: u32 = 0x494e0002;
/// Fills the buffer with the InputAxis of the ABS_* code `argument`
/// names. Fails with invalid_argument if the device has no such axis.
const INPUT_AXIS: u32 = 0x494e0003;
/// Fills the buffer with a bit for each key and button that is down
/// (`argument` EV_KEY) or each switch that is on (EV_SW), as INPUT_BITS
/// does. A paused description is answered with none.
const INPUT_STATE: u32 = 0x494e0004;
/// Ties the description to the holder of radix-display(2) whose file is
/// in the slot `argument` names, which needs no right, and forgets the
/// events the description had not read. Fails with busy if it is tied
/// already, and with invalid_argument if the slot's file holds no screen.
const INPUT_TIE: u32 = 0x494e0005;
/// Fills the buffer with the device's name, as much as fits, and returns
/// its length in bytes: at most INPUT_TEXT_MAX.
const INPUT_NAME: u32 = 0x494e0006;
/// Fills the buffer with where the device is plugged in, as INPUT_NAME
/// does with the name: "ps2" for the keyboard controller's, "usb-1-2/0"
/// for interface 0 of the USB device at port 2 of bus 1, and
/// "pci-0000:00:05.0" for a virtual machine's own device at that PCI
/// address.
const INPUT_PLACE: u32 = 0x494e0007;
/// Fills the buffer with the device's serial number, as INPUT_NAME does
/// with the name. It is empty for a device that has none.
const INPUT_SERIAL: u32 = 0x494e0008;
/// The most bytes INPUT_NAME, INPUT_PLACE and INPUT_SERIAL answer with.
const INPUT_TEXT_MAX: u32 = 64;
/// On _/devices/input/control_: fills the buffer with the number (a u32)
/// of each device there is, as many as fit, lowest first. Returns how
/// many there are.
const INPUT_LIST: u32 = 0x494e0010;

/// InputChange's `what`: the device came.
const DEVICE_ADDED: u32 = 1;
/// The device went.
const DEVICE_REMOVED: u32 = 2;
/// Changes were lost because the reader fell more than
/// INPUT_CHANGES_KEPT behind: it asks INPUT_LIST. `device` is 0.
const DEVICES_LOST: u32 = 3;

/// One thing a device said, or a mark.
struct InputEvent {
    /// When the report came: nanoseconds since boot, on the clock
    /// radix-process(2)'s `clock` calls monotonic, taken at the interrupt.
    time_ns: u64;
    /// What kind: an EV_*.
    kind: u16;
    /// Which key, axis or mark.
    code: u16;
    /// What it did.
    value: i32;
}

/// What a device says of itself.
struct InputInfo {
    /// Its number: the N of _/devices/input/N_.
    device: u32;
    /// How it is connected: a BUS_*.
    bus: u16;
    /// Its maker's number, on that bus; 0 if it has none.
    vendor: u16;
    /// Its model's number.
    product: u16;
    /// Its version.
    version: u16;
    /// How many reports a second it asks to be read for; 0 where the
    /// device sends when it likes.
    rate_hz: u32;
}

/// One axis of a device that says where it points. Linux's
/// `input_absinfo`.
struct InputAxis {
    /// Where it last was.
    value: i32;
    /// The least it says.
    min: i32;
    /// The most.
    max: i32;
    /// How much it wavers while still.
    fuzz: i32;
    /// How far from the middle still counts as the middle.
    flat: i32;
    /// Units in a millimetre, or 0 if the device does not say.
    resolution: i32;
}

/// A device that came or went.
struct InputChange {
    /// When: nanoseconds since boot.
    time_ns: u64;
    /// The device's number.
    device: u32;
    /// DEVICE_ADDED, DEVICE_REMOVED or DEVICES_LOST.
    what: u32;
}

/// Escape.
const KEY_ESC: u16 = 1;
/// The 1 key; 2 to 9 follow it, then 0.
const KEY_1: u16 = 2;
/// The 2 key.
const KEY_2: u16 = 3;
/// The 3 key.
const KEY_3: u16 = 4;
/// The 4 key.
const KEY_4: u16 = 5;
/// The 5 key.
const KEY_5: u16 = 6;
/// The 6 key.
const KEY_6: u16 = 7;
/// The 7 key.
const KEY_7: u16 = 8;
/// The 8 key.
const KEY_8: u16 = 9;
/// The 9 key.
const KEY_9: u16 = 10;
/// The 0 key.
const KEY_0: u16 = 11;
/// Minus.
const KEY_MINUS: u16 = 12;
/// Equals.
const KEY_EQUAL: u16 = 13;
/// Backspace.
const KEY_BACKSPACE: u16 = 14;
/// Tab.
const KEY_TAB: u16 = 15;
/// Q.
const KEY_Q: u16 = 16;
/// W.
const KEY_W: u16 = 17;
/// E.
const KEY_E: u16 = 18;
/// R.
const KEY_R: u16 = 19;
/// T.
const KEY_T: u16 = 20;
/// Y.
const KEY_Y: u16 = 21;
/// U.
const KEY_U: u16 = 22;
/// I.
const KEY_I: u16 = 23;
/// O.
const KEY_O: u16 = 24;
/// P.
const KEY_P: u16 = 25;
/// Left bracket.
const KEY_LEFTBRACE: u16 = 26;
/// Right bracket.
const KEY_RIGHTBRACE: u16 = 27;
/// Enter.
const KEY_ENTER: u16 = 28;
/// The left Ctrl.
const KEY_LEFTCTRL: u16 = 29;
/// A.
const KEY_A: u16 = 30;
/// S.
const KEY_S: u16 = 31;
/// D.
const KEY_D: u16 = 32;
/// F.
const KEY_F: u16 = 33;
/// G.
const KEY_G: u16 = 34;
/// H.
const KEY_H: u16 = 35;
/// J.
const KEY_J: u16 = 36;
/// K.
const KEY_K: u16 = 37;
/// L.
const KEY_L: u16 = 38;
/// Semicolon.
const KEY_SEMICOLON: u16 = 39;
/// Apostrophe.
const KEY_APOSTROPHE: u16 = 40;
/// Grave accent, left of 1.
const KEY_GRAVE: u16 = 41;
/// The left Shift.
const KEY_LEFTSHIFT: u16 = 42;
/// Backslash.
const KEY_BACKSLASH: u16 = 43;
/// Z.
const KEY_Z: u16 = 44;
/// X.
const KEY_X: u16 = 45;
/// C.
const KEY_C: u16 = 46;
/// V.
const KEY_V: u16 = 47;
/// B.
const KEY_B: u16 = 48;
/// N.
const KEY_N: u16 = 49;
/// M.
const KEY_M: u16 = 50;
/// Comma.
const KEY_COMMA: u16 = 51;
/// Full stop.
const KEY_DOT: u16 = 52;
/// Slash.
const KEY_SLASH: u16 = 53;
/// The right Shift.
const KEY_RIGHTSHIFT: u16 = 54;
/// The keypad's *.
const KEY_KPASTERISK: u16 = 55;
/// The left Alt.
const KEY_LEFTALT: u16 = 56;
/// Space.
const KEY_SPACE: u16 = 57;
/// Caps Lock.
const KEY_CAPSLOCK: u16 = 58;
/// F1; F2 to F10 follow it.
const KEY_F1: u16 = 59;
/// F2.
const KEY_F2: u16 = 60;
/// F3.
const KEY_F3: u16 = 61;
/// F4.
const KEY_F4: u16 = 62;
/// F5.
const KEY_F5: u16 = 63;
/// F6.
const KEY_F6: u16 = 64;
/// F7.
const KEY_F7: u16 = 65;
/// F8.
const KEY_F8: u16 = 66;
/// F9.
const KEY_F9: u16 = 67;
/// F10.
const KEY_F10: u16 = 68;
/// Num Lock.
const KEY_NUMLOCK: u16 = 69;
/// Scroll Lock.
const KEY_SCROLLLOCK: u16 = 70;
/// The keypad's 7 (Home).
const KEY_KP7: u16 = 71;
/// The keypad's 8 (Up).
const KEY_KP8: u16 = 72;
/// The keypad's 9 (Page Up).
const KEY_KP9: u16 = 73;
/// The keypad's minus.
const KEY_KPMINUS: u16 = 74;
/// The keypad's 4 (Left).
const KEY_KP4: u16 = 75;
/// The keypad's 5.
const KEY_KP5: u16 = 76;
/// The keypad's 6 (Right).
const KEY_KP6: u16 = 77;
/// The keypad's plus.
const KEY_KPPLUS: u16 = 78;
/// The keypad's 1 (End).
const KEY_KP1: u16 = 79;
/// The keypad's 2 (Down).
const KEY_KP2: u16 = 80;
/// The keypad's 3 (Page Down).
const KEY_KP3: u16 = 81;
/// The keypad's 0 (Insert).
const KEY_KP0: u16 = 82;
/// The keypad's full stop (Delete).
const KEY_KPDOT: u16 = 83;
/// Zenkaku/Hankaku, on Japanese keyboards.
const KEY_ZENKAKUHANKAKU: u16 = 85;
/// The key between the left Shift and Z on ISO keyboards.
const KEY_102ND: u16 = 86;
/// F11.
const KEY_F11: u16 = 87;
/// F12.
const KEY_F12: u16 = 88;
/// The Japanese Ro key.
const KEY_RO: u16 = 89;
/// Katakana.
const KEY_KATAKANA: u16 = 90;
/// Hiragana.
const KEY_HIRAGANA: u16 = 91;
/// The Japanese Henkan key.
const KEY_HENKAN: u16 = 92;
/// The Japanese Katakana/Hiragana key.
const KEY_KATAKANAHIRAGANA: u16 = 93;
/// The Japanese Muhenkan key.
