//! The platform capability (Phase 11, ADR 0208): the controls of the
//! machine that no device of its own has, which its embedded controller
//! keeps: its fans' duties and curves, its LEDs, and the addressable LEDs
//! of its ARGB header. On the Framework Desktop these are Framework's
//! embedded controller's (ADR 0207). It also reads the firmware's SMBIOS
//! tables whole, serial numbers and all (ADR 0231), and its UEFI
//! variables, where the boot manager keeps its entries, which it writes
//! too (ADR 0313).
//!
//! The kernel gives Spark the one capability to them when it starts.
//! Spark gives a service a copy in SLOT_PLATFORM, with the read and
//! control rights, when its file asks for admin.hardware (spark(8)), and
//! ectool(8) uses the one in its slot. Asking needs the read right, and
//! changing anything the control right.
//!
//! A method fails with not_supported where the kernel drives no embedded
//! controller, or where the controller lacks the commands the method
//! takes (`describe` says which it has); with out_of_range for a fan,
//! sensor or LED it does not have; with timed_out where it does not
//! answer within a second, and with io where it refuses a command.

module platform;

/// The most addressable LEDs `set_rgb` reaches.
const RGB_LEDS: u32 = 128;

/// The controls an embedded controller has, by the commands it takes.
flags Controls: u32 {
    /// Fixed fan duties, and giving fans back (`set_fan_duty`,
    /// `auto_fan`).
    fan_duty = 0;
    /// Fan curves (`fan_curve`, `set_fan_curve`): Framework's, on the
    /// Framework Desktop.
    fan_curve = 1;
    /// LEDs (`led`, `set_led`, `auto_led`).
    leds = 2;
    /// The addressable LEDs of an ARGB header, or of an RGB keyboard
    /// (`set_rgb`).
    rgb = 3;
}

/// An LED, by the Chromium EC's number for it.
enum Led: u32 {
    /// The battery's charge.
    battery = 0;
    /// The machine's power state, on its power button or case.
    power = 1;
    /// On the power adapter.
    adapter = 2;
    /// On the left side.
    left = 3;
    /// On the right side.
    right = 4;
    /// The Framework Desktop's second power LED, on its mainboard.
    second_power = 7;
}

/// Which of the firmware's SMBIOS tables `smbios` copies.
enum SmbiosTable: u32 {
    /// The entry point, `_SM3_` or `_SM_`, which says the version of
    /// SMBIOS the tables follow: as Linux's
    /// /sys/firmware/dmi/tables/smbios_entry_point has it.
    entry_point = 0;
    /// The structures, up to and with the one that ends them: as Linux's
    /// /sys/firmware/dmi/tables/DMI.
    structures = 1;
}

/// The UEFI global variable vendor, 8be4df61-93ca-11d2-aa0d-00e098032b8c,
/// whose variables the boot manager reads, as its two halves are passed:
/// the GUID's first 8 bytes as they lie in memory, little-endian, then the
/// other 8.
const GLOBAL_VARIABLE_LOW: u64 = 0x11d2_93ca_8be4_df61;
/// See GLOBAL_VARIABLE_LOW.
const GLOBAL_VARIABLE_HIGH: u64 = 0x8c2b_0398_e000_0daa;

/// The longest UEFI variable `efi_variable` reads and `set_efi_variable`
/// writes, in bytes: a firmware's whole store is seldom larger.
const EFI_VARIABLE_MAX: u32 = 262144;

/// The longest UEFI variable name the methods take, in bytes of UCS-2,
/// without the NUL that ends it.
const EFI_NAME_MAX: u32 = 1024;

/// A UEFI variable's attributes (UEFI 2.10, section 8.2).
flags EfiAttributes: u32 {
    /// Kept across restarts.
    non_volatile = 0;
    /// Readable before the firmware's boot services end.
    boot_service_access = 1;
    /// Readable after: every variable the methods reach has it.
    runtime_access = 2;
    /// A hardware error record.
    hardware_error_record = 3;
    /// Written with a counter of writes and a signature (deprecated).
    authenticated_write_access = 4;
    /// Written with a time and a signature, as Secure Boot's keys are.
    time_based_authenticated_write_access = 5;
    /// Each write adds to the value instead of replacing it.
    append_write = 6;
}

/// The machine's platform controls. Each method needs the read right to
/// ask, or the control right to change something.
interface platform = 0x0010 version 3 {
    kind = platform;
    /// What the embedded controller has: its controls, its fans and its
    /// temperature sensors (a bit for each, by its number from 0 in the
    /// controller's memory map, as /kernel/class/hwmon numbers them from
    /// 1), and its LEDs (a bit for each Led). Needs the read right.
    method describe = 1 () -> (controls: Controls, fans: u32, sensors: u32, leds: u32)
        raises [no_such_slot, empty_slot, wrong_kind, missing_rights, not_supported];
    /// Runs fan `fan` at `percent` of its duty, from 0 to 100, which takes
    /// it from the controller's own control until `auto_fan`. Restarting
    /// the machine gives it back too. Needs the control right.
    method set_fan_duty = 2 (fan: u32, percent: u32) -> ()
        raises [no_such_slot, empty_slot, wrong_kind, missing_rights, invalid_argument,
                out_of_range, not_supported, timed_out, io];
    /// Gives fan `fan` back to the controller, which runs it as its
    /// curve and the temperatures say. Needs the control right.
    method auto_fan = 3 (fan: u32) -> ()
        raises [no_such_slot, empty_slot, wrong_kind, missing_rights, out_of_range,
                not_supported, timed_out, io];
    /// Fan `fan`'s curve: below `min_temperature` of temperature sensor
    /// `sensor`, in degrees Celsius, the fan stops, or runs at `min_duty`
    /// if `always_on`; from there its duty rises in a straight line to
    /// `max_duty` at `max_temperature` and above. `duty` is the duty the
    /// controller gives it now, in percent. Needs the read right.
    method fan_curve = 4 (fan: u32) -> (min_temperature: u32, max_temperature: u32,
                                         min_duty: u32, max_duty: u32, always_on: bool,
                                         sensor: u32, duty: u32)
        raises [no_such_slot, empty_slot, wrong_kind, missing_rights, out_of_range,
                not_supported, timed_out, io];
    /// Gives fan `fan` a curve, as `fan_curve` describes one. The
    /// temperatures must rise (`min_temperature` below `max_temperature`)
    /// and the duties must not fall (`min_duty` at most `max_duty`, at most
    /// 100), and the sensor must be one the controller has. The curve
    /// stays until the controller itself restarts. Needs the control
    /// right.
    method set_fan_curve = 5 (fan: u32, min_temperature: u32, max_temperature: u32,
                              min_duty: u32, max_duty: u32, always_on: bool, sensor: u32) -> ()
        raises [no_such_slot, empty_slot, wrong_kind, missing_rights, invalid_argument,
                out_of_range, not_supported, timed_out, io];
    /// The brightest LED `led` goes in each of its colors, 0 for a color
    /// it lacks. Needs the read right.
    method led = 6 (led: Led) -> (red: u32, green: u32, blue: u32, yellow: u32, white: u32,
                                  amber: u32)
        raises [no_such_slot, empty_slot, wrong_kind, missing_rights, invalid_argument,
                out_of_range, not_supported, timed_out, io];
    /// Lights LED `led` at a brightness in each of its colors, at most
    /// 255 each (0 for off), which takes it from the controller until
    /// `auto_led`. Needs the control right.
    method set_led = 7 (led: Led, red: u32, green: u32, blue: u32, yellow: u32, white: u32,
                        amber: u32) -> ()
        raises [no_such_slot, empty_slot, wrong_kind, missing_rights, invalid_argument,
                out_of_range, not_supported, timed_out, io];
    /// Gives LED `led` back to the controller, which lights it for the
    /// machine's state. Needs the control right.
    method auto_led = 8 (led: Led) -> ()
        raises [no_such_slot, empty_slot, wrong_kind, missing_rights, invalid_argument,
                out_of_range, not_supported, timed_out, io];
    /// Gives the addressable LEDs from `first` on the colors in `colors`,
    /// three bytes for each (red, green and blue), up to the RGB_LEDS'th
    /// LED. Needs the control right.
    method set_rgb = 9 (first: u32, colors: in bytes) -> ()
        raises [no_such_slot, empty_slot, wrong_kind, missing_rights, invalid_argument,
                bad_address, out_of_range, not_supported, timed_out, io];
    /// Copies the firmware's SMBIOS table `table` into `buffer`, as
    /// much as it holds, and returns the table's length. The structures
    /// hold the serial numbers of the machine, its board and its chassis,
    /// and its UUID, which /kernel/class/dmi/id leaves out, as Linux shows
    /// them to root alone. Fails with not_supported where the kernel found
    /// no SMBIOS tables. Needs the read right.
    method smbios = 10 (table: SmbiosTable, buffer: out bytes) -> (length: u64)
        raises [no_such_slot, empty_slot, wrong_kind, missing_rights, invalid_argument,
                bad_address, not_supported];
    /// Reads the firmware's UEFI variable `name` of the vendor whose GUID
    /// is `vendor_low` and `vendor_high` (as GLOBAL_VARIABLE_LOW says)
    /// into `data`, and returns its attributes and length. `name` is
    /// UCS-2, little-endian, without a NUL, at most EFI_NAME_MAX bytes.
    /// If `data` is shorter than the variable, nothing is copied and
    /// `length` says how long it is. Fails with not_found where there is
    /// no such variable; with not_supported where the kernel cannot call
    /// the firmware's runtime services: under BIOS, or where the boot
    /// loader passed no UEFI memory map; with io where the firmware fails
    /// or once it has faulted (the kernel log says). Needs the read
    /// right.
    method efi_variable = 11 (vendor_low: u64, vendor_high: u64, name: in bytes,
                              data: out bytes) -> (attributes: EfiAttributes, length: u64)
        raises [no_such_slot, empty_slot, wrong_kind, missing_rights, invalid_argument,
                bad_address, no_memory, not_supported, not_found, io];
    /// Writes the firmware's UEFI variable `name` of the vendor `vendor_low`
    /// and `vendor_high` with `attributes` and `data`, at most
    /// EFI_VARIABLE_MAX bytes, or deletes it if `data` is empty. The
    /// kernel writes only what the boot manager reads from the global
    /// vendor (ADR 0313): `Boot####`, `BootOrder`, `BootNext`, `Timeout`,
    /// `Driver####`, `DriverOrder`, `SysPrep####`, `SysPrepOrder` and
    /// `OsIndications`; any other fails with not_permitted. A write that
    /// would leave the firmware less than 5 KiB of room fails with
    /// no_space, as Linux refuses it: some firmware no longer starts with
    /// its store full. Fails with read_only where the firmware will not
    /// write the variable now, with not_permitted where its Secure Boot
    /// rules forbid the write, and as `efi_variable` does. Needs the
    /// control right.
    method set_efi_variable = 12 (vendor_low: u64, vendor_high: u64, name: in bytes,
                                  attributes: EfiAttributes, data: in bytes) -> ()
        raises [no_such_slot, empty_slot, wrong_kind, missing_rights, invalid_argument,
                bad_address, no_memory, not_supported, not_permitted, not_found, read_only,
                no_space, io];
    /// The variable after `name` of the vendor `vendor_low` and
    /// `vendor_high`, in the firmware's order: copies its name into
    /// `next` and returns its vendor and the name's length, in bytes of
    /// UCS-2 without the NUL. An empty `name` asks for the first. If
    /// `next` is too short, nothing is copied and `length` says how long
    /// the name is. Fails with not_found after the last. Needs the read
    /// right.
    method next_efi_variable = 13 (vendor_low: u64, vendor_high: u64, name: in bytes,
                                   next: out bytes)
        -> (vendor_low: u64, vendor_high: u64, length: u64)
        raises [no_such_slot, empty_slot, wrong_kind, missing_rights, invalid_argument,
                bad_address, not_supported, not_found, io];
    /// How much room the firmware has for variables with `attributes`:
    /// its storage for them, what is free, and the longest one it takes,
    /// in bytes. Fails with not_supported for firmware older than UEFI 2.
    /// Needs the read right.
    method efi_variable_space = 14 (attributes: EfiAttributes)
        -> (total: u64, remaining: u64, largest: u64)
        raises [no_such_slot, empty_slot, wrong_kind, missing_rights, invalid_argument,
                not_supported, io];
}
