//! Disks and their partitions (Phase 10, ADR 0111): the block devices of
//! _/dev_ (radix-files(7)), such as `vda`, `sda` and `sda1`.
//!
//! A block device is read and written raw: at any offset and length,
//! straight to the disk with nothing cached between, as Linux's are when
//! opened with O_DIRECT. A write that covers part of a sector reads the
//! rest of it first. Reads end at the device's end, and writes at or past
//! it fail with no_space. radix-file(2)'s `sync` empties the disk's write
//! cache.
//!
//! radix-file(2)'s `control` takes Linux's requests for block devices,
//! below, with their argument as the address of the value they write or
//! read; `buffer` and `size` are not used. A request with another number
//! fails with not_terminal, and one whose address is not mapped with
//! bad_address.

module block;

/// The device's size in bytes, written as a u64 (Linux's BLKGETSIZE64).
const GET_SIZE_BYTES: u32 = 0x80081272;
/// Its size in 512-byte sectors, written as a u64 (BLKGETSIZE).
const GET_SIZE_SECTORS: u32 = 0x1260;
/// Its logical sector size, written as a u32: 512, or 4096 for a disk of
/// 4 KiB sectors (BLKSSZGET).
const GET_SECTOR_SIZE: u32 = 0x1268;
/// Its physical block size, the smallest unit it writes without reading
/// first, written as a u32 (BLKPBSZGET).
const GET_PHYSICAL_BLOCK_SIZE: u32 = 0x127b;
/// The smallest write it prefers, written as a u32: its physical block
/// size (BLKIOMIN).
const GET_MINIMUM_IO: u32 = 0x1278;
/// The size of write it does best, written as a u32: 0, as it does not
/// say (BLKIOOPT).
const GET_OPTIMAL_IO: u32 = 0x1279;
/// How far its first sector is from the start of a physical block,
/// written as a u32: 0 (BLKALIGNOFF).
const GET_ALIGNMENT_OFFSET: u32 = 0x127a;
/// Whether it refuses writes, written as a u32: 1 if it does (BLKROGET).
const GET_READ_ONLY: u32 = 0x125e;
/// Whether it spins, written as a u16: 1 for a hard disk, or a disk that
/// does not say (BLKROTATIONAL).
const GET_ROTATIONAL: u32 = 0x127e;
/// Whether discarded sectors read as zeros, written as a u32: 0, since a
/// disk need not promise it (BLKDISCARDZEROES).
const GET_DISCARD_ZEROES: u32 = 0x127c;
/// Discards a range, read as two u64s: its first byte and its length,
/// both multiples of its logical sector size and on the device. The device may forget what
/// the range holds (TRIM). Needs the write right; fails with
/// invalid_argument for a range that is not whole sectors on the device,
/// read_only on a device that refuses writes, and not_supported on one
/// that does not discard (BLKDISCARD).
const DISCARD: u32 = 0x1277;
/// Empties the disk's write cache, as radix-file(2)'s `sync` does
/// (BLKFLSBUF). Needs the write right.
const FLUSH: u32 = 0x1261;

/// Reads the disk's partition table again, after rdisk(8) or another
/// partitioner wrote it (Linux's BLKRRPART, ADR 0301): each partition the
/// table has where it was, of the size it was, stays as it is, open and
/// mounted; one it no longer has leaves `/devices` and `/kernel/block`,
/// and what has it open has its requests fail with io from then on, as
/// with a disk unplugged; one new to it comes. Needs the write right;
/// fails with invalid_argument on a partition, in_use if a partition that
/// would go or change is in use (GET_IN_USE), or the disk itself is, and
/// changes nothing then, and corrupt if both copies of a GPT are damaged.
/// On a floppy drive, whose disk has no partition table and which is
/// never polled, it has the drive looked at for a disk put in or taken
/// out instead (ADR 0435): a disk found is in `/devices` when it returns.
/// That needs no write right, as EJECT does not.
const REREAD_PARTITIONS: u32 = 0x125f;

/// What uses the device, written as a u32 of the IN_USE flags, 0 for
/// nothing: Dukovo's own request, so that rdisk(8) and the mkfs tools can
/// refuse a disk or partition in use before they write to it. A disk's
/// own flags are its own: those of its partitions are asked of each.
const GET_IN_USE: u32 = 0x80045205;
/// GET_IN_USE's flag for a device a filesystem is mounted from.
const IN_USE_MOUNTED: u32 = 1;
/// GET_IN_USE's flag for a device whose swap area is on.
const IN_USE_SWAP: u32 = 2;
/// GET_IN_USE's flag for a disk of a Btrfs mounted from another of its
/// disks.
const IN_USE_BTRFS: u32 = 4;
/// GET_IN_USE's flag for a device whose BitLocker volume is unlocked
/// (UNLOCK).
const IN_USE_UNLOCKED: u32 = 8;

/// Ejects the medium of a drive whose medium comes and goes, such as a
/// card reader's slot or a stick that says its medium is removable
/// (eject(1), Linux's CDROMEJECT, ADR 0430). The drive lets go of the
/// lock it holds on the medium while the medium is used, and ejects it:
/// a tray opens, and a card reader or a stick says it has no medium until
/// one is put in again. The drive stays, empty, with a size of 0, and its
/// partitions leave `/devices` and `/kernel/block`. A drive that cannot
/// eject lets the medium go all the same, and stays empty until the
/// medium is taken out and put back. The argument is not used, and the
/// request needs no write right, as on Linux. Fails with
/// invalid_argument on a partition, not_supported on a disk whose medium
/// does not come and go, in_use if the drive, one of its partitions or
/// a volume unlocked on them is in use (GET_IN_USE), and io if the drive
/// does not answer or was unplugged.
const EJECT: u32 = 0x5309;

/// Formats a track of the disk in a floppy drive (floppy(1), ADR 0436):
/// Dukovo's own request, as Linux has FDFMTTRK. It reads FORMAT_SIZE
/// bytes, three u32s: the size of disk to format, in 512-byte sectors
/// (2880 for a 1.44 MB disk, 1440 for a 720 KB one, of those the drive
/// formats, as `/kernel/block/<drive>/formats` lists them); the track's
/// cylinder, from 0; and its head, 0 or 1. What the track held is gone.
/// The first track formatted takes the disk out of the kernel: the drive
/// is empty, a device of no sectors, until REREAD_PARTITIONS looks and
/// finds the disk formatted, so each track's request is made on the
/// drive opened again. Needs the write right; fails with not_supported
/// on a device that is not a floppy drive or a size the drive does not
/// format, invalid_argument for a track not on a disk of that size,
/// in_use if the drive is in use (GET_IN_USE), no_device if no disk is
/// in the drive, read_only if the disk is write-protected, and io if the
/// drive fails, does not answer, or was unplugged.
const FORMAT_TRACK: u32 = 0x400c5206;
/// The bytes FORMAT_TRACK reads.
const FORMAT_SIZE: u32 = 12;

/// Reads the table of contents of the disc in an optical drive, as the
/// drive's READ TOC/PMA/ATIP gives it (audiocd(1), ADR 0447): Dukovo's own
/// request, as Linux leaves it to commands passed through raw beside its
/// CDROMREADTOCENTRY. It reads READ_TOC_SIZE bytes: a u32 format,
/// TOC_TRACKS, TOC_SESSIONS, TOC_FULL or TOC_CD_TEXT; a u32, the first
/// track TOC_TRACKS lists (1 for all of them), 0 for another format; and
/// two u64s, the address and the length of a buffer, of at most
/// READ_TOC_MAX bytes. The buffer gets the drive's answer as MMC-6 lays it
/// out, addresses as block numbers: two bytes, big-endian, that count the
/// bytes after them, then the rest; the answer is cut to the buffer's
/// length. Works on the drive with a music CD in it, which is a device of
/// no sectors, and on one with a disc of data; needs the read right.
/// Fails with not_supported on a device that is not an optical drive,
/// no_device if the drive has no disc in it, invalid_argument for a format
/// or track the drive does not have (a disc without CD-Text has none to
/// give, and some drives refuse TOC_CD_TEXT for that) or a buffer too
/// long, and io if the drive fails, does not answer, or was unplugged.
const READ_TOC: u32 = 0x40185207;
/// The bytes READ_TOC reads.
const READ_TOC_SIZE: u32 = 24;
/// The longest buffer READ_TOC fills: the most READ TOC's answer says it
/// holds.
const READ_TOC_MAX: u32 = 65535;
/// READ_TOC's format of the tracks, each a descriptor of eight bytes
/// whose second holds its control bits (4: data, else audio), third its
/// number and last four its first block, then the lead-out's (number
/// 0xaa), where the disc ends.
const TOC_TRACKS: u32 = 0;
/// READ_TOC's format of the sessions: where the last one starts.
const TOC_SESSIONS: u32 = 1;
/// READ_TOC's format of the full TOC, the lead-in's own entries, eleven
/// bytes each, times as minutes, seconds and sectors.
const TOC_FULL: u32 = 2;
/// READ_TOC's format of CD-Text: packs of 18 bytes, each a type, a track,
/// a sequence number, a block and character position, twelve bytes of
/// text and a CRC.
const TOC_CD_TEXT: u32 = 5;

/// Reads sectors of audio from the music CD in an optical drive, whole,
/// as the drive's READ CD gives them (audiocd(1), ADR 0447), as Linux's
/// CDROMREADAUDIO does: 2,352 bytes each, 588 frames of two 16-bit
/// samples, left then right, little-endian, 1/75 of a second at 44,100
/// frames a second. It reads READ_AUDIO_SIZE bytes: a u32, the first
/// sector's block number, as READ_TOC's TOC_TRACKS gives a track's start;
/// a u32, how many sectors, from 1 to READ_AUDIO_MAX; and a u64, the
/// address of a buffer of 2,352 bytes for each. Needs the read right.
/// Fails with not_supported on a device that is not an optical drive,
/// no_device if the drive has no disc in it, invalid_argument for a count
/// of 0 or more than READ_AUDIO_MAX, or for sectors past the disc's end or
/// of a data track, and io if the drive cannot read them, does not
/// answer, or was unplugged.
const READ_AUDIO: u32 = 0x40105208;
/// The bytes READ_AUDIO reads.
const READ_AUDIO_SIZE: u32 = 16;
/// The most sectors a READ_AUDIO reads: 27, 63,504 bytes, a third of a
/// second.
const READ_AUDIO_MAX: u32 = 27;

/// What the disk says of its health (diskhealth(8), ADR 0157): Dukovo's
/// own request, as Linux leaves it to commands passed through raw. It
/// writes HEALTH_SIZE bytes: a u32 kind, HEALTH_ATA or HEALTH_NVME; a u32
/// of flags; 512 bytes, a SATA disk's SMART data (SMART READ DATA) or an
/// NVMe controller's SMART / Health Information log; then 512 bytes, a
/// SATA disk's SMART thresholds, or zeros. A partition answers for its
/// disk. Fails with not_supported on a device that keeps no such record,
/// such as a virtio disk, and io if the disk does not answer.
const GET_HEALTH: u32 = 0x84085203;
/// The bytes GET_HEALTH writes.
const HEALTH_SIZE: u32 = 1032;
/// GET_HEALTH's kind for a SATA disk's SMART data and thresholds.
const HEALTH_ATA: u32 = 1;
/// GET_HEALTH's kind for an NVMe controller's health log.
const HEALTH_NVME: u32 = 2;
/// GET_HEALTH's flag for a SATA disk whose SMART is off: its 1024 bytes
/// are zeros.
const HEALTH_SMART_OFF: u32 = 1;

/// Unlocks the BitLocker volume on the device (unlock(8), ADR 0240):
/// Dukovo's own request, as Linux leaves it to device-mapper. It reads
/// UNLOCK_SIZE bytes: a u32, the volume's encryption method as its
/// metadata numbers it (0x8000 to 0x8005: AES-CBC with the Elephant
/// diffuser, of 128 or 256 bits; AES-CBC; AES-XTS); a u32 of flags,
/// UNLOCK_READ_ONLY or none; then 64 bytes, its full volume encryption
/// key, the FVEK, of as many bytes as the method takes, unwrapped. The
/// volume unlocked is a device of its own, named after this one with
/// `-unlocked` after it (`sdb1-unlocked`), which reads and writes the
/// volume's filesystem as Windows sees it, decrypted; it goes with its
/// device. A volume Windows is still encrypting or decrypting is unlocked
/// read-only, as is one on a device that refuses writes. Needs the write
/// right but with UNLOCK_READ_ONLY; fails with unknown_filesystem if the
/// device holds no BitLocker volume, not_supported for Windows Vista's
/// and for a method or sector size not read, corrupt if no copy of its
/// metadata reads, invalid_argument if the method is not the volume's or
/// the key does not decrypt it, and in_use if it is unlocked already.
const UNLOCK: u32 = 0x40485204;
/// The bytes UNLOCK reads.
const UNLOCK_SIZE: u32 = 72;
/// UNLOCK's flag that keeps the volume unlocked read-only.
const UNLOCK_READ_ONLY: u32 = 1;

/// Turns on the swap area mkswap(8) made on the device (swapon(8), ADR
/// 0152): Dukovo's own request, as Linux has the swapon(2) system call
/// for it, whose flags it reads as a u32. With SWAP_PREFER set, the low
/// 15 bits are the area's priority; without it, the area gets the next
/// of the default priorities, -2, -3 and on. Needs the write right; fails
/// with in_use if the area is on already, invalid_argument if the device
/// holds no swap area of version 1 for pages of 4 KiB or the flags have
/// other bits set, not_supported for Linux's discard flags, read_only on
/// a device that refuses writes, and busy if eight areas are on. While it
/// is on, the device's raw writes and mounts fail with in_use.
const SWAP_ON: u32 = 0x40045201;
/// Turns off the swap area on the device, once every page swapped out to
/// it is read back into memory (swapoff(8)); the argument is not used.
/// Needs the write right; fails with invalid_argument if it is not on,
/// no_memory if its pages do not fit in memory, and io if one cannot be
/// read, and stays on then.
const SWAP_OFF: u32 = 0x5202;
/// SWAP_ON's flag that says a priority is given (Linux's
/// SWAP_FLAG_PREFER).
const SWAP_PREFER: u32 = 0x8000;
/// The bits of SWAP_ON's flags that hold the priority.
const SWAP_PRIORITY_MASK: u32 = 0x7fff;
/// Linux's flags for discarding an area's pages (SWAP_FLAG_DISCARD,
/// SWAP_FLAG_DISCARD_ONCE and SWAP_FLAG_DISCARD_PAGES).
const SWAP_DISCARD_FLAGS: u32 = 0x70000;
