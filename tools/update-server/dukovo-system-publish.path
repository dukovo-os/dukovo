[Unit]
Description=Publish Dukovo's system releases when a deploy says it is ready (ADR 0467)

[Path]
PathExists=/var/lib/dukovo-system-incoming/ready
Unit=dukovo-system-publish.service

[Install]
WantedBy=multi-user.target
