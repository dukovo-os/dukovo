[Unit]
Description=Publish the Dukovo catalog when a deploy says it is ready (ADR 0382)

[Path]
PathExists=/var/lib/dukovo-catalog-incoming/ready
Unit=dukovo-catalog-publish.service

[Install]
WantedBy=multi-user.target
