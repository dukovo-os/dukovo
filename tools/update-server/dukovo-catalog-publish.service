[Unit]
Description=Publish the Dukovo catalog a deploy brought (ADR 0382)

[Service]
Type=oneshot
User=dukovo-catalog
Group=dukovo-catalog
SupplementaryGroups=dukovo-deploy
UMask=0022
ExecStart=/usr/local/lib/dukovo-catalog/publish.sh
# It reads and writes its own folders and nothing else, and has no use
# for the network: the check reads what it published from the disk.
ProtectSystem=strict
ReadWritePaths=/var/lib/dukovo-catalog /var/lib/dukovo-catalog-incoming /srv/dukovo
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
