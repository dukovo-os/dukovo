@@ -285,6 +285,48 @@ pub unsafe fn save(area: usize) {
         FXSAVE => unsafe { asm!("fxsave64 [{}]", in(reg) area, options(nostack, preserves_flags)) },
         _ => {}
     }
+    if MODE.load(Ordering::Relaxed) >= XSAVE {
