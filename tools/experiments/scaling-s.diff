+// Calls scaling_thread(worker) on a fresh stack of its own.
+static void scaling_on_stack(struct scaling_worker *worker) {
+	size_t size = 256 * 1024;
+	char *stack = mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+	if(stack == MAP_FAILED)
+		fail("mmap");
+	void *top = stack + size;
+	__asm__ volatile("mov %%rsp, %%rbx\n\t"
+	                 "mov %[top], %%rsp\n\t"
+	                 "call *%[fn]\n\t"
+	                 "mov %%rbx, %%rsp"
+	                 : "+D"(worker)
+	                 : [top] "r"(top), [fn] "r"(scaling_thread)
+	                 : "rbx", "rax", "rcx", "rdx", "rsi", "r8", "r9", "r10", "r11", "memory", "cc",
+	                   "xmm0", "xmm1", "xmm2", "xmm3", "xmm4", "xmm5", "xmm6", "xmm7", "xmm8", "xmm9",
+	                   "xmm10", "xmm11", "xmm12", "xmm13", "xmm14", "xmm15");
+}
+
 static void scaling_run(struct scaling *shared, int workers, int threads) {
 	shared->ready = 0;
 	shared->go = 0;
@@ -1065,7 +1083,9 @@ static void scaling_run(struct scaling *shared, int workers, int threads) {
 			if(child[i] < 0)
 				fail("fork");
 			if(child[i] == 0) {
-				scaling_work(shared, i);
+				// Experiment: its own thread, on a fresh stack.
+				worker[i] = (struct scaling_worker){shared, i};
+				scaling_on_stack(&worker[i]);
 				_exit(0);
 			}
 		}
