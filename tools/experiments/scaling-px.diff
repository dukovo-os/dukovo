+// Experiment: which extended state components the CPU holds as in use
+// (XINUSE, from XGETBV with ECX = 1), or ~0 where it cannot say.
+static uint64_t xinuse(void) {
+	uint32_t a, b, c, d;
+	__asm__ volatile("cpuid" : "=a"(a), "=b"(b), "=c"(c), "=d"(d) : "a"(0xd), "c"(1));
+	if(!(a & 4))
+		return ~UINT64_C(0);
+	uint32_t lo, hi;
+	__asm__ volatile("xgetbv" : "=a"(lo), "=d"(hi) : "c"(1));
+	return ((uint64_t)hi << 32) | lo;
+}
+
+static void note_xinuse(struct scaling *shared, const char *where) {
+	printf("posix-bench: xinuse workers=%d %s %#llx\n", shared->workers, where,
+	       (unsigned long long)xinuse());
+	fflush(stdout);
+}
+
+// Experiment: where a forked process's own thread loses time, before
+// and after its first sleep, on the CPU it then works on.
+static void scaling_probe(struct scaling *shared, int index, const char *when) {
+	int dir = shared->dirs[index];
+	uint64_t t0 = now_ns();
+	for(int i = 0; i < 20000; i++)
+		sched_yield();
+	uint64_t t1 = now_ns();
+	for(int i = 0; i < 20000; i++) {
+		int fd = openat(dir, "file", O_RDONLY | O_CLOEXEC);
+		if(fd < 0)
+			fail("openat");
+		close(fd);
+	}
+	uint64_t t2 = now_ns();
+	__asm__ volatile("xorps %%xmm0, %%xmm0\n\t"
+	                 "mov $1000000, %%ecx\n"
+	                 "1:\n\t"
+	                 "addps %%xmm1, %%xmm0\n\t"
+	                 "dec %%ecx\n\t"
+	                 "jnz 1b"
+	                 ::: "xmm0", "xmm1", "ecx", "cc");
+	uint64_t t3 = now_ns();
+	__asm__ volatile("mov $1, %%eax\n\t"
+	                 "mov $1000000, %%ecx\n"
+	                 "1:\n\t"
+	                 "imul %%eax, %%eax\n\t"
+	                 "dec %%ecx\n\t"
+	                 "jnz 1b"
+	                 ::: "eax", "ecx", "cc");
+	uint64_t t4 = now_ns();
+	printf("posix-bench: probe workers=%d %s yield=%.1f openclose=%.1f addps=%.3f imul=%.3f\n",
+	       shared->workers, when, (double)(t1 - t0) / 20000.0, (double)(t2 - t1) / 20000.0,
+	       (double)(t3 - t2) / 1000000.0, (double)(t4 - t3) / 1000000.0);
+	fflush(stdout);
+}
