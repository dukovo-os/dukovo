diff --git a/userspace/posix/bench.c b/userspace/posix/bench.c
--- a/userspace/posix/bench.c
+++ b/userspace/posix/bench.c
@@ -1065,6 +1065,15 @@
 			if(child[i] < 0)
 				fail("fork");
 			if(child[i] == 0) {
+				// Experiment: the child maps, touches and unmaps a region
+				// the size of a thread's stack first, and makes no thread.
+				size_t size = 8u << 20;
+				char *region = mmap(NULL, size, PROT_READ | PROT_WRITE,
+				                    MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+				if(region == MAP_FAILED)
+					fail("mmap");
+				((volatile char *)region)[size - 1] = 1;
+				munmap(region, size);
 				scaling_work(shared, i);
 				_exit(0);
 			}
