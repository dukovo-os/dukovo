+// Experiment: the extended state components the CPU holds as in use
+// (XGETBV with ECX = 1; this CPU has it), read without a system call.
+static uint64_t xz_read(void) {
+	uint32_t lo, hi;
+	__asm__ volatile("xgetbv" : "=a"(lo), "=d"(hi) : "c"(1));
+	return ((uint64_t)hi << 32) | lo;
+}
