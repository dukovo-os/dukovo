#
# The command lab test's service that requires lab-slow, so a start of it
# waits for lab-slow and fails once Spark gives up on lab-slow (ADR 0471).

service_version = 2
description = "Requires lab-slow"
program = "/system/commands/nukesh"
arguments = ["-c", "while :; do sleep 1; done"]
enabled = false
requires = ["lab-slow"]
