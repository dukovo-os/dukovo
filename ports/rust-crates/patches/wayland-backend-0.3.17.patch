+    // No descriptor says which clients wrote: each is read, and one that
+    // wrote nothing says so.
+    #[cfg(target_os = "radix")]
+    pub fn dispatch_all_clients(&self, data: &mut D) -> std::io::Result<usize> {
+        let ids: Vec<ClientId> = self.state.lock().unwrap().clients.all_clients_id().collect();
+        let mut dispatched = 0;
+        for id in ids {
+            if let Ok(count) = self.dispatch_events_for(data, id.id) {
+                dispatched += count;
+            }
+        }
+        let cleanup = self.state.lock().unwrap().cleanup();
+        cleanup(&self.handle(), data);
+
+        Ok(dispatched)
+    }
+
