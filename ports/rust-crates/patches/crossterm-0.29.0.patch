+++ b/crossterm-0.29.0/src/event/source/unix/mio.rs
@@ -89,6 +89,33 @@ impl EventSource for UnixInternalEventSource {
                 return Ok(None);
             }
 
+            // mio's poll(2) back end drops an interest once it has reported
+            // it, until the source registers again, which reads straight
+            // from the fds do not do. Each source reported is asked for
+            // again before any is handled: the handling below returns with
+            // the first event, and a source reported with it would be
+            // polled no more (a resize that came with keys, or with the
+            // answer to a cursor query, left the terminal unread for good).
+            #[cfg(target_os = "radix")]
+            {
+                let reported = |token| self.events.iter().any(|event| event.token() == token);
+                let (tty, signals) = (reported(TTY_TOKEN), reported(SIGNAL_TOKEN));
+                if tty {
+                    self.poll.registry().reregister(
+                        &mut SourceFd(&self.tty_fd.raw_fd()),
+                        TTY_TOKEN,
+                        Interest::READABLE,
+                    )?;
+                }
+                if signals {
+                    self.poll.registry().reregister(
+                        &mut self.signals,
+                        SIGNAL_TOKEN,
+                        Interest::READABLE,
+                    )?;
+                }
+            }
+
