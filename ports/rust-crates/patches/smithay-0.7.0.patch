+    #[cfg(target_os = "radix")]
+    pub fn with_data(name: &CStr, data: &[u8]) -> Result<Self, std::io::Error> {
+        use rand::{distr::Alphanumeric, Rng};
+        use std::os::unix::{ffi::OsStrExt, fs::OpenOptionsExt};
+
+        let mut rng = rand::rng();
+        let mut n = 0;
+        let (path, mut file) = loop {
+            let mut file_name = name.to_bytes().to_owned();
+            file_name.push(b'-');
+            file_name.extend((0..7).map(|_| rng.sample(Alphanumeric)));
+            let path = std::path::Path::new("/devices/shm").join(std::ffi::OsStr::from_bytes(&file_name));
+            let file = File::options()
+                .read(true)
+                .write(true)
+                .create_new(true)
+                .mode(0o600)
+                .open(&path);
+            match file {
+                Err(err) if err.kind() == std::io::ErrorKind::AlreadyExists && n <= 3 => n += 1,
+                file => break (path, file?),
+            }
+        };
+
+        let file_rdonly = File::open(&path);
+        let _ = std::fs::remove_file(&path);
+        let file_rdonly = file_rdonly?;
+
+        file.write_all(data)?;
+        file.flush()?;
+
+        Ok(Self {
+            file: file_rdonly,
+            size: data.len(),
+        })
+    }
