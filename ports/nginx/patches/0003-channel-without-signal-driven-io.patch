A worker's channel without signal-driven I/O

nginx asks for SIGIO on the master's end of each worker's channel
(FIOASYNC, then F_SETOWN), and gives up spawning the worker when it
cannot have it. Radix has no signal-driven I/O, and answers FIOASYNC with
ENOTTY. The master never reads its end of the channel, which carries
commands to the workers, and SIGIO would only wake it from sigsuspend(),
as the signals it acts on do, so it goes without.

diff --git a/src/os/unix/ngx_process.c b/src/os/unix/ngx_process.c
index 1568023..05a86bf 100644
--- a/src/os/unix/ngx_process.c
+++ b/src/os/unix/ngx_process.c
@@ -142,15 +142,24 @@ ngx_spawn_process(ngx_cycle_t *cycle, ngx_spawn_proc_pt proc, void *data,
             return NGX_INVALID_PID;
         }
 
+        /*
+         * A system without signal-driven I/O, as Radix (Dukovo's patch),
+         * answers ENOTTY: the master never reads its end of the channel,
+         * and SIGIO only wakes it, so it goes without.
+         */
+
         on = 1;
         if (ioctl(ngx_processes[s].channel[0], FIOASYNC, &on) == -1) {
-            ngx_log_error(NGX_LOG_ALERT, cycle->log, ngx_errno,
-                          "ioctl(FIOASYNC) failed while spawning \"%s\"", name);
-            ngx_close_channel(ngx_processes[s].channel, cycle->log);
-            return NGX_INVALID_PID;
-        }
+            if (ngx_errno != ENOTTY) {
+                ngx_log_error(NGX_LOG_ALERT, cycle->log, ngx_errno,
+                              "ioctl(FIOASYNC) failed while spawning \"%s\"",
+                              name);
+                ngx_close_channel(ngx_processes[s].channel, cycle->log);
+                return NGX_INVALID_PID;
+            }
 
-        if (fcntl(ngx_processes[s].channel[0], F_SETOWN, ngx_pid) == -1) {
+        } else if (fcntl(ngx_processes[s].channel[0], F_SETOWN, ngx_pid) == -1)
+        {
             ngx_log_error(NGX_LOG_ALERT, cycle->log, ngx_errno,
                           "fcntl(F_SETOWN) failed while spawning \"%s\"", name);
             ngx_close_channel(ngx_processes[s].channel, cycle->log);
