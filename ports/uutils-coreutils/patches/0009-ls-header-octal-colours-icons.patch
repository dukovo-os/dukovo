+/// Writes the time as [`display_date`] does, padded to `--header`'s
+/// title and coloured by how long ago it was (ADR 0440).
+fn display_date_field(
+    md: &Metadata,
+    config: &Config,
+    padding: &PaddingCollection,
+    state: &mut ListState,
+) -> UResult<()> {
+    let mut date = Vec::new();
+    display_date(md, config, &state.recent_time_range, &mut date)?;
+    let date_width = ansi_width(&String::from_utf8_lossy(&date));
+    date.extend(iter::repeat_n(
+        b' ',
+        padding.time.saturating_sub(date_width),
+    ));
+    match (&config.field_colors, metadata_get_time(md, config.time)) {
+        (Some(colors), Some(time)) => {
+            let code = colors.time_code(time, *state.recent_time_range.end());
+            colors.paint_padded(code, &date, &mut state.display_buf);
+        }
+        _ => state.display_buf.extend(&date),
+    }
+    Ok(())
+}
+
+/// Pads the permissions to `--header`'s title, when it is wider (ADR
+/// 0440); without a header there is nothing to pad.
+fn pad_to_title(padding: &PaddingCollection, out: &mut Vec<u8>) {
+    let gap = padding
+        .permissions_title
+        .saturating_sub(padding.permissions);
+    out.extend(iter::repeat_n(b' ', gap));
+}
+
+/// The widest time of `items`, as the long listing writes them, for
+/// `--header` to line its title up with (ADR 0440).
+fn time_column_width(items: &[PathData], config: &Config, state: &ListState) -> usize {
+    let mut date = Vec::new();
+    let mut widest = 0;
+    for md in items.iter().filter_map(PathData::metadata) {
+        date.clear();
+        if display_date(md, config, &state.recent_time_range, &mut date).is_ok() {
+            widest = widest.max(ansi_width(&String::from_utf8_lossy(&date)));
+        }
+    }
+    widest
+}
+
 fn os_str_starts_with(haystack: &OsStr, needle: &[u8]) -> bool {
     os_str_as_bytes_lossy(haystack).starts_with(needle)
 }
diff --git a/src/uu/ls/src/fields.rs b/src/uu/ls/src/fields.rs
new file mode 100644
--- /dev/null
+++ b/src/uu/ls/src/fields.rs
@@ -0,0 +1,523 @@
+// This file is part of the uutils coreutils package.
+//
+// For the full copyright and license information, please view the LICENSE
+// file that was distributed with this source code.
+
+// spell-checker:ignore (Dukovo) sgr
+
+//! Dukovo's additions to the long listing (ADR 0440): column titles
+//! (`--header`), each mode in octal (`--octal`), and colours that say
+//! something about a file: its permission letters, how big it is and how
+//! long ago it changed.
+//!
+//! None of this changes what GNU's `ls` prints unless it is asked for:
+//! `--header` and `--octal` are flags of their own, and the colours come,
+//! unless `--field-colors` says otherwise, only with the names' colours
+//! (`--color`) and only on a terminal, so that even `--color=always` into
+//! a pipe or file is as GNU's.
+//!
+//! The colours are SGR codes in `LS_FIELD_COLORS`, in `LS_COLORS`' form
+//! (`read=33:write=31:...`); Nukesh makes it from colors.toml's `[ls]`
+//! (ADR 0260). If the columns do not line up under `--header`, start in
+//! [`widen_for_header`], which must widen exactly the columns
+//! `display_item_long` pads.
+
+use std::fmt::Write as _;
+use std::time::{Duration, SystemTime};
+
+use ansi_width::ansi_width;
+use uucore::fsext::MetadataTimeField;
+use uucore::translate;
+
+use crate::Config;
+use crate::display::PaddingCollection;
+
+/// Sizes below this are small (`small`): under a kibibyte.
+const SMALL_BELOW: u64 = 1 << 10;
+/// Sizes from this up are big (`big`): a mebibyte or more.
+const BIG_FROM: u64 = 1 << 20;
+/// Sizes from this up are huge (`huge`): a gibibyte or more.
+const HUGE_FROM: u64 = 1 << 30;
+
+/// Changed less than this long ago: `today`.
+const TODAY: Duration = Duration::from_secs(24 * 60 * 60);
+/// Changed more than this long ago: `old`.
+const OLD: Duration = Duration::from_secs(7 * 24 * 60 * 60);
+
+/// The width of `--octal`'s digits, as `0755`.
+pub(crate) const OCTAL_WIDTH: usize = 4;
+
+/// The colours of the long listing's fields, as SGR codes without their
+/// `ESC [` and `m`. An empty code leaves its field plain.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct FieldColors {
+    /// The permission letters `r`, `w` and `x`.
+    read: String,
+    write: String,
+    run: String,
+    /// `s`, `S`, `t` and `T`: set-user-ID, set-group-ID and sticky.
+    special: String,
+    /// A `-` where a permission is not given.
+    none: String,
+    /// The type letter at the front: `d`, `l`, and `b`, `c`, `p` or `s`.
+    directory: String,
+    link: String,
+    device: String,
+    /// `--octal`'s digits.
+    octal: String,
+    /// Sizes under a kibibyte, of a mebibyte or more, of a gibibyte or more.
+    small: String,
+    big: String,
+    huge: String,
+    /// Times in the last day, and more than a week ago.
+    today: String,
+    old: String,
+    /// `--header`'s titles.
+    header: String,
+    /// What ends each coloured field: a reset, then `LS_COLORS`' normal
+    /// colour (`no=`) when it sets one, so the rest of the line keeps it.
+    end: String,
+}
+
+impl Default for FieldColors {
+    /// The colours with no `LS_FIELD_COLORS`: Nukesh's defaults, so that
+    /// `ls` in another shell looks the same.
+    fn default() -> Self {
+        let code = |s: &str| s.to_string();
+        Self {
+            read: code("33"),
+            write: code("31"),
+            run: code("32"),
+            special: code("35"),
+            none: code("90"),
+            directory: code("1;34"),
+            link: code("36"),
+            device: code("1;33"),
+            octal: code("90"),
+            small: code("90"),
+            big: code("33"),
+            huge: code("1;31"),
+            today: code("1"),
+            old: code("90"),
+            header: code("4"),
+            end: "\x1b[0m".to_string(),
+        }
+    }
+}
+
+impl FieldColors {
+    /// The colours `LS_FIELD_COLORS` gives over the defaults, with
+    /// `LS_COLORS`' normal colour after each; `None` when
+    /// `LS_FIELD_COLORS` is set empty, which turns them off.
+    pub(crate) fn from_env() -> Option<Self> {
+        let fields = std::env::var("LS_FIELD_COLORS").ok();
+        let ls_colors = std::env::var("LS_COLORS").ok();
+        Self::from_vars(fields.as_deref(), ls_colors.as_deref())
+    }
+
+    fn from_vars(fields: Option<&str>, ls_colors: Option<&str>) -> Option<Self> {
+        if fields == Some("") {
+            return None;
+        }
+        let mut colors = Self::default();
+        for entry in fields.unwrap_or_default().split(':') {
+            let Some((key, code)) = entry.split_once('=') else {
+                continue;
+            };
+            // A code is digits and semicolons, as in LS_COLORS; anything
+            // else would put stray escapes on the screen, so the key keeps
+            // its default.
+            if !code.bytes().all(|b| b.is_ascii_digit() || b == b';') {
+                continue;
+            }
+            // Keys this ls does not know are skipped rather than refused,
+            // so that a newer colors.toml does not turn the colours off.
+            if let Some(slot) = colors.slot(key) {
+                *slot = code.to_string();
+            }
+        }
+        if let Some(normal) = normal_color(ls_colors) {
+            colors.end = format!("\x1b[0m\x1b[{normal}m");
+        }
+        Some(colors)
+    }
+
+    fn slot(&mut self, key: &str) -> Option<&mut String> {
+        Some(match key {
+            "read" => &mut self.read,
+            "write" => &mut self.write,
+            "run" => &mut self.run,
+            "special" => &mut self.special,
+            "none" => &mut self.none,
+            "directory" => &mut self.directory,
+            "link" => &mut self.link,
+            "device" => &mut self.device,
+            "octal" => &mut self.octal,
+            "small" => &mut self.small,
+            "big" => &mut self.big,
+            "huge" => &mut self.huge,
+            "today" => &mut self.today,
+            "old" => &mut self.old,
+            "header" => &mut self.header,
+            _ => return None,
+        })
+    }
+
+    /// Writes `text` to `out` in the colour `code`, or plain if it has none.
+    fn paint(&self, code: &str, text: &str, out: &mut Vec<u8>) {
+        if code.is_empty() {
+            out.extend(text.as_bytes());
+            return;
+        }
+        out.extend(b"\x1b[");
+        out.extend(code.as_bytes());
+        out.push(b'm');
+        out.extend(text.as_bytes());
+        out.extend(self.end.as_bytes());
+    }
+
+    /// Writes a mode as `display_permissions` gives it, `drwxr-xr-x`,
+    /// each letter in its colour; letters side by side in one colour,
+    /// as `------`, share one span. A `+` or `.` after the mode is not
+    /// ours to colour, and stays plain.
+    pub(crate) fn paint_permissions(&self, permissions: &str, out: &mut Vec<u8>) {
+        let mut run = String::new();
+        let mut run_code = "";
+        for (i, letter) in permissions.chars().enumerate() {
+            let code = if i == 0 {
+                self.type_code(letter)
+            } else {
+                self.letter_code(letter)
+            };
+            if code != run_code && !run.is_empty() {
+                self.paint(run_code, &run, out);
+                run.clear();
+            }
+            run_code = code;
+            run.push(letter);
+        }
+        self.paint(run_code, &run, out);
+    }
+
+    /// The colour of the type letter at the front of a mode.
+    fn type_code(&self, letter: char) -> &str {
+        match letter {
+            'd' => &self.directory,
+            'l' => &self.link,
+            'b' | 'c' | 'p' | 's' => &self.device,
+            _ => &self.none,
+        }
+    }
+
+    /// The colour of a permission letter.
+    fn letter_code(&self, letter: char) -> &str {
+        match letter {
+            'r' => &self.read,
+            'w' => &self.write,
+            'x' => &self.run,
+            's' | 'S' | 't' | 'T' => &self.special,
+            '-' => &self.none,
+            _ => "",
+        }
+    }
+
+    /// The colour of a size of `bytes`, or `""` for one in between.
+    pub(crate) fn size_code(&self, bytes: u64) -> &str {
+        match bytes {
+            b if b < SMALL_BELOW => &self.small,
+            b if b >= HUGE_FROM => &self.huge,
+            b if b >= BIG_FROM => &self.big,
+            _ => "",
+        }
+    }
+
+    /// The colour of a time `then`, as seen at `now`: a time to come, or
+    /// one between a day and a week ago, is plain.
+    pub(crate) fn time_code(&self, then: SystemTime, now: SystemTime) -> &str {
+        match now.duration_since(then) {
+            Ok(age) if age < TODAY => &self.today,
+            Ok(age) if age > OLD => &self.old,
+            _ => "",
+        }
+    }
+
+    /// Writes `text`, already padded, in the colour `code`. Padding goes
+    /// outside the colour, so that a background or underline covers only
+    /// the text.
+    pub(crate) fn paint_padded(&self, code: &str, text: &[u8], out: &mut Vec<u8>) {
+        let start = text.iter().position(|&b| b != b' ').unwrap_or(text.len());
+        let end = text
+            .iter()
+            .rposition(|&b| b != b' ')
+            .map_or(start, |i| i + 1);
+        if start == end {
+            out.extend(text);
+            return;
+        }
+        out.extend(&text[..start]);
+        self.paint(code, &String::from_utf8_lossy(&text[start..end]), out);
+        out.extend(&text[end..]);
+    }
+}
+
+/// `no=` of `LS_COLORS`, if it gives a colour.
+fn normal_color(ls_colors: Option<&str>) -> Option<&str> {
+    ls_colors?
+        .split(':')
+        .filter_map(|entry| entry.strip_prefix("no="))
+        .next_back()
+        .filter(|code| !code.is_empty() && code.bytes().all(|b| b.is_ascii_digit() || b == b';'))
+}
+
+/// A mode's permission bits and set-user-ID, set-group-ID and sticky bits
+/// as four octal digits, as chmod takes them: `0755`.
+pub(crate) fn octal(mode: u32) -> String {
+    format!("{:0width$o}", mode & 0o7777, width = OCTAL_WIDTH)
+}
+
+/// Writes `--octal`'s digits for `mode`, coloured when `colors` are on,
+/// padded to `column`, and the space after them.
+pub(crate) fn write_octal(
+    colors: Option<&FieldColors>,
+    mode: u32,
+    column: usize,
+    out: &mut Vec<u8>,
+) {
+    let digits = octal(mode);
+    match colors {
+        Some(colors) => colors.paint(&colors.octal, &digits, out),
+        None => out.extend(digits.as_bytes()),
+    }
+    out.extend(std::iter::repeat_n(
+        b' ',
+        column.saturating_sub(digits.len()) + 1,
+    ));
+}
+
+/// The titles `--header` writes over the long listing's columns.
+pub(crate) struct Titles {
+    pub(crate) inode: String,
+    pub(crate) blocks: String,
+    pub(crate) octal: String,
+    pub(crate) permissions: String,
+    pub(crate) links: String,
+    pub(crate) owner: String,
+    pub(crate) group: String,
+    pub(crate) context: String,
+    pub(crate) author: String,
+    pub(crate) size: String,
+    pub(crate) time: String,
+    pub(crate) name: String,
+}
+
+impl Titles {
+    pub(crate) fn new(time: MetadataTimeField) -> Self {
+        Self {
+            inode: translate!("ls-header-inode"),
+            blocks: translate!("ls-header-blocks"),
+            octal: translate!("ls-header-octal"),
+            permissions: translate!("ls-header-permissions"),
+            links: translate!("ls-header-links"),
+            owner: translate!("ls-header-owner"),
+            group: translate!("ls-header-group"),
+            context: translate!("ls-header-context"),
+            author: translate!("ls-header-author"),
+            size: translate!("ls-header-size"),
+            time: match time {
+                MetadataTimeField::Modification => translate!("ls-header-modified"),
+                MetadataTimeField::Access => translate!("ls-header-accessed"),
+                MetadataTimeField::Change => translate!("ls-header-changed"),
+                MetadataTimeField::Birth => translate!("ls-header-created"),
+            },
+            name: translate!("ls-header-name"),
+        }
+    }
+}
+
+/// How wide a title is on the screen.
+fn width(title: &str) -> usize {
+    ansi_width(title)
+}
+
+/// Widens the long listing's columns to hold `--header`'s titles. The
+/// permissions, octal and time columns, which have no padding of their
+/// own without a header, get one here.
+pub(crate) fn widen_for_header(padding: &mut PaddingCollection, config: &Config, titles: &Titles) {
+    padding.inode = padding.inode.max(width(&titles.inode));
+    padding.block_size = padding.block_size.max(width(&titles.blocks));
+    padding.octal = OCTAL_WIDTH.max(width(&titles.octal));
+    padding.permissions_title = padding.permissions.max(width(&titles.permissions));
+    padding.link_count = padding.link_count.max(width(&titles.links));
+    if config.long.owner {
+        padding.uname = padding.uname.max(width(&titles.owner));
+    }
+    // Author shares the owner's width (display_item_long pads both alike).
+    if config.long.author {
+        padding.uname = padding.uname.max(width(&titles.author));
+    }
+    padding.group = padding.group.max(width(&titles.group));
+    padding.context = padding.context.max(width(&titles.context));
+    padding.size = padding.size.max(width(&titles.size));
+    padding.time = padding.time.max(width(&titles.time));
+}
+
+/// Writes `--header`'s line: each column's title, aligned as its values
+/// are (numbers to the right, words to the left), and underlined, or in
+/// the `header` colour, when the fields are coloured.
+pub(crate) fn write_header(
+    titles: &Titles,
+    padding: &PaddingCollection,
+    config: &Config,
+    out: &mut Vec<u8>,
+) {
+    let mut line = Line {
+        out,
+        colors: config.field_colors.as_ref(),
+        first: true,
+    };
+    if config.inode {
+        line.right(&titles.inode, padding.inode);
+    }
+    if config.alloc_size {
+        line.right(&titles.blocks, padding.block_size);
+    }
+    if config.octal {
+        line.left(&titles.octal, padding.octal);
+    }
+    line.left(&titles.permissions, padding.permissions_title);
+    line.right(&titles.links, padding.link_count);
+    if config.long.owner {
+        line.left(&titles.owner, padding.uname);
+    }
+    if config.long.group {
+        line.left(&titles.group, padding.group);
+    }
+    if config.context {
+        line.left(&titles.context, padding.context);
+    }
+    if config.long.author {
+        line.left(&titles.author, padding.uname);
+    }
+    line.right(&titles.size, padding.size);
+    line.left(&titles.time, padding.time);
+    line.left(&titles.name, 0);
+    // The name is the last column: no spaces after it.
+    while line.out.last() == Some(&b' ') {
+        line.out.pop();
+    }
+    line.out.push(config.line_ending as u8);
+}
+
+/// The header line as it is written, a column at a time.
+struct Line<'a> {
+    out: &'a mut Vec<u8>,
+    colors: Option<&'a FieldColors>,
+    first: bool,
+}
+
+impl Line<'_> {
+    fn right(&mut self, title: &str, column: usize) {
+        let mut text = String::new();
+        let _ = write!(text, "{title:>column$}");
+        self.push(&text);
+    }
+
+    fn left(&mut self, title: &str, column: usize) {
+        let mut text = String::new();
+        let _ = write!(text, "{title:<column$}");
+        self.push(&text);
+    }
+
+    fn push(&mut self, text: &str) {
+        if !self.first {
+            self.out.push(b' ');
+        }
+        self.first = false;
+        match self.colors {
+            Some(colors) => colors.paint_padded(&colors.header, text.as_bytes(), self.out),
+            None => self.out.extend(text.as_bytes()),
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn octal_has_four_digits_with_the_special_bits() {
+        assert_eq!(octal(0o40755), "0755");
+        assert_eq!(octal(0o104755), "4755");
+        assert_eq!(octal(0o41777), "1777");
+        assert_eq!(octal(0o100600), "0600");
+    }
+
+    #[test]
+    fn letters_take_the_colour_of_what_they_say() {
+        let colors = FieldColors::default();
+        let mut out = Vec::new();
+        colors.paint_permissions("drwx--S---", &mut out);
+        let out = String::from_utf8(out).unwrap();
+        assert!(
+            out.starts_with("\x1b[1;34md\x1b[0m\x1b[33mr\x1b[0m\x1b[31mw\x1b[0m\x1b[32mx\x1b[0m")
+        );
+        assert!(out.contains("\x1b[90m--\x1b[0m\x1b[35mS\x1b[0m"));
+        // The last three dashes are one span.
+        assert!(out.ends_with("\x1b[90m---\x1b[0m"));
+    }
+
+    #[test]
+    fn the_variable_changes_keys_and_skips_what_it_cannot_use() {
+        let colors =
+            FieldColors::from_vars(Some("read=1;33:write=:bogus=7:run=31m"), None).unwrap();
+        assert_eq!(colors.read, "1;33");
+        assert_eq!(colors.write, "");
+        // `31m` is not a code: run keeps its default.
+        assert_eq!(colors.run, "32");
+        let mut out = Vec::new();
+        colors.paint_permissions("-w-", &mut out);
+        assert_eq!(
+            String::from_utf8(out).unwrap(),
+            "\x1b[90m-\x1b[0mw\x1b[90m-\x1b[0m"
+        );
+    }
+
+    #[test]
+    fn an_empty_variable_turns_the_colours_off() {
+        assert_eq!(FieldColors::from_vars(Some(""), None), None);
+    }
+
+    #[test]
+    fn the_normal_colour_follows_each_field() {
+        let colors = FieldColors::from_vars(None, Some("di=01;34:no=0;37")).unwrap();
+        let mut out = Vec::new();
+        colors.paint("4", "Size", &mut out);
+        assert_eq!(
+            String::from_utf8(out).unwrap(),
+            "\x1b[4mSize\x1b[0m\x1b[0;37m"
+        );
+    }
+
+    #[test]
+    fn sizes_and_times_by_how_big_and_how_old() {
+        let colors = FieldColors::default();
+        assert_eq!(colors.size_code(312), "90");
+        assert_eq!(colors.size_code(4096), "");
+        assert_eq!(colors.size_code(1_258_291), "33");
+        assert_eq!(colors.size_code(2_576_980_378), "1;31");
+        let now = SystemTime::UNIX_EPOCH + Duration::from_secs(1_800_000_000);
+        let ago = |hours: u64| now - Duration::from_secs(hours * 3600);
+        assert_eq!(colors.time_code(ago(1), now), "1");
+        assert_eq!(colors.time_code(ago(48), now), "");
+        assert_eq!(colors.time_code(ago(24 * 30), now), "90");
+        assert_eq!(colors.time_code(now + Duration::from_secs(60), now), "");
+    }
+
+    #[test]
+    fn padding_stays_outside_the_colour() {
+        let colors = FieldColors::default();
+        let mut out = Vec::new();
+        colors.paint_padded("4", b"  Size", &mut out);
+        assert_eq!(String::from_utf8(out).unwrap(), "  \x1b[4mSize\x1b[0m");
+    }
+}
