+// This file is part of the uutils coreutils package.
+//
+// For the full copyright and license information, please view the LICENSE
+// file that was distributed with this source code.
+
+// spell-checker:ignore (Dukovo) devicons nerdfonts
+
+//! `--icons` (ADR 0440): a small picture before each name, for what kind
+//! of file it is. The pictures are characters of a Nerd Font, which the
+//! terminal must use, or each shows as a box; so they are off unless asked
+//! for, and `--icons` alone shows them only on a terminal.
+//!
+//! The code points are Nerd Fonts' (nerdfonts.com/cheat-sheet): Font
+//! Awesome's from U+F000 and the Devicons from U+E700, all one cell wide.
+//! A file is matched by its type, then its whole name, then its ending;
+//! anything else is a plain file, or a program if it can be run. To give a
+//! kind of file its own icon, add its ending to [`BY_ENDING`].
+
+use std::fs::FileType;
+use std::os::unix::fs::FileTypeExt;
+
+use crate::PathData;
+
+/// Nerd Fonts' code points, by what they show.
+mod glyph {
+    pub const FOLDER: char = '\u{f07b}';
+    pub const FILE: char = '\u{f15b}';
+    pub const TEXT: char = '\u{f15c}';
+    pub const PROGRAM: char = '\u{f120}';
+    pub const LINK: char = '\u{f0c1}';
+    pub const DEVICE: char = '\u{f0a0}';
+    pub const PIPE: char = '\u{f1e6}';
+    pub const IMAGE: char = '\u{f1c5}';
+    pub const AUDIO: char = '\u{f1c7}';
+    pub const VIDEO: char = '\u{f1c8}';
+    pub const ARCHIVE: char = '\u{f1c6}';
+    pub const PDF: char = '\u{f1c1}';
+    pub const DOCUMENT: char = '\u{f1c2}';
+    pub const SPREADSHEET: char = '\u{f1c3}';
+    pub const SLIDES: char = '\u{f1c4}';
+    pub const CODE: char = '\u{f1c9}';
+    pub const KEY: char = '\u{f084}';
+    pub const LOCK: char = '\u{f023}';
+    pub const DATABASE: char = '\u{f1c0}';
+    pub const FONT: char = '\u{f031}';
+    pub const SETTINGS: char = '\u{f013}';
+    pub const BOOK: char = '\u{f02d}';
+    pub const RUST: char = '\u{e7a8}';
+    pub const PYTHON: char = '\u{e73c}';
+    pub const JAVASCRIPT: char = '\u{e781}';
+    pub const HTML: char = '\u{e736}';
+    pub const CSS: char = '\u{e749}';
+    pub const GIT: char = '\u{e702}';
+    pub const JAVA: char = '\u{e738}';
+    pub const RUBY: char = '\u{e739}';
+    pub const GO: char = '\u{e724}';
+    pub const C: char = '\u{e61e}';
+    pub const CPP: char = '\u{e61d}';
+    pub const MARKDOWN: char = '\u{e73e}';
+    pub const SHELL: char = '\u{e795}';
+    pub const DOCKER: char = '\u{e7b0}';
+    pub const MAKE: char = '\u{e779}';
+}
+
+/// Whole names with an icon of their own, matched before endings.
+const BY_NAME: &[(&str, char)] = &[
+    (".git", glyph::GIT),
+    (".gitignore", glyph::GIT),
+    (".gitattributes", glyph::GIT),
+    (".gitmodules", glyph::GIT),
+    ("Cargo.lock", glyph::LOCK),
+    ("Dockerfile", glyph::DOCKER),
+    ("Containerfile", glyph::DOCKER),
+    ("Makefile", glyph::MAKE),
+    ("GNUmakefile", glyph::MAKE),
+    ("README", glyph::BOOK),
+    ("LICENSE", glyph::BOOK),
+    ("COPYING", glyph::BOOK),
+];
+
+/// Endings, without their dot and in lower case.
+const BY_ENDING: &[(&str, char)] = &[
+    ("rs", glyph::RUST),
+    ("py", glyph::PYTHON),
+    ("js", glyph::JAVASCRIPT),
+    ("mjs", glyph::JAVASCRIPT),
+    ("ts", glyph::JAVASCRIPT),
+    ("html", glyph::HTML),
+    ("htm", glyph::HTML),
+    ("css", glyph::CSS),
+    ("java", glyph::JAVA),
+    ("rb", glyph::RUBY),
+    ("go", glyph::GO),
+    ("c", glyph::C),
+    ("h", glyph::C),
+    ("cc", glyph::CPP),
+    ("cpp", glyph::CPP),
+    ("cxx", glyph::CPP),
+    ("hpp", glyph::CPP),
+    ("md", glyph::MARKDOWN),
+    ("sh", glyph::SHELL),
+    ("bash", glyph::SHELL),
+    ("zsh", glyph::SHELL),
+    ("nk", glyph::SHELL),
+    ("toml", glyph::SETTINGS),
+    ("ini", glyph::SETTINGS),
+    ("conf", glyph::SETTINGS),
+    ("cfg", glyph::SETTINGS),
+    ("yaml", glyph::SETTINGS),
+    ("yml", glyph::SETTINGS),
+    ("json", glyph::CODE),
+    ("xml", glyph::CODE),
+    ("lua", glyph::CODE),
+    ("txt", glyph::TEXT),
+    ("log", glyph::TEXT),
+    ("pdf", glyph::PDF),
+    ("odt", glyph::DOCUMENT),
+    ("doc", glyph::DOCUMENT),
+    ("docx", glyph::DOCUMENT),
+    ("ods", glyph::SPREADSHEET),
+    ("xls", glyph::SPREADSHEET),
+    ("xlsx", glyph::SPREADSHEET),
+    ("csv", glyph::SPREADSHEET),
+    ("odp", glyph::SLIDES),
+    ("ppt", glyph::SLIDES),
+    ("pptx", glyph::SLIDES),
+    ("png", glyph::IMAGE),
+    ("jpg", glyph::IMAGE),
+    ("jpeg", glyph::IMAGE),
+    ("gif", glyph::IMAGE),
+    ("webp", glyph::IMAGE),
+    ("svg", glyph::IMAGE),
+    ("bmp", glyph::IMAGE),
+    ("ico", glyph::IMAGE),
+    ("mp3", glyph::AUDIO),
+    ("flac", glyph::AUDIO),
+    ("ogg", glyph::AUDIO),
+    ("opus", glyph::AUDIO),
+    ("wav", glyph::AUDIO),
+    ("m4a", glyph::AUDIO),
+    ("mp4", glyph::VIDEO),
+    ("mkv", glyph::VIDEO),
+    ("webm", glyph::VIDEO),
+    ("mov", glyph::VIDEO),
+    ("avi", glyph::VIDEO),
+    ("tar", glyph::ARCHIVE),
+    ("gz", glyph::ARCHIVE),
+    ("tgz", glyph::ARCHIVE),
+    ("xz", glyph::ARCHIVE),
+    ("zst", glyph::ARCHIVE),
+    ("bz2", glyph::ARCHIVE),
+    ("zip", glyph::ARCHIVE),
+    ("7z", glyph::ARCHIVE),
+    ("rar", glyph::ARCHIVE),
+    ("deb", glyph::ARCHIVE),
+    ("rpm", glyph::ARCHIVE),
+    ("iso", glyph::DEVICE),
+    ("img", glyph::DEVICE),
+    ("key", glyph::KEY),
+    ("pem", glyph::KEY),
+    ("pub", glyph::KEY),
+    ("crt", glyph::KEY),
+    ("gpg", glyph::KEY),
+    ("asc", glyph::KEY),
+    ("lock", glyph::LOCK),
+    ("db", glyph::DATABASE),
+    ("sqlite", glyph::DATABASE),
+    ("ttf", glyph::FONT),
+    ("otf", glyph::FONT),
+    ("woff", glyph::FONT),
+    ("woff2", glyph::FONT),
+];
+
+/// SSH's key files, whose names have no ending to go by.
+const KEY_NAMES: &[&str] = &[
+    "id_rsa",
+    "id_ecdsa",
+    "id_ed25519",
+    "authorized_keys",
+    "known_hosts",
+];
+
+/// The icon for a file, with the space that follows it.
+pub(crate) fn icon(path: &PathData) -> String {
+    let mut icon = String::with_capacity(5);
+    icon.push(glyph_for(path));
+    icon.push(' ');
+    icon
+}
+
+fn glyph_for(path: &PathData) -> char {
+    // A link is shown as a link, whatever it leads to; a dangling one too.
+    match path.file_type() {
+        Some(kind) => {
+            if let Some(glyph) = glyph_for_type(*kind) {
+                return glyph;
+            }
+        }
+        None if path.is_dangling_link() => return glyph::LINK,
+        None => {}
+    }
+    let name = path.file_name().to_string_lossy();
+    if let Some(&(_, glyph)) = BY_NAME.iter().find(|(n, _)| *n == name) {
+        return glyph;
+    }
+    if KEY_NAMES
+        .iter()
+        .any(|key| name.trim_end_matches(".pub") == *key)
+    {
+        return glyph::KEY;
+    }
+    if let Some(glyph) = glyph_for_ending(&name) {
+        return glyph;
+    }
+    if path.is_executable_file() {
+        glyph::PROGRAM
+    } else {
+        glyph::FILE
+    }
+}
+
+fn glyph_for_type(kind: FileType) -> Option<char> {
+    if kind.is_dir() {
+        Some(glyph::FOLDER)
+    } else if kind.is_symlink() {
+        Some(glyph::LINK)
+    } else if kind.is_block_device() || kind.is_char_device() {
+        Some(glyph::DEVICE)
+    } else if kind.is_fifo() || kind.is_socket() {
+        Some(glyph::PIPE)
+    } else {
+        None
+    }
+}
+
+fn glyph_for_ending(name: &str) -> Option<char> {
+    let (stem, ending) = name.rsplit_once('.')?;
+    // `.profile` is a hidden name, not an ending.
+    if stem.is_empty() {
+        return None;
+    }
+    let ending = ending.to_ascii_lowercase();
+    BY_ENDING
+        .iter()
+        .find(|(e, _)| *e == ending)
+        .map(|&(_, glyph)| glyph)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn endings_ignore_case_and_hidden_names_have_none() {
+        assert_eq!(glyph_for_ending("main.RS"), Some(glyph::RUST));
+        assert_eq!(glyph_for_ending("backup.tar.zst"), Some(glyph::ARCHIVE));
+        assert_eq!(glyph_for_ending(".profile"), None);
+        assert_eq!(glyph_for_ending("notes"), None);
+    }
+
+    #[test]
+    fn every_glyph_is_one_cell_wide() {
+        for &(_, glyph) in BY_NAME.iter().chain(BY_ENDING) {
+            assert_eq!(ansi_width::ansi_width(&glyph.to_string()), 1, "{glyph:?}");
+        }
+    }
+}
