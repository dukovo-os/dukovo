+/// Linux's `BTRFS_IOC_GET_SUBVOL_INFO`, `_IOR(0x94, 60, SubvolumeInfo)`.
+const GET_SUBVOL_INFO: u64 = 0x81f8943c;
+
+/// Linux's `struct btrfs_ioctl_timespec`.
+#[repr(C)]
+#[derive(Clone, Copy, Default)]
+struct BtrfsTime {
+    sec: u64,
+    nsec: u32,
+}
+
+/// Linux's `struct btrfs_ioctl_get_subvol_info_args`.
+#[repr(C)]
+struct SubvolumeInfo {
+    treeid: u64,
+    name: [u8; 256],
+    parent_id: u64,
+    dirid: u64,
+    generation: u64,
+    flags: u64,
+    uuid: [u8; 16],
+    parent_uuid: [u8; 16],
+    received_uuid: [u8; 16],
+    ctransid: u64,
+    otransid: u64,
+    stransid: u64,
+    rtransid: u64,
+    times: [BtrfsTime; 4],
+    reserved: [u64; 8],
+}
+
+const _: () = assert!(size_of::<SubvolumeInfo>() as u64 == (GET_SUBVOL_INFO >> 16) & 0x3fff);
+
+/// Whether the subvolume whose top is `folder` was made as a snapshot
+/// of another: whether it has a parent UUID.
+fn is_snapshot(folder: &Path) -> bool {
+    let Ok(dir) = File::open(folder) else {
+        return false;
+    };
+    let mut info = SubvolumeInfo {
+        treeid: 0,
+        name: [0; 256],
+        parent_id: 0,
+        dirid: 0,
+        generation: 0,
+        flags: 0,
+        uuid: [0; 16],
+        parent_uuid: [0; 16],
+        received_uuid: [0; 16],
+        ctransid: 0,
+        otransid: 0,
+        stransid: 0,
+        rtransid: 0,
+        times: [BtrfsTime::default(); 4],
+        reserved: [0; 8],
+    };
+    // SAFETY: `info` is the structure the request writes, and the
+    // descriptor is open for the call.
+    let status = unsafe { libc::ioctl(dir.as_raw_fd(), GET_SUBVOL_INFO as _, &raw mut info) };
+    status == 0 && info.parent_uuid != [0; 16]
+}
+
