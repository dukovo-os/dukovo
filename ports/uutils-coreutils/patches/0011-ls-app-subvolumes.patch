--- /dev/null
+++ b/src/uu/ls/src/subvolumes.rs
@@ -0,0 +1,129 @@
+// This file is part of the uutils coreutils package.
+//
+// For the full copyright and license information, please view the LICENSE
+// file that was distributed with this source code.
+
+// spell-checker:ignore (Dukovo) subvolume subvolumes EROFS
+
+//! Btrfs subvolumes in the long listing (ADR 0442): a folder that is the
+//! top of a subvolume has `[subvolume]` after its name, or `[subvolume,
+//! read-only]` when nothing in it can be changed, as `@system.a` on
+//! `/system`. On a terminal by default, as `--subvolumes=auto`; into a
+//! pipe only with `--subvolumes=always`, so that scripts get GNU's text.
+//!
+//! A subvolume's top folder is inode 256 of its own tree (Linux's
+//! `BTRFS_FIRST_FREE_OBJECTID`): Linux shows it as `st_ino` 256 with a
+//! device of its own, and Radix as 256 with the subvolume's number from
+//! bit 40 (its Btrfs driver's `id_of`), so the low 40 bits are 256 on
+//! both. Other filesystems use inode 256 too, so the folder must also be
+//! on a Btrfs mount, by the mount table. Read-only is what access(2)
+//! says to writing: `EROFS`, whether the subvolume or its mount is.
+//!
+//! Which subvolumes are snapshots needs the subvolume's parent UUID,
+//! which Radix does not tell programs yet; Phase 15's `snap` brings it.
+
+use std::ffi::CString;
+use std::os::unix::ffi::OsStrExt;
+use std::os::unix::fs::MetadataExt;
+use std::path::{Path, PathBuf};
+
+use uucore::fsext::read_fs_list;
+use uucore::libc;
+
+use crate::PathData;
+
+/// The inode number of a subvolume's top folder.
+const TOP_INODE: u64 = 256;
+
+/// The bits of `st_ino` that are the inode's own number on Radix.
+const INODE_BITS: u64 = (1 << 40) - 1;
+
+/// A subvolume's top folder, as the listing marks it.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) struct Subvolume {
+    pub(crate) read_only: bool,
+}
+
+/// The mount table, read the first time a folder might be a subvolume.
+#[derive(Default)]
+pub(crate) struct Subvolumes {
+    /// Each mount's folder, and whether it is Btrfs; `None` until read.
+    mounts: Option<Vec<(PathBuf, bool)>>,
+}
+
+impl Subvolumes {
+    /// `item`, if it is a subvolume's top folder.
+    pub(crate) fn of(&mut self, item: &PathData) -> Option<Subvolume> {
+        let metadata = item.metadata()?;
+        if !metadata.is_dir() || metadata.ino() & INODE_BITS != TOP_INODE {
+            return None;
+        }
+        let real = item.path().canonicalize().ok()?;
+        let mounts = self.mounts.get_or_insert_with(|| {
+            read_fs_list()
+                .unwrap_or_default()
+                .into_iter()
+                .map(|mount| (PathBuf::from(mount.mount_dir), mount.fs_type == "btrfs"))
+                .collect()
+        });
+        if !on_btrfs(mounts, &real) {
+            return None;
+        }
+        Some(Subvolume {
+            read_only: refuses_writes(&real),
+        })
+    }
+}
+
+/// Whether the mount `path` is in, the one at its longest folder, is
+/// Btrfs. The last of two mounts at one folder is the one seen.
+fn on_btrfs(mounts: &[(PathBuf, bool)], path: &Path) -> bool {
+    let mut found = None;
+    for (folder, btrfs) in mounts {
+        let longer = found.is_none_or(|(at, _): (&PathBuf, bool)| {
+            folder.components().count() >= at.components().count()
+        });
+        if path.starts_with(folder) && longer {
+            found = Some((folder, *btrfs));
+        }
+    }
+    found.is_some_and(|(_, btrfs)| btrfs)
+}
+
+/// Whether writing in `folder` is refused because nothing there may
+/// change (`EROFS`), rather than for want of permission.
+fn refuses_writes(folder: &Path) -> bool {
+    let Ok(path) = CString::new(folder.as_os_str().as_bytes()) else {
+        return false;
+    };
+    // SAFETY: `path` is a valid C string for the call.
+    let status = unsafe { libc::access(path.as_ptr(), libc::W_OK) };
+    status != 0 && std::io::Error::last_os_error().raw_os_error() == Some(libc::EROFS)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_deepest_mount_holds_a_path() {
+        let mounts = vec![
+            (PathBuf::from("/"), false),
+            (PathBuf::from("/users"), true),
+            (PathBuf::from("/users/shared"), false),
+            (PathBuf::from("/system"), true),
+        ];
+        assert!(on_btrfs(&mounts, Path::new("/users")));
+        assert!(on_btrfs(&mounts, Path::new("/users/alice")));
+        assert!(!on_btrfs(&mounts, Path::new("/users/shared/x")));
+        assert!(!on_btrfs(&mounts, Path::new("/usersx")));
+        assert!(!on_btrfs(&mounts, Path::new("/tmp")));
+        assert!(on_btrfs(&mounts, Path::new("/system")));
+    }
+
+    #[test]
+    fn a_later_mount_at_one_folder_hides_the_earlier() {
+        let mounts = vec![(PathBuf::from("/m"), true), (PathBuf::from("/m"), false)];
+        assert!(!on_btrfs(&mounts, Path::new("/m/x")));
+    }
+}
