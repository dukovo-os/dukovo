@@ -0,0 +1,534 @@
+// This file is part of the uutils coreutils package.
+//
+// For the full copyright and license information, please view the LICENSE
+// file that was distributed with this source code.
+
+// spell-checker:ignore (Dukovo) dkv
+
+//! `--app` (ADR 0442): a column of the long listing with the app a file
+//! belongs to on Dukovo, and how:
+//!
+//! - **sealed**: inside an installed bundle, `/applications/ID` or `ID` in
+//!   a person's `applications` folder, root's and read-only, as bundled
+//!   seals it (ADR 0223);
+//! - **not sealed**: inside such a folder but writable or not root's, as
+//!   one unpacked by hand or changed since; the bundle runtime will not
+//!   start it (ADR 0225);
+//! - **data**: in an app's data folder, `app-data/ID` in a person's home,
+//!   which only that app changes;
+//! - **temp**: in an app's own `/tmp/.app-ID`.
+//!
+//! The name is the one the bundle's manifest gives (ADR 0221), read only
+//! from a sealed bundle, since anyone may write a manifest in a folder of
+//! their own; otherwise, or with no bundle installed, it is the ID. A
+//! name is cut to [`NAME_WIDTH`] columns, and a control character in it
+//! is shown as `?`, so that a manifest cannot write to the terminal.
+//!
+//! The places are told by path: `applications` and `app-data` count in
+//! `/` and in a person's home, which is a folder whose owner's home it
+//! is. If a file shows no app where one is expected, start in
+//! [`Apps::of`].
+
+use std::fs::{self, File, Metadata};
+use std::io::Read;
+use std::os::unix::fs::MetadataExt;
+use std::path::{Component, Path, PathBuf};
+
+use ansi_width::ansi_width;
+use rustc_hash::FxHashMap;
+use uucore::entries::{Locate, Passwd};
+use uucore::translate;
+
+use crate::PathData;
+
+/// The widest a name is shown, in columns.
+const NAME_WIDTH: usize = 24;
+
+/// The most of a manifest read for its name.
+const MANIFEST_MOST: u64 = 64 * 1024;
+
+/// How a file belongs to its app.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub(crate) enum Kind {
+    Sealed,
+    Unsealed,
+    Data,
+    Temp,
+}
+
+/// The app a file belongs to: its name, as shown, and how, with the word
+/// that says so.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub(crate) struct App {
+    pub(crate) name: String,
+    pub(crate) kind: Kind,
+    pub(crate) word: String,
+}
+
+impl App {
+    fn new(name: String, kind: Kind) -> Self {
+        let word = match kind {
+            Kind::Sealed => translate!("ls-app-sealed"),
+            Kind::Unsealed => translate!("ls-app-unsealed"),
+            Kind::Data => translate!("ls-app-data"),
+            Kind::Temp => translate!("ls-app-temp"),
+        };
+        Self { name, kind, word }
+    }
+
+    /// How wide `--app`'s column must be for it: the name, a space and
+    /// the word.
+    pub(crate) fn width(&self) -> usize {
+        ansi_width(&self.name) + 1 + ansi_width(&self.word)
+    }
+}
+
+/// What `--app` has looked up, so that each folder is asked about once.
+#[derive(Default)]
+pub(crate) struct Apps {
+    /// Each folder's real path.
+    real: FxHashMap<PathBuf, Option<PathBuf>>,
+    /// Whether each folder is a person's home.
+    homes: FxHashMap<PathBuf, bool>,
+    /// Each bundle folder's name, when it is sealed.
+    names: FxHashMap<PathBuf, Option<String>>,
+}
+
+impl Apps {
+    /// The app `item` belongs to, if any.
+    pub(crate) fn of(&mut self, item: &PathData) -> Option<App> {
+        let path = self.real_path(item)?;
+        let parts: Vec<&str> = path
+            .components()
+            .skip(1)
+            .map(|part| match part {
+                Component::Normal(name) => name.to_str().unwrap_or(""),
+                _ => "",
+            })
+            .collect();
+
+        // An app's own /tmp, and the keyring folder beside it.
+        if let ["tmp", folder, ..] = parts.as_slice() {
+            if let Some(id) = temp_id(folder) {
+                let home = self.home_of_owner(&Path::new("/tmp").join(folder));
+                return Some(App::new(self.name_of(id, home.as_deref()), Kind::Temp));
+            }
+        }
+
+        for (i, part) in parts.iter().enumerate() {
+            let Some(id) = parts.get(i + 1).copied().filter(|id| is_id(id)) else {
+                continue;
+            };
+            let above = place_above(&parts[..i]);
+            match *part {
+                "applications" if above == Path::new("/") || self.is_home(&above) => {
+                    let bundle = above.join("applications").join(id);
+                    let metadata = item.metadata()?;
+                    // Only a sealed folder's own manifest names it.
+                    let kind = if is_sealed(metadata) && is_sealed_bundle(&bundle) {
+                        Kind::Sealed
+                    } else {
+                        Kind::Unsealed
+                    };
+                    let name = match kind {
+                        Kind::Sealed => self.name_in(&bundle).unwrap_or_else(|| id.to_string()),
+                        _ => id.to_string(),
+                    };
+                    return Some(App::new(name, kind));
+                }
+                "app-data" if self.is_home(&above) => {
+                    return Some(App::new(self.name_of(id, Some(&above)), Kind::Data));
+                }
+                _ => {}
+            }
+        }
+        None
+    }
+
+    /// Where `item` really is: its folder's real path and its own name,
+    /// so that a link is looked up as itself.
+    fn real_path(&mut self, item: &PathData) -> Option<PathBuf> {
+        let path = item.path();
+        let (folder, name) = match (path.parent(), path.file_name()) {
+            (Some(parent), Some(name)) if !item.is_dot_dir => (parent, Some(name)),
+            _ => (path, None),
+        };
+        let folder = if folder.as_os_str().is_empty() {
+            Path::new(".")
+        } else {
+            folder
+        };
+        let real = self
+            .real
+            .entry(folder.to_path_buf())
+            .or_insert_with(|| folder.canonicalize().ok())
+            .clone()?;
+        Some(match name {
+            Some(name) => real.join(name),
+            None => real,
+        })
+    }
+
+    /// Whether `folder` is a person's home: their account says so, and
+    /// it is theirs.
+    fn is_home(&mut self, folder: &Path) -> bool {
+        if let Some(&known) = self.homes.get(folder) {
+            return known;
+        }
+        let home = fs::symlink_metadata(folder)
+            .ok()
+            .and_then(|metadata| Passwd::locate(metadata.uid()).ok())
+            .and_then(|account| account.user_dir)
+            .is_some_and(|dir| Path::new(&dir) == folder);
+        self.homes.insert(folder.to_path_buf(), home);
+        home
+    }
+
+    /// The home of whoever owns `path`, as an app's /tmp is its person's.
+    fn home_of_owner(&mut self, path: &Path) -> Option<PathBuf> {
+        let metadata = fs::symlink_metadata(path).ok()?;
+        let home = PathBuf::from(Passwd::locate(metadata.uid()).ok()?.user_dir?);
+        self.is_home(&home).then_some(home)
+    }
+
+    /// App `id`'s name: from its sealed bundle in `home`, then from the
+    /// one for everyone, as `bundle run` finds it; or the ID.
+    fn name_of(&mut self, id: &str, home: Option<&Path>) -> String {
+        let places = home
+            .map(|home| home.join("applications"))
+            .into_iter()
+            .chain([PathBuf::from("/applications")]);
+        for place in places {
+            let bundle = place.join(id);
+            if is_sealed_bundle(&bundle) {
+                if let Some(name) = self.name_in(&bundle) {
+                    return name;
+                }
+            }
+        }
+        id.to_string()
+    }
+
+    /// The name in `bundle`'s manifest, if it is sealed and gives one, made
+    /// safe to show.
+    fn name_in(&mut self, bundle: &Path) -> Option<String> {
+        self.names
+            .entry(bundle.to_path_buf())
+            .or_insert_with(|| {
+                let manifest = bundle.join("manifest.json");
+                let metadata = fs::symlink_metadata(&manifest).ok()?;
+                if !metadata.is_file() || !is_sealed(&metadata) {
+                    return None;
+                }
+                let mut json = Vec::new();
+                File::open(&manifest)
+                    .ok()?
+                    .take(MANIFEST_MOST)
+                    .read_to_end(&mut json)
+                    .ok()?;
+                manifest_name(&json).map(|name| shown(&name))
+            })
+            .clone()
+    }
+}
+
+/// The app whose temporary folder in /tmp `folder` is: `.app-ID`, or
+/// `.app-ID.keyring-N`, the keyring `bundle run` serves it for one run.
+fn temp_id(folder: &str) -> Option<&str> {
+    let id = folder.strip_prefix(".app-")?;
+    let id = match id.rsplit_once(".keyring-") {
+        Some((id, run)) if !run.is_empty() && run.bytes().all(|b| b.is_ascii_digit()) => id,
+        _ => id,
+    };
+    is_id(id).then_some(id)
+}
+
+/// The folder `parts` names, from `/`.
+fn place_above(parts: &[&str]) -> PathBuf {
+    let mut place = PathBuf::from("/");
+    place.extend(parts);
+    place
+}
+
+/// Whether `bundle` is a folder bundled sealed: root's and read-only,
+/// not through a link.
+fn is_sealed_bundle(bundle: &Path) -> bool {
+    fs::symlink_metadata(bundle).is_ok_and(|metadata| metadata.is_dir() && is_sealed(&metadata))
+}
+
+/// Whether a file is as bundled leaves it: root's, and no one may write
+/// it. A link's own mode means nothing, so a link of root's is sealed
+/// when its folder is.
+fn is_sealed(metadata: &Metadata) -> bool {
+    metadata.uid() == 0 && (metadata.is_symlink() || metadata.mode() & 0o222 == 0)
+}
+
+/// Whether `id` is a bundle's ID: two or more parts of lowercase letters,
+/// digits and `-`, joined by dots (manifest.json(5)).
+fn is_id(id: &str) -> bool {
+    let mut parts = 0;
+    for part in id.split('.') {
+        if part.is_empty()
+            || !part
+                .bytes()
+                .all(|b| b.is_ascii_lowercase() || b.is_ascii_digit() || b == b'-')
+        {
+            return false;
+        }
+        parts += 1;
+    }
+    parts >= 2
+}
+
+/// `name` as it may go on a terminal: each control character as `?`, and
+/// each that turns the text's direction or hides in it too, so that the
+/// name reads as it is; cut to [`NAME_WIDTH`] columns with an ellipsis.
+fn shown(name: &str) -> String {
+    let safe: String = name
+        .chars()
+        .map(|c| {
+            if c.is_control() || is_invisible(c) {
+                '?'
+            } else {
+                c
+            }
+        })
+        .collect();
+    if ansi_width(&safe) <= NAME_WIDTH {
+        return safe;
+    }
+    let mut out = String::new();
+    let mut width = 0;
+    for c in safe.chars() {
+        let w = ansi_width(c.encode_utf8(&mut [0; 4]));
+        if width + w > NAME_WIDTH - 1 {
+            break;
+        }
+        width += w;
+        out.push(c);
+    }
+    out.push('…');
+    out
+}
+
+/// Whether `c` changes how the text around it shows without showing
+/// itself: the marks and overrides of direction, and the zero-width
+/// characters.
+fn is_invisible(c: char) -> bool {
+    matches!(
+        c,
+        '\u{061C}'
+            | '\u{200B}'..='\u{200F}'
+            | '\u{202A}'..='\u{202E}'
+            | '\u{2060}'..='\u{2069}'
+            | '\u{FEFF}'
+    )
+}
+
+/// The top-level `"name"` of a manifest, read only as far as it.
+fn manifest_name(json: &[u8]) -> Option<String> {
+    let mut json = Json { bytes: json, at: 0 };
+    json.expect(b'{')?;
+    loop {
+        if json.peek()? == b'}' {
+            return None;
+        }
+        let key = json.string()?;
+        json.expect(b':')?;
+        if key == "name" {
+            return json.string();
+        }
+        json.skip_value()?;
+        match json.next()? {
+            b',' => {}
+            _ => return None,
+        }
+    }
+}
+
+/// A reader of JSON (RFC 8259), enough to find one field: what it skips
+/// it checks only as far as finding where it ends.
+struct Json<'a> {
+    bytes: &'a [u8],
+    at: usize,
+}
+
+impl Json<'_> {
+    /// The next byte that is not white space, without taking it.
+    fn peek(&mut self) -> Option<u8> {
+        while let Some(b' ' | b'\t' | b'\n' | b'\r') = self.bytes.get(self.at) {
+            self.at += 1;
+        }
+        self.bytes.get(self.at).copied()
+    }
+
+    /// Takes the next byte that is not white space.
+    fn next(&mut self) -> Option<u8> {
+        let byte = self.peek()?;
+        self.at += 1;
+        Some(byte)
+    }
+
+    fn expect(&mut self, byte: u8) -> Option<()> {
+        (self.next()? == byte).then_some(())
+    }
+
+    /// A string, its escapes undone.
+    fn string(&mut self) -> Option<String> {
+        self.expect(b'"')?;
+        let mut text = Vec::new();
+        loop {
+            let byte = *self.bytes.get(self.at)?;
+            self.at += 1;
+            match byte {
+                b'"' => return String::from_utf8(text).ok(),
+                b'\\' => {
+                    let escaped = *self.bytes.get(self.at)?;
+                    self.at += 1;
+                    let c = match escaped {
+                        b'"' => '"',
+                        b'\\' => '\\',
+                        b'/' => '/',
+                        b'b' => '\u{8}',
+                        b'f' => '\u{c}',
+                        b'n' => '\n',
+                        b'r' => '\r',
+                        b't' => '\t',
+                        b'u' => self.unicode()?,
+                        _ => return None,
+                    };
+                    text.extend(c.encode_utf8(&mut [0; 4]).as_bytes());
+                }
+                0..0x20 => return None,
+                _ => text.push(byte),
+            }
+        }
+    }
+
+    /// The character of a `\u` escape, whose `\u` is taken, joining a
+    /// surrogate pair.
+    fn unicode(&mut self) -> Option<char> {
+        let first = self.hex4()?;
+        if (0xD800..0xDC00).contains(&first) {
+            if self.bytes.get(self.at..self.at + 2)? != b"\\u" {
+                return None;
+            }
+            self.at += 2;
+            let second = self.hex4()?;
+            if !(0xDC00..0xE000).contains(&second) {
+                return None;
+            }
+            return char::from_u32(0x10000 + ((first - 0xD800) << 10) + (second - 0xDC00));
+        }
+        char::from_u32(first)
+    }
+
+    fn hex4(&mut self) -> Option<u32> {
+        let digits = std::str::from_utf8(self.bytes.get(self.at..self.at + 4)?).ok()?;
+        self.at += 4;
+        u32::from_str_radix(digits, 16).ok()
+    }
+
+    /// Skips a value: a string, an object or array with all it holds, or
+    /// a number, `true`, `false` or `null`.
+    fn skip_value(&mut self) -> Option<()> {
+        match self.peek()? {
+            b'"' => self.string().map(drop),
+            b'{' | b'[' => {
+                let mut depth = 0usize;
+                loop {
+                    match self.peek()? {
+                        b'"' => {
+                            self.string()?;
+                        }
+                        b'{' | b'[' => {
+                            depth += 1;
+                            self.at += 1;
+                        }
+                        b'}' | b']' => {
+                            depth -= 1;
+                            self.at += 1;
+                            if depth == 0 {
+                                return Some(());
+                            }
+                        }
+                        _ => self.at += 1,
+                    }
+                }
+            }
+            _ => {
+                let start = self.at;
+                while let Some(&byte) = self.bytes.get(self.at) {
+                    if matches!(byte, b',' | b'}' | b']' | b' ' | b'\t' | b'\n' | b'\r') {
+                        break;
+                    }
+                    self.at += 1;
+                }
+                (self.at > start).then_some(())
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn the_name_is_found_past_what_comes_before_it() {
+        let json = br#"{
+            "manifest_version": 1,
+            "id": "org.example.notes",
+            "programs": {"notes": {"path": {"x86_64": "bin/notes"}, "name": "not this"}},
+            "list": [1, 2.5e3, true, null, "]", {"a": "}"}],
+            "name": "Notes \u00e9 \ud83d\ude00 \"quoted\"",
+            "summary": "x"
+        }"#;
+        assert_eq!(
+            manifest_name(json).as_deref(),
+            Some("Notes é 😀 \"quoted\"")
+        );
+    }
+
+    #[test]
+    fn a_manifest_without_a_name_has_none() {
+        assert_eq!(
+            manifest_name(br#"{"id": "a.b", "programs": {"name": "x"}}"#),
+            None
+        );
+        assert_eq!(manifest_name(br#"{"name": 7}"#), None);
+        assert_eq!(manifest_name(b"[\"name\"]"), None);
+        assert_eq!(manifest_name(br#"{"name": "cut"#), None);
+    }
+
+    #[test]
+    fn names_are_made_safe_and_short() {
+        assert_eq!(shown("Notes"), "Notes");
+        assert_eq!(shown("evil\x1b[2Jname"), "evil?[2Jname");
+        assert_eq!(shown("abc\u{202E}fdp.exe"), "abc?fdp.exe");
+        assert_eq!(shown("in\u{200B}visible"), "in?visible");
+        assert_eq!(shown(&"x".repeat(24)), "x".repeat(24));
+        assert_eq!(shown(&"x".repeat(30)), format!("{}…", "x".repeat(23)));
+    }
+
+    #[test]
+    fn ids_are_reverse_domain_names() {
+        assert!(is_id("org.example.notes"));
+        assert!(is_id("com.my-app.x2"));
+        assert!(!is_id("notes"));
+        assert!(!is_id(".installing-x7"));
+        assert!(!is_id("Org.Example"));
+        assert!(!is_id("org..x"));
+    }
+
+    #[test]
+    fn an_apps_temp_folders_are_its_own() {
+        assert_eq!(temp_id(".app-org.example.notes"), Some("org.example.notes"));
+        assert_eq!(
+            temp_id(".app-org.example.notes.keyring-412"),
+            Some("org.example.notes")
+        );
+        assert_eq!(temp_id(".app-notes"), None);
+        assert_eq!(temp_id("org.example.notes"), None);
+    }
+}
