--- /dev/null
+++ b/src/uu/ls/src/grants.rs
@@ -0,0 +1,45 @@
+// SPDX-FileCopyrightText: 2026 The Dukovo contributors
+// SPDX-License-Identifier: Apache-2.0 OR MIT
+
+//! `ls --grants` (Dukovo, ADR 0443): who can reach each file named.
+//!
+//! reach(1) gives the answer, from the owners, modes and access lists on
+//! the way to the file and from what the caller allowed their apps; ls
+//! only hands it the names. What reach writes, to standard output and to
+//! standard error, is ls's own, and so is its exit status. ls lists
+//! nothing itself with `--grants`, so its other options do not count.
+
+use std::ffi::OsString;
+use std::process::Command;
+
+use uucore::error::{UResult, USimpleError, set_exit_code, strip_errno};
+use uucore::translate;
+
+/// Where Dukovo keeps reach(1).
+const REACH: &str = "/system/commands/reach";
+
+/// Runs reach(1) on `files`, or on the current folder when none is
+/// named, and gives back its exit status as ls's.
+///
+/// # Errors
+///
+/// When reach cannot be started, as on a system that has none.
+pub fn show(files: Vec<&OsString>) -> UResult<()> {
+    let mut reach = Command::new(REACH);
+    // `--` first, so that a file whose name starts with `-` is a name.
+    reach.arg("--");
+    if files.is_empty() {
+        reach.arg(".");
+    } else {
+        reach.args(files);
+    }
+    let status = reach.status().map_err(|e| {
+        USimpleError::new(
+            2,
+            translate!("ls-error-grants", "command" => REACH, "error" => strip_errno(&e)),
+        )
+    })?;
+    // Killed by a signal, it has no status: that is serious trouble.
+    set_exit_code(status.code().unwrap_or(2));
+    Ok(())
+}
