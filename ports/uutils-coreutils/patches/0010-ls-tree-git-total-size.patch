--- /dev/null
+++ b/src/uu/ls/src/git.rs
@@ -0,0 +1,329 @@
+// This file is part of the uutils coreutils package.
+//
+// For the full copyright and license information, please view the LICENSE
+// file that was distributed with this source code.
+
+// spell-checker:ignore (Dukovo) toplevel fsmonitor porcelain
+
+//! `--git` (ADR 0441): a column in the long listing with each file's state
+//! in its git repository, two letters as in `git status --short`: what is
+//! staged, then what is changed and not staged. `N` new, `M` modified, `D`
+//! deleted, `R` renamed, `T` type changed, `U` in conflict, `I` ignored,
+//! `-` unchanged. A folder shows the most telling state of what it holds.
+//!
+//! `ls` asks git itself, once a repository: `git rev-parse --show-toplevel`
+//! finds a folder's repository, and `git status --porcelain=v1 -z` lists
+//! what is not clean in all of it. A file outside any repository, or with
+//! no git installed, has no letters, and a listing with none leaves the
+//! column out. If the letters look wrong, compare `git status --short
+//! --ignored` run in the same folder.
+//!
+//! A repository's own settings must not run anything: `core.fsmonitor`
+//! names a program git would start, so it is turned off, and git's checks
+//! of who owns a repository stay as they are.
+
+use std::collections::BTreeMap;
+use std::ffi::OsStr;
+use std::os::unix::ffi::OsStrExt;
+use std::path::{Path, PathBuf};
+use std::process::{Command, Stdio};
+
+use rustc_hash::FxHashMap;
+
+use crate::PathData;
+
+/// A file's two letters: staged, then not staged.
+pub(crate) type Mark = [u8; 2];
+
+/// A file with nothing to report.
+const CLEAN: Mark = *b"--";
+
+/// A file outside any repository, in a listing with the column.
+pub(crate) const OUTSIDE: Mark = *b"  ";
+
+/// The column's width: two letters.
+pub(crate) const WIDTH: usize = 2;
+
+/// The repositories `ls` has asked git about, so that each is asked once.
+#[derive(Default)]
+pub(crate) struct Repositories {
+    /// Each repository's root, and what git said is not clean in it.
+    found: Vec<Repository>,
+    /// Each folder asked about, as given: its real path and its
+    /// repository in `found`, or `None` outside one.
+    folders: FxHashMap<PathBuf, Option<(PathBuf, usize)>>,
+}
+
+struct Repository {
+    root: PathBuf,
+    /// Paths from the root, as git writes them: a folder git reports as
+    /// a whole (untracked or ignored) ends in `/`.
+    changes: BTreeMap<Vec<u8>, Mark>,
+}
+
+impl Repositories {
+    /// `item`'s letters, or `None` outside a repository.
+    pub(crate) fn mark(&mut self, item: &PathData) -> Option<Mark> {
+        let is_folder = item.file_type().is_some_and(std::fs::FileType::is_dir);
+        // `.` and `..` are folders of their own.
+        if item.is_dot_dir {
+            return self.mark_in(item.path(), None, true);
+        }
+        // Anything else is a name in its folder, so that a link is
+        // looked up as itself, not as what it points to. A repository's
+        // own folder, named from outside it (`ls -ld --git repo`, or a
+        // tree's top), is looked up from inside instead.
+        let folder = match item.path().parent() {
+            Some(parent) if parent.as_os_str().is_empty() => Path::new("."),
+            Some(parent) => parent,
+            None => return self.mark_in(item.path(), None, true),
+        };
+        self.mark_in(folder, item.path().file_name(), is_folder)
+            .or_else(|| {
+                is_folder
+                    .then(|| self.mark_in(item.path(), None, true))
+                    .flatten()
+            })
+    }
+
+    /// The letters of `name` in `folder`, or of `folder` itself without a
+    /// name.
+    fn mark_in(&mut self, folder: &Path, name: Option<&OsStr>, is_folder: bool) -> Option<Mark> {
+        let (real_folder, index) = self.folder(folder)?;
+        let repository = &self.found[index];
+        let mut relative = real_folder
+            .strip_prefix(&repository.root)
+            .ok()?
+            .to_path_buf();
+        if let Some(name) = name {
+            relative.push(name);
+        }
+        Some(repository.mark(relative.as_os_str().as_bytes(), is_folder))
+    }
+
+    /// The real path of `folder` and the repository it is in.
+    fn folder(&mut self, folder: &Path) -> Option<(PathBuf, usize)> {
+        if let Some(known) = self.folders.get(folder) {
+            return known.clone();
+        }
+        let found = self.find(folder);
+        self.folders.insert(folder.to_path_buf(), found.clone());
+        found
+    }
+
+    fn find(&mut self, folder: &Path) -> Option<(PathBuf, usize)> {
+        let real_folder = folder.canonicalize().ok()?;
+        // A folder beneath a repository already asked about is in it, so
+        // a tree asks git once, not once a folder; unless a `.git` of its
+        // own comes between, as a submodule's.
+        if let Some(index) = self.holding(&real_folder) {
+            return Some((real_folder, index));
+        }
+        let root = PathBuf::from(OsStr::from_bytes(trim_line(&git(
+            &real_folder,
+            &["rev-parse", "--show-toplevel"],
+        )?)));
+        // Compared with real paths below, so it must be one too.
+        let root = root.canonicalize().unwrap_or(root);
+        if let Some(index) = self.found.iter().position(|r| r.root == root) {
+            return Some((real_folder, index));
+        }
+        let status = git(
+            &root,
+            &[
+                "status",
+                "--porcelain=v1",
+                "-z",
+                "--ignored=matching",
+                "--untracked-files=normal",
+            ],
+        )?;
+        self.found.push(Repository {
+            root,
+            changes: parse_status(&status),
+        });
+        Some((real_folder, self.found.len() - 1))
+    }
+}
+
+impl Repositories {
+    /// The repository already found that holds `real_folder`, the
+    /// innermost if one is inside another.
+    fn holding(&self, real_folder: &Path) -> Option<usize> {
+        let (index, repository) = self
+            .found
+            .iter()
+            .enumerate()
+            .filter(|(_, r)| real_folder.starts_with(&r.root))
+            .max_by_key(|(_, r)| r.root.as_os_str().len())?;
+        let own_git = real_folder
+            .ancestors()
+            .take_while(|folder| *folder != repository.root)
+            .any(|folder| {
+                // Inside `.git` itself is not a work tree; git says so.
+                folder.file_name() == Some(OsStr::new(".git"))
+                    || folder.join(".git").symlink_metadata().is_ok()
+            });
+        (!own_git).then_some(index)
+    }
+}
+
+impl Repository {
+    /// The letters of the path `relative` from the root.
+    fn mark(&self, relative: &[u8], is_folder: bool) -> Mark {
+        // Beneath a folder git reports whole, everything takes its mark.
+        for (i, _) in relative.iter().enumerate().filter(|(_, b)| **b == b'/') {
+            if let Some(mark) = self.changes.get(&relative[..=i]) {
+                return *mark;
+            }
+        }
+        if let Some(mark) = self.changes.get(relative) {
+            return *mark;
+        }
+        if !is_folder {
+            return CLEAN;
+        }
+        let mut folder = relative.to_vec();
+        if !folder.is_empty() {
+            folder.push(b'/');
+        }
+        if let Some(mark) = self.changes.get(&folder) {
+            return *mark;
+        }
+        self.changes
+            .range(folder.clone()..)
+            .take_while(|(path, _)| path.starts_with(&folder))
+            .map(|(_, mark)| *mark)
+            .fold(CLEAN, |held, mark| {
+                [stronger(held[0], mark[0]), stronger(held[1], mark[1])]
+            })
+    }
+}
+
+/// The more telling of two letters for a folder's column. What is
+/// ignored inside a folder says nothing of the folder, so `I` counts as
+/// unchanged here.
+fn stronger(a: u8, b: u8) -> u8 {
+    const ORDER: &[u8] = b"UDMRTN";
+    let rank = |letter: u8| {
+        ORDER
+            .iter()
+            .position(|&l| l == letter)
+            .unwrap_or(ORDER.len())
+    };
+    if rank(b) < rank(a) { b } else { a }
+}
+
+/// Reads `git status --porcelain=v1 -z`: entries of `XY path`, each ended
+/// by a NUL, a rename's or copy's followed by its old path.
+fn parse_status(status: &[u8]) -> BTreeMap<Vec<u8>, Mark> {
+    let mut changes = BTreeMap::new();
+    let mut fields = status.split(|&b| b == 0);
+    while let Some(field) = fields.next() {
+        let [x, y, b' ', path @ ..] = field else {
+            continue;
+        };
+        if matches!(x, b'R' | b'C') || matches!(y, b'R' | b'C') {
+            fields.next();
+        }
+        changes.insert(path.to_vec(), letters(*x, *y));
+    }
+    changes
+}
+
+/// The column's letters for git's status letters `x` (the index) and `y`
+/// (the work tree).
+fn letters(x: u8, y: u8) -> Mark {
+    // Both sides changed it: git's unmerged pairs (DD, AU, UD, UA, DU,
+    // AA, UU).
+    if x == b'U' || y == b'U' || (x == y && matches!(x, b'A' | b'D')) {
+        return *b"UU";
+    }
+    let staged = match x {
+        b'A' | b'C' => b'N',
+        b'M' | b'D' | b'R' | b'T' => x,
+        _ => b'-',
+    };
+    let unstaged = match y {
+        b'?' | b'A' => b'N',
+        b'!' => b'I',
+        b'M' | b'D' | b'T' | b'R' => y,
+        _ => b'-',
+    };
+    [staged, unstaged]
+}
+
+/// Runs git in `folder` and gives what it printed, or `None` if it could
+/// not run or failed, as outside a repository.
+fn git(folder: &Path, arguments: &[&str]) -> Option<Vec<u8>> {
+    let output = Command::new("git")
+        .arg("--no-optional-locks")
+        .args(["-c", "core.fsmonitor=false", "-C"])
+        .arg(folder)
+        .args(arguments)
+        .stdin(Stdio::null())
+        .stderr(Stdio::null())
+        .output()
+        .ok()?;
+    output.status.success().then_some(output.stdout)
+}
+
+fn trim_line(text: &[u8]) -> &[u8] {
+    text.strip_suffix(b"\n").unwrap_or(text)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn repository(status: &[u8]) -> Repository {
+        Repository {
+            root: PathBuf::from("/r"),
+            changes: parse_status(status),
+        }
+    }
+
+    #[test]
+    fn letters_say_staged_then_not() {
+        assert_eq!(&letters(b'A', b' '), b"N-");
+        assert_eq!(&letters(b' ', b'M'), b"-M");
+        assert_eq!(&letters(b'M', b'M'), b"MM");
+        assert_eq!(&letters(b'?', b'?'), b"-N");
+        assert_eq!(&letters(b'!', b'!'), b"-I");
+        assert_eq!(&letters(b'R', b' '), b"R-");
+        assert_eq!(&letters(b'U', b'U'), b"UU");
+        assert_eq!(&letters(b'A', b'A'), b"UU");
+    }
+
+    #[test]
+    fn renames_skip_their_old_name() {
+        let repo = repository(b"R  new.txt\0old.txt\0 M docs/a.md\0");
+        assert_eq!(&repo.mark(b"new.txt", false), b"R-");
+        assert_eq!(&repo.mark(b"old.txt", false), b"--");
+        assert_eq!(&repo.mark(b"docs/a.md", false), b"-M");
+    }
+
+    #[test]
+    fn folders_show_what_they_hold() {
+        let repo = repository(
+            b" M docs/a.md\0A  docs/b.md\0!! target/\0?? notes/\0!! src/x.o\0 D src/old.rs\0",
+        );
+        assert_eq!(&repo.mark(b"docs", true), b"NM");
+        assert_eq!(&repo.mark(b"target", true), b"-I");
+        assert_eq!(&repo.mark(b"target/debug/ls", false), b"-I");
+        assert_eq!(&repo.mark(b"notes", true), b"-N");
+        assert_eq!(&repo.mark(b"notes/todo.txt", false), b"-N");
+        // An ignored file inside says nothing of its folder.
+        assert_eq!(&repo.mark(b"src", true), b"-D");
+        assert_eq!(&repo.mark(b"src/x.o", false), b"-I");
+        assert_eq!(&repo.mark(b"clean", true), b"--");
+        // The root holds everything.
+        assert_eq!(&repo.mark(b"", true), b"ND");
+    }
+
+    #[test]
+    fn a_folder_is_not_matched_by_a_longer_name() {
+        let repo = repository(b" M docs2/a.md\0");
+        assert_eq!(&repo.mark(b"docs", true), b"--");
+    }
+}
