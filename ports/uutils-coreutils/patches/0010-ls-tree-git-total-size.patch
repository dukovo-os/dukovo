--- /dev/null
+++ b/src/uu/ls/src/tree.rs
@@ -0,0 +1,160 @@
+// This file is part of the uutils coreutils package.
+//
+// For the full copyright and license information, please view the LICENSE
+// file that was distributed with this source code.
+
+//! `--tree` (ADR 0441): a folder and everything beneath it, each name
+//! under its folder with lines drawn to it, as `tree` draws them, in
+//! one column or as the long listing. `--level=N` stops N folders down.
+//!
+//! The folder is read first and written after, so that the long
+//! listing's columns line up over the whole tree; a folder that cannot
+//! be read is reported and shown with nothing beneath it. Each folder is
+//! read as `ls` reads one: the same names hidden and the same order,
+//! with `-a`'s `.` and `..` left out, as they are not beneath it.
+//!
+//! A link to a folder is followed only when `-L` says so, and a folder
+//! inside itself that way is reported, as `-R` does, and not entered
+//! again. If the lines look wrong, start in [`walk`].
+
+use std::fs::{self, FileType, ReadDir};
+use std::iter::Peekable;
+use std::os::unix::fs::MetadataExt;
+use std::vec;
+
+use uucore::error::UResult;
+use uucore::show;
+
+use crate::{Config, LsError, LsOutput, PathData, collect_directory_entries};
+
+/// Before a name with more after it in its folder.
+const BRANCH: &str = "├── ";
+/// Before the last name in its folder.
+const LAST: &str = "└── ";
+/// Beneath a name with more after it: its folder's line goes on down.
+const LINE: &str = "│   ";
+/// Beneath the last name: nothing more to draw.
+const SPACE: &str = "    ";
+
+/// A folder and everything beneath it, in the order written.
+pub struct Tree {
+    /// The folder first, then each name beneath it.
+    pub(crate) items: Vec<PathData<'static>>,
+    /// What to draw before each item's name; empty for the folder.
+    pub(crate) branches: Vec<String>,
+    /// How many folders and other files are beneath it.
+    pub(crate) folders: usize,
+    pub(crate) files: usize,
+}
+
+/// A folder being written: what is left of it, and the lines its
+/// names go beneath.
+struct Level {
+    children: Peekable<vec::IntoIter<PathData<'static>>>,
+    indent: String,
+    /// The folder's device and inode, so a link back to it is seen.
+    id: Option<(u64, u64)>,
+}
+
+/// Reads `folder` and everything beneath it, `read_dir` being `folder`
+/// already opened.
+pub(crate) fn walk<O: LsOutput>(
+    folder: &PathData,
+    read_dir: ReadDir,
+    config: &Config,
+    output: &mut O,
+) -> UResult<Tree> {
+    let root = PathData::new(
+        folder.path().to_path_buf().into(),
+        None,
+        None,
+        config,
+        folder.command_line,
+        false,
+    );
+    let mut stack = vec![open(&root, read_dir, String::new(), config, output)?];
+    let mut tree = Tree {
+        items: vec![root],
+        branches: vec![String::new()],
+        folders: 0,
+        files: 0,
+    };
+
+    loop {
+        let depth = stack.len();
+        let Some(level) = stack.last_mut() else {
+            break;
+        };
+        let Some(child) = level.children.next() else {
+            stack.pop();
+            continue;
+        };
+        let last = level.children.peek().is_none();
+        let branch = format!("{}{}", level.indent, if last { LAST } else { BRANCH });
+        let indent = format!("{}{}", level.indent, if last { SPACE } else { LINE });
+
+        let is_folder = child.file_type().is_some_and(FileType::is_dir);
+        let mut beneath = None;
+        if is_folder {
+            tree.folders += 1;
+            if config.tree_level.is_none_or(|levels| depth < levels) {
+                beneath = enter(&child, &stack, indent, config, output)?;
+            }
+        } else {
+            tree.files += 1;
+        }
+        tree.items.push(child);
+        tree.branches.push(branch);
+        if let Some(beneath) = beneath {
+            stack.push(beneath);
+        }
+    }
+    Ok(tree)
+}
+
+/// Opens the folder `item` to write what is beneath it, or `None` if
+/// it cannot be read or is one of the folders it is beneath.
+fn enter<O: LsOutput>(
+    item: &PathData,
+    above: &[Level],
+    indent: String,
+    config: &Config,
+    output: &mut O,
+) -> UResult<Option<Level>> {
+    let id = item.metadata().map(|md| (md.dev(), md.ino()));
+    if id.is_some() && above.iter().any(|level| level.id == id) {
+        output.flush()?;
+        show!(LsError::AlreadyListedError(item.path().to_path_buf()));
+        return Ok(None);
+    }
+    match fs::read_dir(item.path()) {
+        Ok(read_dir) => Ok(Some(open(item, read_dir, indent, config, output)?)),
+        Err(err) => {
+            output.flush()?;
+            show!(LsError::IOErrorContext(
+                item.path().to_path_buf(),
+                err,
+                item.command_line
+            ));
+            Ok(None)
+        }
+    }
+}
+
+/// The names in `folder`, as `ls` lists them, to go beneath it.
+fn open<O: LsOutput>(
+    folder: &PathData,
+    mut read_dir: ReadDir,
+    indent: String,
+    config: &Config,
+    output: &mut O,
+) -> UResult<Level> {
+    let mut children = Vec::new();
+    collect_directory_entries(&mut children, folder, config, output, &mut read_dir)?;
+    children.retain(|child| !child.is_dot_dir);
+    Ok(Level {
+        children: children.into_iter().peekable(),
+        indent,
+        id: folder.metadata().map(|md| (md.dev(), md.ino())),
+    })
+}
