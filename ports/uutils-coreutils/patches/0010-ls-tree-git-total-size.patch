+    /// Writes `--git`'s two letters, each in its colour; two in one
+    /// colour, as `--`, share one span.
+    pub(crate) fn paint_git(&self, mark: [u8; 2], out: &mut Vec<u8>) {
+        let [staged, unstaged] = mark.map(|letter| self.git_code(letter));
+        if staged == unstaged {
+            self.paint(staged, &String::from_utf8_lossy(&mark), out);
+        } else {
+            self.paint(staged, &char::from(mark[0]).to_string(), out);
+            self.paint(unstaged, &char::from(mark[1]).to_string(), out);
+        }
+    }
+
+    /// The colour of one of `--git`'s letters.
+    fn git_code(&self, letter: u8) -> &str {
+        match letter {
+            b'N' => &self.git_new,
+            b'M' | b'T' => &self.git_modified,
+            b'D' => &self.git_deleted,
+            b'R' => &self.git_renamed,
+            b'I' => &self.git_ignored,
+            b'U' => &self.git_conflict,
+            b'-' => &self.none,
+            _ => "",
+        }
+    }
+
