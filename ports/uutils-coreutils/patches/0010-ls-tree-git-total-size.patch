@@ -0,0 +1,99 @@
+// This file is part of the uutils coreutils package.
+//
+// For the full copyright and license information, please view the LICENSE
+// file that was distributed with this source code.
+
+//! `--total-size` (ADR 0441): a folder's size in the long listing is what
+//! it holds, the lengths of all the files beneath it added up, not the few
+//! bytes of the folder's own entry, so that the folder taking the space
+//! stands out without du.
+//!
+//! The count is of each file's length (what `du --apparent-size` counts
+//! for a file), each file once however many hard links it has, and stays
+//! on the folder's filesystem, as `du -x` does, so that a folder with a
+//! disk mounted in it, or `/` with `/processes` beneath it, counts only
+//! its own. The folders' own entries count nothing, so an empty folder is
+//! 0. A folder that cannot be read counts as empty; nothing is said of
+//! it, since `ls` is not checking the tree. If a size looks too small,
+//! compare it with `du -s -x --apparent-size`, which also counts each
+//! folder's own entry.
+
+use std::fs::{self, Metadata};
+use std::os::unix::fs::MetadataExt;
+use std::path::{Path, PathBuf};
+
+use rustc_hash::FxHashSet;
+
+use crate::{Config, PathData};
+
+/// The size the long listing shows for `item`, and `-S` sorts by: what a
+/// folder holds with `--total-size`, the length of anything else. `.` and
+/// `..` keep their own lengths: `..` would count the whole parent.
+pub(crate) fn shown_size(item: &PathData, metadata: &Metadata, config: &Config) -> u64 {
+    if config.total_size && metadata.is_dir() && !item.is_dot_dir {
+        *item
+            .total_size
+            .get_or_init(|| folder_size(item.path(), metadata.dev()))
+    } else {
+        metadata.len()
+    }
+}
+
+/// The lengths of all the files beneath `folder` on the device `device`,
+/// each counted once.
+fn folder_size(folder: &Path, device: u64) -> u64 {
+    let mut total = 0;
+    // Files with more than one name, by device and inode, so that a file
+    // linked twice beneath the folder counts once.
+    let mut linked = FxHashSet::default();
+    let mut folders: Vec<PathBuf> = vec![folder.to_path_buf()];
+    while let Some(folder) = folders.pop() {
+        let Ok(entries) = fs::read_dir(&folder) else {
+            continue;
+        };
+        for entry in entries.flatten() {
+            // The entry's own metadata: a link to a folder is not followed.
+            let Ok(metadata) = entry.metadata() else {
+                continue;
+            };
+            if metadata.dev() != device {
+                continue;
+            }
+            if metadata.is_dir() {
+                folders.push(entry.path());
+            } else if metadata.nlink() < 2 || linked.insert((metadata.dev(), metadata.ino())) {
+                total += metadata.len();
+            }
+        }
+    }
+    total
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn files_count_once_and_folders_add_up() {
+        let dir = std::env::temp_dir().join(format!("ls-total-size-{}", std::process::id()));
+        let _ = fs::remove_dir_all(&dir);
+        fs::create_dir_all(dir.join("a/b")).unwrap();
+        fs::write(dir.join("one"), [0; 100]).unwrap();
+        fs::write(dir.join("a/two"), [0; 20]).unwrap();
+        fs::write(dir.join("a/b/three"), [0; 3]).unwrap();
+        // A second name for `one` adds nothing, nor does a link to a folder.
+        fs::hard_link(dir.join("one"), dir.join("a/one-again")).unwrap();
+        std::os::unix::fs::symlink(dir.join("a"), dir.join("a/b/up")).unwrap();
+        let device = fs::metadata(&dir).unwrap().dev();
+        let up_length = fs::symlink_metadata(dir.join("a/b/up")).unwrap().len();
+        assert_eq!(folder_size(&dir, device), 123 + up_length);
+        assert_eq!(folder_size(&dir.join("a/b"), device), 3 + up_length);
+        fs::remove_dir_all(&dir).unwrap();
+    }
+
+    #[test]
+    fn another_filesystem_counts_nothing() {
+        let dir = std::env::temp_dir();
+        assert_eq!(folder_size(&dir, u64::MAX), 0);
+    }
+}
