+/// Writes what comes after the time and before the name (ADR 0441):
+/// `--git`'s letters and a space, then `--tree`'s lines.
+fn write_line_parts(
+    parts: LineParts,
+    padding: &PaddingCollection,
+    config: &Config,
+    out: &mut Vec<u8>,
+) {
+    if let Some(mark) = parts.git {
+        match &config.field_colors {
+            Some(colors) => colors.paint_git(mark, out),
+            None => out.extend(mark),
+        }
+        out.extend(iter::repeat_n(b' ', padding.git - git::WIDTH + 1));
+    }
+    write_branch(parts.branch, config, out);
+}
+
+/// Writes a tree's lines before a name, in the `tree` colour when the
+/// fields are coloured (ADR 0441).
+fn write_branch(branch: &str, config: &Config, out: &mut Vec<u8>) {
+    if branch.is_empty() {
+        return;
+    }
+    match &config.field_colors {
+        Some(colors) => colors.paint_tree(branch, out),
+        None => out.extend(branch.as_bytes()),
+    }
+}
