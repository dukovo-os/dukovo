Commit 159e1de0c448d7b9f09ad768c8e141def4aa1eb4 of OpenSSL's openssl-3.5
branch, which fixes CVE-2026-88823. AES-GCM-SIV takes an update of zero
bytes of AAD for a reset and frees the AAD it has gathered, so the
chunks before it go unauthenticated, and a context that starts another
message keeps the AAD of the one before. The patch makes an update of
zero bytes change nothing, and clears the AAD on an initialization with
a key or a nonce, or after an operation has ended; an initialization
that sets parameters alone keeps it. OpenSSL 3.5.10 holds the fix; 3.5.9
does not.

From: Daniel Kubec <kubec@openssl.foundation>
Date: Sat, 31 Oct 2026 19:16:53 +0100
Subject: AES-GCM-SIV: no-op on zero-length update and clear stale AAD
 on reuse
---
 providers/implementations/ciphers/cipher_aes_gcm_siv.c | 10 ++++++++++
 .../implementations/ciphers/cipher_aes_gcm_siv_hw.c    |  7 +------
 2 files changed, 11 insertions(+), 6 deletions(-)

diff --git a/providers/implementations/ciphers/cipher_aes_gcm_siv.c b/providers/implementations/ciphers/cipher_aes_gcm_siv.c
index f29379c..437be68 100644
--- a/providers/implementations/ciphers/cipher_aes_gcm_siv.c
+++ b/providers/implementations/ciphers/cipher_aes_gcm_siv.c
@@ -99,6 +99,16 @@ static int ossl_aes_gcm_siv_init(void *vctx, const unsigned char *key, size_t ke
 
     ctx->enc = enc;
 
+    /*
+     * Clear AAD when starting a new message or restarting after payload
+     * processing. Preserve pending AAD during parameter adjustments.
+     */
+    if (key != NULL || iv != NULL || ctx->used_enc || ctx->used_dec) {
+        OPENSSL_clear_free(ctx->aad, ctx->aad_len);
+        ctx->aad = NULL;
+        ctx->aad_len = 0;
+    }
+
     if (key != NULL) {
         if (keylen != ctx->key_len) {
             ERR_raise(ERR_LIB_PROV, PROV_R_INVALID_KEY_LENGTH);
diff --git a/providers/implementations/ciphers/cipher_aes_gcm_siv_hw.c b/providers/implementations/ciphers/cipher_aes_gcm_siv_hw.c
index c1079e0..9cec707 100644
--- a/providers/implementations/ciphers/cipher_aes_gcm_siv_hw.c
+++ b/providers/implementations/ciphers/cipher_aes_gcm_siv_hw.c
@@ -114,13 +114,8 @@ static int aes_gcm_siv_aad(PROV_AES_GCM_SIV_CTX *ctx,
     uint8_t *ptr;
     uint64_t len64;
 
-    /* length of 0 resets the AAD */
-    if (len == 0) {
-        OPENSSL_free(ctx->aad);
-        ctx->aad = NULL;
-        ctx->aad_len = 0;
+    if (len == 0)
         return 1;
-    }
     to_alloc = UP16(ctx->aad_len + len);
     /* need to check the size of the AAD per RFC8452 */
     len64 = to_alloc;
