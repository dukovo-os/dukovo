Commit 257a3427aa0ef8d9dd2ef5b3e2d1c021a221b116 of OpenSSL's openssl-3.5
branch, which fixes CVE-2026-95692. AES-GCM-SIV takes a nonce of 12
bytes only, but it does not list the IV length among the parameters it
accepts: setting any other length reports success and the provider
ignores it, and the initialization that follows reads 12 bytes from the
caller's IV buffer, which can be shorter. The patch accepts the IV
length and refuses any but 12. OpenSSL 3.5.10 holds the fix; 3.5.9 does
not.

From: Norbert Pocs <norbertp@openssl.org>
Date: Wed, 28 Oct 2026 14:04:53 +0400
Subject: Reject unsupported IV lengths for AES-GCM-SIV
---
 .../implementations/ciphers/cipher_aes_gcm_siv.c   | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/providers/implementations/ciphers/cipher_aes_gcm_siv.c b/providers/implementations/ciphers/cipher_aes_gcm_siv.c
index 484993e..f29379c 100644
--- a/providers/implementations/ciphers/cipher_aes_gcm_siv.c
+++ b/providers/implementations/ciphers/cipher_aes_gcm_siv.c
@@ -255,6 +255,20 @@ static int ossl_aes_gcm_siv_set_ctx_params(void *vctx, const OSSL_PARAM params[]
             return 0;
         }
     }
+    p = OSSL_PARAM_locate_const(params, OSSL_CIPHER_PARAM_AEAD_IVLEN);
+    if (p != NULL) {
+        size_t iv_len;
+
+        if (!OSSL_PARAM_get_size_t(p, &iv_len)) {
+            ERR_raise(ERR_LIB_PROV, PROV_R_FAILED_TO_GET_PARAMETER);
+            return 0;
+        }
+        /* The nonce length can not be modified */
+        if (iv_len != sizeof(ctx->nonce)) {
+            ERR_raise(ERR_LIB_PROV, PROV_R_INVALID_IV_LENGTH);
+            return 0;
+        }
+    }
     return 1;
 }
 
