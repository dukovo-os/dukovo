# PHP-FPM's service (ADR 0520): runs as the account php, in its data
# folder ($HOME), and keeps PHP-FPM in the foreground, as Spark's services
# are, its log on its standard error output, which the system's log
# keeps.
#
# Its settings are in $HOME/conf, the files the pages' sessions are kept
# in $HOME/sessions, and what they upload is held in $HOME/temp until the
# page moves it. The first start copies into $HOME/conf the settings the
# bundle brings: php-fpm.conf, and the php.ini PHP-FPM reads. After that, a
# file the administrator has not changed takes the bundle's new version on
# an update; a changed one stays, and the bundle's version is written
# beside it as NAME.default, as the service files' are (ADR 0386). The
# copying is nginx's service's, repeated here: two bundles cannot share a
# script.
set -eu

bundle=$(cd "$(dirname "$0")/.." && pwd)
mkdir -p "$HOME/conf" "$HOME/sessions" "$HOME/temp"
chmod 0700 "$HOME/sessions"

# Copies $1 to $2 as a file of the account's, which it may change: the
# bundle's files are read-only, and so would a copy of one be.
copy() {
	rm -f "$2"
	cp "$1" "$2"
	chmod 0600 "$2"
}

# What the bundle brought last time, to tell an administrator's change
# from an older version of the bundle's file.
mkdir -p "$HOME/conf/.bundle"
for shipped in "$bundle"/conf/*; do
	name=${shipped##*/}
	file="$HOME/conf/$name"
	last="$HOME/conf/.bundle/$name"
	if [ ! -e "$file" ]; then
		copy "$shipped" "$file"
		rm -f "$file.default"
	elif cmp -s "$shipped" "$file"; then
		rm -f "$file.default"
	elif [ -e "$last" ] && cmp -s "$last" "$file"; then
		# Unchanged since the bundle wrote it: the new version.
		copy "$shipped" "$file"
		rm -f "$file.default"
	else
		copy "$shipped" "$file.default"
	fi
	copy "$shipped" "$last"
done

# No -c and no -y: PHP-FPM finds php-fpm.conf and php.ini in $HOME/conf by
# itself (its sysconfdir, and patch 0009), so that `php-fpm -t`, which an
# administrator runs with no options, reads the same files.
exec "$bundle/bin/php-fpm" --nodaemonize
