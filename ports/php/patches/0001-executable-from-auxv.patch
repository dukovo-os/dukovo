+#ifdef __radix__
+/* Whether the file at path starts with "#!", or cannot be read to tell */
+static bool radix_is_script(const char *path)
+{
+	char head[2];
+	int fd = open(path, O_RDONLY | O_CLOEXEC);
+	if (fd < 0) {
+		return true;
+	}
+	ssize_t n = read(fd, head, sizeof(head));
+	close(fd);
+	return n != (ssize_t) sizeof(head) || (head[0] == '#' && head[1] == '!');
+}
+
+/* The path the program was run as, which the kernel gives in the auxiliary
+ * vector: a command of a bundle is run by its path in the bundle's folder,
+ * with only its name as argv[0]. For a script whose #! line names PHP, it is
+ * the script's path, as on Linux, and argv[0] is the interpreter's, which
+ * the search by argv[0] takes instead. */
+static char *radix_binary_location(void)
+{
+	const char *path = (const char *) getauxval(AT_EXECFN);
+	if (!path || path[0] != '/' || radix_is_script(path)) {
+		return NULL;
+	}
+	char *binary_location = (char *) pemalloc(MAXPATHLEN, 1);
+	if (!VCWD_REALPATH(path, binary_location)) {
+		pefree(binary_location, 1);
+		return NULL;
+	}
+	return binary_location;
+}
+#endif
+
