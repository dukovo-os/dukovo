+#include <poll.h>
+#include <string.h>
+
+typedef struct aeApiState {
+    struct pollfd *fds; /* The descriptors watched, packed at the front. */
+    int *slots;         /* Each descriptor's index in fds, or -1. */
+    int count;          /* How many of fds are watched. */
+} aeApiState;
+
+static int aeApiCreate(aeEventLoop *eventLoop) {
+    aeApiState *state = zmalloc(sizeof(aeApiState));
+    int j;
+
+    if (!state) return -1;
+    state->fds = zmalloc(sizeof(struct pollfd) * eventLoop->setsize);
+    state->slots = zmalloc(sizeof(int) * eventLoop->setsize);
+    if (!state->fds || !state->slots) {
+        zfree(state->fds);
+        zfree(state->slots);
+        zfree(state);
+        return -1;
+    }
+    for (j = 0; j < eventLoop->setsize; j++) state->slots[j] = -1;
+    state->count = 0;
+    eventLoop->apidata = state;
+    return 0;
+}
+
+static int aeApiResize(aeEventLoop *eventLoop, int setsize) {
+    aeApiState *state = eventLoop->apidata;
+    int j;
+
+    /* ae.c checks that no descriptor watched is setsize or more, so the
+     * watched ones keep their places. */
+    state->fds = zrealloc(state->fds, sizeof(struct pollfd) * setsize);
+    state->slots = zrealloc(state->slots, sizeof(int) * setsize);
+    for (j = eventLoop->setsize; j < setsize; j++) state->slots[j] = -1;
+    return 0;
+}
+
+static void aeApiFree(aeEventLoop *eventLoop) {
+    aeApiState *state = eventLoop->apidata;
+
+    zfree(state->fds);
+    zfree(state->slots);
+    zfree(state);
+}
+
+/* The poll(2) events of an ae.c mask. */
+static short aeApiPollEvents(int mask) {
+    short events = 0;
+
+    if (mask & AE_READABLE) events |= POLLIN;
+    if (mask & AE_WRITABLE) events |= POLLOUT;
+    return events;
+}
+
+static int aeApiAddEvent(aeEventLoop *eventLoop, int fd, int mask) {
+    aeApiState *state = eventLoop->apidata;
+    int slot = state->slots[fd];
+
+    mask |= eventLoop->events[fd].mask; /* Merge old events */
+    if (slot == -1) {
+        slot = state->count++;
+        state->slots[fd] = slot;
+        state->fds[slot].fd = fd;
+        state->fds[slot].revents = 0;
+    }
+    state->fds[slot].events = aeApiPollEvents(mask);
+    return 0;
+}
+
+static void aeApiDelEvent(aeEventLoop *eventLoop, int fd, int mask) {
+    aeApiState *state = eventLoop->apidata;
+    int slot = state->slots[fd];
+
+    if (slot == -1) return;
+    /* As for epoll: the caller has already updated the mask in the event
+     * loop. */
+    mask = eventLoop->events[fd].mask;
+    if (mask != AE_NONE) {
+        state->fds[slot].events = aeApiPollEvents(mask);
+        return;
+    }
+    /* The last one takes its place. */
+    state->count--;
+    if (slot != state->count) {
+        state->fds[slot] = state->fds[state->count];
+        state->slots[state->fds[slot].fd] = slot;
+    }
+    state->slots[fd] = -1;
+}
+
+static int aeApiPoll(aeEventLoop *eventLoop, struct timeval *tvp) {
+    aeApiState *state = eventLoop->apidata;
+    int retval, j, numevents = 0;
+
+    retval = poll(state->fds, state->count, tvp ? (tvp->tv_sec * 1000 + (tvp->tv_usec + 999) / 1000) : -1);
+    if (retval > 0) {
+        for (j = 0; j < state->count && numevents < retval; j++) {
+            struct pollfd *p = state->fds + j;
+            int mask = 0;
+
+            if (p->revents == 0) continue;
+            if (p->revents & POLLIN) mask |= AE_READABLE;
+            if (p->revents & POLLOUT) mask |= AE_WRITABLE;
+            /* As for epoll: an error or a hang-up is reported to both
+             * handlers, which find it as they read or write. */
+            if (p->revents & (POLLERR | POLLHUP | POLLNVAL)) mask |= AE_WRITABLE | AE_READABLE;
+            eventLoop->fired[numevents].fd = p->fd;
+            eventLoop->fired[numevents].mask = mask;
+            numevents++;
+        }
+    } else if (retval == -1 && errno != EINTR) {
+        panic("aeApiPoll: poll, %s", strerror(errno));
+    }
+
+    return numevents;
+}
+
+static char *aeApiName(void) {
+    return "poll";
+}
