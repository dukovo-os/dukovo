+// Copyright 2026 The Dukovo contributors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package syscall
+
+// Radix has no ptrace. exec_libc2.go does not call it on Radix; this
+// stands in for the C library's, in asm_radix_amd64.s.
+func libc_ptrace_trampoline()
+
+// Radix's headers have no ptrace requests. exec_libc2.go names this
+// one, Linux's value, and does not issue it on Radix.
+const PTRACE_TRACEME = 0
+
+// execveSyscall is the system call exec_unix.go makes on systems with
+// system call numbers. Radix programs call the C library's execve.
+func execveSyscall(path *byte, argv **byte, envp **byte) error {
+	return execve(path, argv, envp)
+}
