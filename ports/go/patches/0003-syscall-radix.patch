@@ -0,0 +1,19 @@
+// Copyright 2026 The Dukovo contributors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+//go:build unix && !radix
+
+package syscall
+
+import "unsafe"
+
+// execveSyscall makes the execve system call, on the systems whose
+// programs may make system calls themselves (see Exec).
+func execveSyscall(path *byte, argv **byte, envp **byte) error {
+	_, _, err := RawSyscall(SYS_EXECVE,
+		uintptr(unsafe.Pointer(path)),
+		uintptr(unsafe.Pointer(argv)),
+		uintptr(unsafe.Pointer(envp)))
+	return err
+}
