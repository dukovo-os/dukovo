+// Copyright 2026 The Dukovo contributors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+// Radix system calls.
+// Radix's programs reach the kernel through the C library (mlibc), as
+// OpenBSD's do, and its POSIX interface takes Linux's numbers and
+// structures. Each function here is the C library's, which the
+// runtime calls on the system stack through a trampoline.
+// This file is compiled as ordinary Go code,
+// but it is also input to mksyscall,
+// which parses the //sys lines and generates the calls.
+// Note that sometimes we use a lowercase //sys name and wrap
+// it in our own nicer implementation, either here or in
+// syscall_unix.go.
+
+package syscall
+
+import (
+	"internal/abi"
+	"unsafe"
+)
+
+var dupTrampoline = abi.FuncPCABI0(libc_dup3_trampoline)
+
+func init() {
+	execveLibc = execve
+}
+
+// Radix has no system call numbers: its programs call the C library.
+// Syscall, Syscall6, Syscall9, RawSyscall and RawSyscall6 exist for
+// programs that name them, and fail with ENOSYS whatever the number.
+
+func syscallInternal(trap, a1, a2, a3 uintptr) (r1, r2 uintptr, err Errno) {
+	return 0, 0, ENOSYS
+}
+
+func syscall6Internal(trap, a1, a2, a3, a4, a5, a6 uintptr) (r1, r2 uintptr, err Errno) {
+	return 0, 0, ENOSYS
+}
+
+func rawSyscallInternal(trap, a1, a2, a3 uintptr) (r1, r2 uintptr, err Errno) {
+	return 0, 0, ENOSYS
+}
+
+func rawSyscall6Internal(trap, a1, a2, a3, a4, a5, a6 uintptr) (r1, r2 uintptr, err Errno) {
+	return 0, 0, ENOSYS
+}
+
+func syscall9Internal(trap, a1, a2, a3, a4, a5, a6, a7, a8, a9 uintptr) (r1, r2 uintptr, err Errno) {
+	return 0, 0, ENOSYS
+}
+
+// Implemented in the runtime package (runtime/sys_radix.go).
+func syscall(fn, a1, a2, a3 uintptr) (r1, r2 uintptr, err Errno)
