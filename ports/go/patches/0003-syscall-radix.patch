+# Radix's C library words errors and signals as glibc does on Linux.
+# A program built for Radix cannot run here, so the texts are read from
+# the library's source, whose directory MLIBC_SRC names, and the numbers
+# are read from its headers.
+radix_tables() {
+	local errno_texts=$MLIBC_SRC/options/ansi/generic/string.cpp
+	local signal_texts=$MLIBC_SRC/options/posix/generic/posix_string.cpp
+	local name
+
+	if [[ -z "$MLIBC_SRC" ]]; then
+		echo "mkerrors.sh: set MLIBC_SRC to the source tree of Radix's C library" >&2
+		return 1
+	fi
+
+	# Preprocessing a list of names, one to a line after a marker,
+	# replaces each with its number.
+	{
+		echo '#include <errno.h>'
+		echo '__marker__'
+		for name in $errors; do echo $name; done
+	} | $CC -x c - -E -P $ccflags | sed '1,/^__marker__$/d' >_error.numbers
+	{
+		echo '#include <signal.h>'
+		echo '__marker__'
+		for name in $signals; do echo $name; done
+	} | $CC -x c - -E -P $ccflags | sed '1,/^__marker__$/d' >_signal.numbers
+	echo $signals | tr ' ' '\n' | paste -d ' ' - _signal.numbers >_signal.pairs
+
+	awk '
+		# The array holds the text of error number n at index n.
+		/error_texts\[\] = \{/ {inarray = 1; next}
+		inarray && /^\};/ {inarray = 0}
+		inarray {
+			if ($0 ~ /^[ \t]*"/) {
+				t = $0
+				sub(/^[ \t]*"/, "", t)
+				sub(/",.*/, "", t)
+				text[n] = t
+			}
+			n++
+			next
+		}
+		FNR == NR {wanted[$1] = 1; next}
+		END {
+			print "\n\n// Error table"
+			print "var errors = [...]string {"
+			for (e = 0; e < n; e++) {
+				if (!(e in wanted)) continue
+				if (!(e in text)) {print "no text for error " e > "/dev/stderr"; exit 1}
+				t = text[e]
+				if (t ~ /^[A-Z][a-z]/) t = tolower(substr(t, 1, 1)) substr(t, 2)
+				printf("\t%d: \"%s\",\n", e, t)
+			}
+			print "}\n"
+		}
+	' _error.numbers "$errno_texts" || return 1
+
+	awk '
+		FNR == NR {number[$1] = $2; next}
+		/case SIG[A-Z0-9]+: s = "/ {
+			name = $2
+			sub(/:$/, "", name)
+			t = $0
+			sub(/^[^"]*"/, "", t)
+			sub(/".*/, "", t)
+			text[number[name]] = t
+		}
+		END {
+			print "\n\n// Signal table"
+			print "var signals = [...]string {"
+			for (e = 1; e < 256; e++) {
+				for (name in number) if (number[name] == e) found[e] = 1
+				if (!(e in found)) continue
+				if (!(e in text)) {print "no text for signal " e > "/dev/stderr"; exit 1}
+				t = text[e]
+				if (t ~ /^[A-Z][a-z]/) t = tolower(substr(t, 1, 1)) substr(t, 2)
+				printf("\t%d: \"%s\",\n", e, t)
+			}
+			print "}\n"
+		}
+	' _signal.pairs "$signal_texts" || return 1
+}
+
+if [[ "$uname" == "Radix" ]]; then
+	radix_tables || exit 1
+	rm -f _const.go _error.grep _signal.grep _error.out _error.numbers _signal.numbers _signal.pairs
+	exit 0
+fi
+
 # Run C program to print error and syscall strings.
 (
 	echo -E "
