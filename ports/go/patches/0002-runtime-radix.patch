+/*
+Input to cgo, with the Radix toolchain's C compiler.
+
+CC=x86_64-radix-cc GOARCH=amd64 go tool cgo -godefs defs_radix.go
+
+Radix takes Linux's numbers and structures for its POSIX interface,
+and its C library (mlibc) declares them as Linux's do, so the values
+are Linux's apart from the C library's own: its sigset_t (128 bytes),
+struct sigaction (whose mask comes last) and sysconf's names.
+*/
+
+package runtime
+
+/*
+#include <errno.h>
+#include <fcntl.h>
+#include <pthread.h>
+#include <signal.h>
+#include <sys/auxv.h>
+#include <sys/event.h>
+#include <sys/futex.h>
+#include <sys/mman.h>
+#include <sys/time.h>
+#include <time.h>
+#include <ucontext.h>
+#include <unistd.h>
+*/
