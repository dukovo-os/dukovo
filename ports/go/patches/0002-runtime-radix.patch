+// csigset is the C library's sigset_t, of which the kernel's 64 signals
+// are the first word. The runtime's own sigset is that word.
+type csigset struct {
+	__sig [16]uint64
+}
+
+// sigactiont is the C library's struct sigaction. The C library sets
+// the restorer itself.
+type sigactiont struct {
+	sa_handler  uintptr
+	sa_flags    int32
+	_           [4]byte
+	sa_restorer uintptr
+	sa_mask     csigset
+}
+
+// siginfo is siginfo_t as Linux lays it out; si_addr is the only field
+// of its union the runtime uses.
+type siginfo struct {
+	si_signo int32
+	si_errno int32
+	si_code  int32
+	_        [4]byte
+	si_addr  uint64
+	_        [104]byte
+}
+
+type stackt struct {
+	ss_sp     *byte
+	ss_flags  int32
+	pad_cgo_0 [4]byte
+	ss_size   uintptr
+}
+
+type timespec struct {
+	tv_sec  int64
+	tv_nsec int64
+}
+
+//go:nosplit
+func (ts *timespec) setNsec(ns int64) {
+	ts.tv_sec = ns / 1e9
+	ts.tv_nsec = ns % 1e9
+}
+
+type keventt struct {
+	ident  uint64
+	filter int16
+	flags  uint16
+	fflags uint32
+	data   int64
+	udata  *byte
+}
+
+type timeval struct {
+	tv_sec  int64
+	tv_usec int64
+}
+
+func (tv *timeval) set_usec(x int32) {
+	tv.tv_usec = int64(x)
+}
+
+type itimerval struct {
+	it_interval timeval
+	it_value    timeval
+}
+
+// mcontext and ucontext are the C library's mcontext_t and ucontext_t,
+// as far as the signal mask: Linux's, which is how the kernel writes a
+// signal handler's frame.
+type mcontext struct {
+	gregs       [23]uint64
+	fpregs      unsafe.Pointer
+	__reserved1 [8]uint64
+}
+
+type ucontext struct {
+	uc_flags    uint64
+	uc_link     *ucontext
+	uc_stack    stackt
+	uc_mcontext mcontext
+	uc_sigmask  uint64
+}
+
+// sigcontext is mcontext's general registers by name, as Linux's
+// struct sigcontext has them.
+type sigcontext struct {
+	r8      uint64
+	r9      uint64
+	r10     uint64
+	r11     uint64
+	r12     uint64
+	r13     uint64
+	r14     uint64
+	r15     uint64
