+	eflags  uint64
+	cs      uint16
+	gs      uint16
+	fs      uint16
+	__pad0  uint16
+	err     uint64
+	trapno  uint64
+	oldmask uint64
+	cr2     uint64
+	fpstate unsafe.Pointer
+	_       [8]uint64
+}
+
+// pthreadattr is the C library's pthread_attr_t, a pointer to what
+// pthread_attr_init allocates.
+type pthreadattr struct {
+	__heap_ptr *byte
+}
