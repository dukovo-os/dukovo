new file mode 100644
index 00000000..c6cf138a
--- /dev/null
+++ b/src/runtime/rt0_radix_amd64.s
@@ -0,0 +1,21 @@
+// Copyright 2026 The Dukovo contributors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+#include "textflag.h"
+
+// _rt0_amd64_radix is a Go program's first instruction. A Go program
+// starts the C library as a C program's crt1.o does: __mlibc_entry
+// reads the descriptors and working directory the program was given,
+// finishes the dynamic linker's work and calls main, the C-ABI entry
+// that asm_amd64.s gives external linking, which goes on to rt0_go.
+// The kernel starts the program with the stack pointer on argc, then
+// argv, envp and the auxiliary vector, which __mlibc_entry reads.
+TEXT _rt0_amd64_radix(SB),NOSPLIT|NOFRAME|TOPFRAME,$0
+	XORL	BP, BP
+	LEAQ	main(SB), DI	// arg 1 - main
+	MOVQ	SP, SI		// arg 2 - the stack the program started with
+	ANDQ	$~15, SP
+	CALL	libc___mlibc_entry(SB)
+	MOVL	$0xf1, 0xf1	// crash: __mlibc_entry does not return
+	RET
