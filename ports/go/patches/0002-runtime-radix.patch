+// Copyright 2026 The Dukovo contributors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+// Radix is the kernel of Dukovo. It takes Linux's numbers and structures
+// for its POSIX interface, and its programs reach it through the C
+// library (mlibc), as OpenBSD's do: threads are the C library's
+// pthreads, locks wait on its futex(2) and signals go through its
+// sigaction.
+
+package runtime
+
+import (
+	"internal/abi"
+	"internal/goarch"
+	"unsafe"
+)
+
+const (
+	_SS_DISABLE = 2
+	_NSIG       = 65
+)
+
+type mOS struct {
+	waitsema uint32 // semaphore for parking on locks
+}
+
+// sigset is the kernel's signal mask: signal n is bit n-1. The C
+// library's sigset_t, which holds it in its first word, is csigset.
+type sigset uint64
+
+var sigset_all = ^sigset(0)
+
+//go:nosplit
+//go:nowritebarrierrec
+func sigaddset(mask *sigset, i int) {
+	*mask |= 1 << (uint32(i) - 1)
+}
+
+func sigdelset(mask *sigset, i int) {
+	*mask &^= 1 << (uint32(i) - 1)
+}
+
+// futexsleep sleeps while *addr holds val, for at most ns nanoseconds
+// if ns is not negative. It may wake early, as a futex wait does.
+//
+//go:nosplit
+func futexsleep(addr *uint32, val uint32, ns int64) {
+	var ts timespec
+	var tsp *timespec
+	if ns >= 0 {
+		ts.setNsec(ns)
+		tsp = &ts
+	}
+	futex(unsafe.Pointer(addr), _FUTEX_WAIT_PRIVATE, val, unsafe.Pointer(tsp), nil)
+}
+
+// futexwakeup wakes at most cnt of the threads sleeping on addr.
+//
+//go:nosplit
+func futexwakeup(addr *uint32, cnt uint32) {
+	ret := futex(unsafe.Pointer(addr), _FUTEX_WAKE_PRIVATE, cnt, nil, nil)
+	if ret >= 0 {
+		return
+	}
+
+	// futexwakeup can be called on a signal stack.
+	systemstack(func() {
+		print("futexwakeup addr=", addr, " returned ", ret, "\n")
+	})
+	*(*int32)(unsafe.Pointer(uintptr(0x1006))) = 0x1006
+}
+
+// cpuSetSize is the size of the CPU set getCPUCount asks for: as many
+// CPUs as glibc's cpu_set_t holds.
+const cpuSetSize = 1024 / 8
+
+func getCPUCount() int32 {
+	// The CPUs the process may run on, as on Linux, which a CPU set
+	// can make fewer than the machine has.
+	var set [cpuSetSize]byte
+	if sched_getaffinity(0, uintptr(len(set)), &set[0]) == 0 {
+		n := int32(0)
+		for _, v := range set {
+			for v != 0 {
+				n += int32(v & 1)
+				v >>= 1
+			}
+		}
+		if n > 0 {
+			return n
+		}
+	}
+	if n := sysconf(_SC_NPROCESSORS_ONLN); n > 0 {
+		return int32(n)
+	}
+	return 1
+}
+
+// mstart_stub provides glue code to call mstart from pthread_create.
+func mstart_stub()
+
+// May run with m.p==nil, so write barriers are not allowed.
+//
+//go:nowritebarrierrec
+func newosproc(mp *m) {
+	if false {
+		print("newosproc m=", mp, " g=", mp.g0, " id=", mp.id, " ostk=", &mp, "\n")
+	}
+
+	// Initialize an attribute object.
+	var attr pthreadattr
+	if err := pthread_attr_init(&attr); err != 0 {
+		writeErrStr(failthreadcreate)
+		exit(1)
+	}
+
+	// Find out OS stack size for our own stack guard.
+	var stacksize uintptr
+	if pthread_attr_getstacksize(&attr, &stacksize) != 0 {
+		writeErrStr(failthreadcreate)
+		exit(1)
+	}
+	mp.g0.stack.hi = stacksize // for mstart
+
+	// Tell the pthread library we won't join with this thread.
+	if pthread_attr_setdetachstate(&attr, _PTHREAD_CREATE_DETACHED) != 0 {
+		writeErrStr(failthreadcreate)
+		exit(1)
+	}
+
+	// Finally, create the thread. It starts at mstart_stub, which does some low-level
+	// setup and then calls mstart.
+	var oset sigset
+	sigprocmask(_SIG_SETMASK, &sigset_all, &oset)
+	err := retryOnEAGAIN(func() int32 {
+		return pthread_create(&attr, abi.FuncPCABI0(mstart_stub), unsafe.Pointer(mp))
+	})
+	sigprocmask(_SIG_SETMASK, &oset, nil)
+	if err != 0 {
+		writeErrStr(failthreadcreate)
+		exit(1)
+	}
+
+	pthread_attr_destroy(&attr)
+}
+
+//go:nowritebarrierrec
+//go:nosplit
+func newosproc0(stacksize uintptr, fn unsafe.Pointer) {
+	throw("bad newosproc0")
+}
+
+func sysargs(argc int32, argv **byte) {
+	n := argc + 1
+
+	// skip over argv, envp to get to auxv
+	for argv_index(argv, n) != nil {
+		n++
+	}
+
+	// skip NULL separator
+	n++
+
+	// now argv+n is auxv
+	auxvp := (*[1 << 28]uintptr)(add(unsafe.Pointer(argv), uintptr(n)*goarch.PtrSize))
+	pairs := sysauxv(auxvp[:])
+	auxv = auxvp[: pairs*2 : pairs*2]
+}
+
+// secureMode holds the value of AT_SECURE passed in the auxiliary vector.
+var secureMode bool
+
+func initSecureMode() {
+	// sysargs has set secureMode.
+}
+
+func isSecureMode() bool {
+	return secureMode
+}
+
+func sysauxv(auxv []uintptr) (pairs int) {
+	// The auxiliary vector entries the kernel gives the program, with
+	// Linux's numbers.
+	var i int
+	for ; auxv[i] != _AT_NULL; i += 2 {
+		tag, val := auxv[i], auxv[i+1]
+		switch tag {
+		case _AT_RANDOM:
+			// 16 random bytes from the kernel.
+			startupRand = (*[16]byte)(unsafe.Pointer(val))[:]
+
+		case _AT_PAGESZ:
+			physPageSize = val
+
+		case _AT_SECURE:
+			secureMode = val == 1
+
+		case _AT_EXECFN:
+			// The path the program was run as, kept on the initial
+			// stack for the program's life.
+			executablePath = gostringnocopy((*byte)(unsafe.Pointer(val)))
+		}
+	}
+	return i / 2
+}
+
+// executablePath is the path the program was run as, from AT_EXECFN:
+// Radix has no /proc/self/exe. os.Executable makes it absolute.
+//
+//go:linkname executablePath os.executablePath
+var executablePath string
+
+func osinit() {
+	numCPUStartup = getCPUCount()
+}
+
+var urandom_dev = []byte("/dev/urandom\x00")
+
+func readRandom(r []byte) int {
+	// The kernel gives every program AT_RANDOM, which populates
+	// startupRand, so this fallback should be unreachable.
+	fd := open(&urandom_dev[0], 0 /* O_RDONLY */, 0)
+	n := read(fd, unsafe.Pointer(&r[0]), int32(len(r)))
+	closefd(fd)
+	return int(n)
+}
+
+func goenvs() {
+	goenvs_unix()
+}
+
+// Called to do synchronous initialization of Go code built with
+// -buildmode=c-archive or -buildmode=c-shared, which Radix does not have.
+//
+//go:nosplit
+//go:nowritebarrierrec
+func libpreinit() {}
+
+// Called to initialize a new m (including the bootstrap m).
+// Called on the parent thread (main thread in case of bootstrap), can allocate memory.
+func mpreinit(mp *m) {
+	mp.gsignal = malg(32 * 1024)
+	mp.gsignal.m = mp
+}
+
+// Called to initialize a new m (including the bootstrap m).
+// Called on the new thread, cannot allocate memory.
+func minit() {
+	// The thread's id, which signalM sends preemption signals to and
+	// debuggers show.
+	getg().m.procid = uint64(gettid())
+	minitSignals()
+}
+
+// Called from dropm to undo the effect of an minit.
+//
+//go:nosplit
+func unminit() {
+	unminitSignals()
+	getg().m.procid = 0
+}
+
+// Called from mexit, but not from dropm, to undo the effect of thread-owned
+// resources in minit, semacreate, or elsewhere. Do not take locks after calling this.
+//
+// This always runs without a P, so //go:nowritebarrierrec is required.
+//
+//go:nowritebarrierrec
+func mdestroy(mp *m) {
+}
+
+func sigtramp()
+
+//go:nosplit
+//go:nowritebarrierrec
+func setsig(i uint32, fn uintptr) {
+	var sa sigactiont
+	sa.sa_flags = _SA_SIGINFO | _SA_ONSTACK | _SA_RESTART
+	sa.sa_mask.__sig[0] = uint64(sigset_all)
+	if fn == abi.FuncPCABIInternal(sighandler) { // abi.FuncPCABIInternal(sighandler) matches the callers in signal_unix.go
+		fn = abi.FuncPCABI0(sigtramp)
+	}
+	sa.sa_handler = fn
+	sigaction(i, &sa, nil)
+}
+
+// setsigstack makes the handler of signal i, which is not the
+// runtime's, run on the signal stack: the C library's handlers of its
+// own signals, SIGCANCEL and SIGTIMER, may run on a goroutine's thread.
+//
+//go:nosplit
+//go:nowritebarrierrec
+func setsigstack(i uint32) {
+	var sa sigactiont
+	sigaction(i, nil, &sa)
+	if sa.sa_flags&_SA_ONSTACK != 0 {
+		return
+	}
+	sa.sa_flags |= _SA_ONSTACK
+	sigaction(i, &sa, nil)
+}
+
+//go:nosplit
+//go:nowritebarrierrec
+func getsig(i uint32) uintptr {
+	var sa sigactiont
+	sigaction(i, nil, &sa)
+	return sa.sa_handler
+}
