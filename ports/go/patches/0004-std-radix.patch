@@ -0,0 +1,32 @@
+// Copyright 2026 The Dukovo contributors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package os
+
+import _ "unsafe" // for linkname
+
+// executablePath is the path the program was run as. The kernel gives it
+// in the auxiliary vector, as Radix has no /proc/self/exe.
+//
+//go:linkname executablePath
+var executablePath string // set by sysauxv in ../runtime/os_radix.go
+
+var initCwd, initCwdErr = Getwd()
+
+func executable() (string, error) {
+	path := executablePath
+	if len(path) == 0 {
+		return "", ErrNotExist
+	}
+	if path[0] == '/' {
+		return path, nil
+	}
+	if initCwdErr != nil {
+		return "", initCwdErr
+	}
+	if len(path) > 2 && path[0:2] == "./" {
+		path = path[2:]
+	}
+	return initCwd + "/" + path, nil
+}
