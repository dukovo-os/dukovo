+// Copyright 2026 The Dukovo contributors. All rights reserved.
+// Use of this source code is governed by a BSD-style
+// license that can be found in the LICENSE file.
+
+package unix
+
+import (
+	"syscall"
+	"unsafe"
+)
+
+const P_PID = 1
+
+// SiginfoChild is the siginfo_t that waitid fills in for a child: the C
+// library's, Linux's 128 bytes.
+type SiginfoChild struct {
+	Signo  int32
+	Errno  int32
+	Code   int32
+	_      int32
+	Pid    int32
+	Uid    uint32
+	Status int32
+	_      [128 - 7*4]byte
+}
+
+// Waitid calls the C library's waitid, which takes no rusage: one asked
+// for is refused with EINVAL.
+func Waitid(idType int, id int, info *SiginfoChild, options int, rusage *syscall.Rusage) error {
+	if rusage != nil {
+		return syscall.EINVAL
+	}
+	return waitid(idType, id, unsafe.Pointer(info), options)
+}
+
+//go:linkname waitid syscall.waitid
+func waitid(idtype int, id int, info unsafe.Pointer, options int) error
