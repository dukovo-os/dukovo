-//go:build !windows && !js && !wasip1 && !darwin
-// +build !windows,!js,!wasip1,!darwin
+//go:build !windows && !js && !wasip1 && !darwin && !radix
+// +build !windows,!js,!wasip1,!darwin,!radix
 
