Radix has no /proc, where the process collector reads a process's
figures, so it is unsupported there, as on js, wasip1 and iOS.

diff -ruN a/github.com_prometheus_client_golang@v1.24.1/prometheus/process_collector_not_supported.go b/github.com_prometheus_client_golang@v1.24.1/prometheus/process_collector_not_supported.go
--- a/github.com_prometheus_client_golang@v1.24.1/prometheus/process_collector_not_supported.go
+++ b/github.com_prometheus_client_golang@v1.24.1/prometheus/process_collector_not_supported.go
@@ -11,8 +11,8 @@
 // See the License for the specific language governing permissions and
 // limitations under the License.
 
-//go:build wasip1 || js || ios
-// +build wasip1 js ios
+//go:build wasip1 || js || ios || radix
+// +build wasip1 js ios radix
 
 package prometheus
 
diff -ruN a/github.com_prometheus_client_golang@v1.24.1/prometheus/process_collector_procfsenabled.go b/github.com_prometheus_client_golang@v1.24.1/prometheus/process_collector_procfsenabled.go
--- a/github.com_prometheus_client_golang@v1.24.1/prometheus/process_collector_procfsenabled.go
+++ b/github.com_prometheus_client_golang@v1.24.1/prometheus/process_collector_procfsenabled.go
@@ -11,8 +11,8 @@
