Radix's terminals take Linux's TCGETS and TCSETS: constants_linux.go
is Linux's alone by its name, so constants_radix.go gives them.

diff -ruN a/github.com_muesli_termenv@v0.16.0/constants_radix.go b/github.com_muesli_termenv@v0.16.0/constants_radix.go
--- a/github.com_muesli_termenv@v0.16.0/constants_radix.go
+++ b/github.com_muesli_termenv@v0.16.0/constants_radix.go
@@ -0,0 +1,8 @@
+package termenv
+
+import "golang.org/x/sys/unix"
+
+const (
+	tcgetattr = unix.TCGETS
+	tcsetattr = unix.TCSETS
+)
