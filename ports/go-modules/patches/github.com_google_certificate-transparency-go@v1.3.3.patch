+// license that can be found in the LICENSE file.
+
+package x509
+
+import (
+	"os"
+)
+
+// Radix keeps its roots in one file of PEM certificates and has no folder of
+// them. This file takes the place of root_unix.go, whose certDirectories name
+// Linux and BSD locations.
+var certFiles = []string{
+	"/system/resources/certificates/ca-certificates.crt",
+}
+
+func (c *Certificate) systemVerify(opts *VerifyOptions) (chains [][]*Certificate, err error) {
+	return nil, nil
+}
+
+func loadSystemRoots() (*CertPool, error) {
+	roots := NewCertPool()
+	var bestErr error
+	for _, file := range certFiles {
+		data, err := os.ReadFile(file)
+		if err == nil {
+			roots.AppendCertsFromPEM(data)
+			return roots, nil
+		}
+		if bestErr == nil || (os.IsNotExist(bestErr) && !os.IsNotExist(err)) {
+			bestErr = err
+		}
+	}
+	if bestErr == nil {
+		return roots, nil
+	}
+	return nil, bestErr
+}
