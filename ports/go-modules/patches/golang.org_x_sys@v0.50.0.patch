+func Getwd() (string, error) {
+	var buf [PathMax]byte
+	if err := getcwd(buf[0:]); err != nil {
+		return "", err
+	}
+	n := clen(buf[:])
+	if n < 1 || buf[0] != '/' {
+		return "", EINVAL
+	}
+	return string(buf[:n]), nil
+}
+
+//sys	getcwd(buf []byte) (err error)
