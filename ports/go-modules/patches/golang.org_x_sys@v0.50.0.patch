+func Utimes(path string, tv []Timeval) error {
+	if tv == nil {
+		return utimensat(AT_FDCWD, path, nil, 0)
+	}
+	if len(tv) != 2 {
+		return EINVAL
+	}
+	ts := [2]Timespec{
+		NsecToTimespec(TimevalToNsec(tv[0])),
+		NsecToTimespec(TimevalToNsec(tv[1])),
+	}
+	return utimensat(AT_FDCWD, path, &ts, 0)
+}
