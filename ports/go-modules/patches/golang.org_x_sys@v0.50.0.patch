+func Gettimeofday(tv *Timeval) (err error) {
+	return gettimeofday(tv, nil)
+}
+
+//sysnb	gettimeofday(tv *Timeval, tz unsafe.Pointer) (err error)
+
+func Time(t *Time_t) (Time_t, error) {
+	var tv Timeval
+	if err := Gettimeofday(&tv); err != nil {
+		return 0, err
+	}
+	if t != nil {
+		*t = Time_t(tv.Sec)
+	}
+	return Time_t(tv.Sec), nil
+}
