+func Getcwd(buf []byte) (n int, err error) {
+	if err = getcwd(buf); err != nil {
+		return 0, err
+	}
+	n = clen(buf)
+	if n < 1 {
+		return 0, EINVAL
+	}
+	return n, nil
+}
