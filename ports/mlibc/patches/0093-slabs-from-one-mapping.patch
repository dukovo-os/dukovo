+// Slabs never go back to the system: the pool unmaps only blocks too
+// large for a slab. So a slab need not be a mapping of its own, and it
+// is cut from a chunk of eight: a program that uses five sizes of object
+// makes one mmap where it made five, and the kernel keeps one region for
+// them where it kept five.
+//
+// _slabs holds the next slab's address and, in the low bits the slabs'
+// alignment leaves clear, how many the chunk has left. Taking one is a
+// compare-and-swap, so a fork never finds a lock here held by a thread
+// the child does not have.
+uintptr_t VirtualAllocator::map_slab(size_t length, size_t align) {
+	constexpr size_t slabsPerChunk = 8;
+	__ensure(align > slabsPerChunk && !(align & (align - 1)));
+	__ensure(length && !(length & (align - 1)));
+	const uintptr_t left = align - 1;
+
+	auto word = __atomic_load_n(&_slabs, __ATOMIC_ACQUIRE);
+	while(word & left) {
+		auto slab = word & ~left;
+		auto next = (slab + length) | ((word & left) - 1);
+		if(__atomic_compare_exchange_n(&_slabs, &word, next, true,
+				__ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE))
+			return slab;
+	}
+
+	// The chunk is used up: map the next, with room to align it.
+	size_t reservation = slabsPerChunk * length + align;
+	auto base = map(reservation);
+	if(!base)
+		return 0;
+	auto slab = (base + align - 1) & ~left;
+	auto rest = slab + length;
+	auto count = (base + reservation - rest) / length;
+	if(!__atomic_compare_exchange_n(&_slabs, &word, rest | count, false,
+			__ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE)) {
+		// Another thread put in a chunk meanwhile: this one gives back
+		// all but its first slab.
+		unmap(rest, base + reservation - rest);
+	}
+	return slab;
+}
