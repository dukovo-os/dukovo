+// Calls the handlers that `matches`, the newest first, of those
+// registered when it was called: a handler registered by one that runs
+// is not called by this loop.
+template<typename Matches>
+void runExitHandlers(Matches matches) {
+	ExitBlock *block;
+	size_t used;
+	{
+		frg::unique_lock guard{exitLock};
+		block = newestExitBlock;
+		used = block->used;
+	}
+	// Every block but the newest is full, and none moves or goes away.
+	while (block) {
+		for (size_t i = used; i > 0; i--) {
+			auto &handler = block->handlers[i - 1];
+			if (!handler.function)
+				continue;
