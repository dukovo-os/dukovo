index 0000000..d71e22e
--- /dev/null
+++ b/options/glibc/include/bits/glibc/glibc_unistd.h
@@ -0,0 +1,26 @@
+#ifndef _MLIBC_GLIBC_UNISTD_H
+#define _MLIBC_GLIBC_UNISTD_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#ifndef __MLIBC_ABI_ONLY
+
+#if defined(_GNU_SOURCE)
+
+/* The flags of close_range, as Linux's <linux/close_range.h> has them. */
+#define CLOSE_RANGE_UNSHARE (1U << 1)
+#define CLOSE_RANGE_CLOEXEC (1U << 2)
+
+int close_range(unsigned int __first, unsigned int __last, int __flags);
+
+#endif
+
+#endif /* !__MLIBC_ABI_ONLY */
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* _MLIBC_GLIBC_UNISTD_H */
