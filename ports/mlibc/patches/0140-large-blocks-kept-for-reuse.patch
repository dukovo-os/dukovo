+// A block too large for a slab is a mapping of its own, and a program
+// that allocates and frees one per request would map, fault in and
+// unmap it every time: glibc keeps such blocks in its heap and does not.
+// So freed mappings wait in a cache, and the next block that needs a
+// mapping of the same length takes one without a system call or a page
+// fault.
+//
+// glibc keeps freed blocks of up to 32 MiB, as its mmap threshold grows
+// with them; this cache keeps less, to bound what an idle process holds.
+// A mapping is the block, a page for its header and the 256 KiB frigg
+// aligns it in, so the longest length kept is 4 MiB plus those. The
+// bytes kept in all are limited too, and an allocation looks through
+// no more than the 16 slots.
+constexpr size_t cachedLengthMax = (4 << 20) + (256 << 10) + 4096;
+constexpr size_t cachedBytesMax = 16 << 20;
+constexpr size_t cachePage = 4096;
+static_assert(cachedLengthMax / cachePage < (size_t(1) << 20),
+		"A cached length is a page count that fits 20 bits");
+
+// A slot holds 0 or one mapping: its base's page number above 20 bits
+// and its length in pages below. Like _slabs, the slots are taken and
+// filled by compare-and-swap, so a fork never finds a lock here held by
+// a thread the child does not have. The memory is not cleared: malloc
+// owes the caller nothing, and calloc clears what it returns.
+//
+// A thread puts a mapping in with release and another takes it with
+// acquire, so that every write the putter made to the block happens
+// before the taker's own, and none lands in what the taker now uses.
+// The byte count is only a limit and needs no order.
+uintptr_t VirtualAllocator::map_large(size_t length) {
+	__ensure(!(length & (cachePage - 1)));
+	const uint64_t pages = length / cachePage;
+	for(auto &slot : _cachedBlocks) {
+		auto word = __atomic_load_n(&slot, __ATOMIC_RELAXED);
+		if(!word || (word & ((uint64_t(1) << 20) - 1)) != pages)
+			continue;
+		if(__atomic_compare_exchange_n(&slot, &word, 0, false,
+				__ATOMIC_ACQUIRE, __ATOMIC_RELAXED)) {
+			__atomic_fetch_sub(&_cachedBytes, length, __ATOMIC_RELAXED);
+			return (word >> 20) << 12;
+		}
+	}
+	return map(length);
+}
+
+void VirtualAllocator::unmap_large(uintptr_t address, size_t length) {
+	__ensure(!((address | length) & (cachePage - 1)));
+	if(length > cachedLengthMax || (address >> 12) >= (uint64_t(1) << 44)) {
+		unmap(address, length);
+		return;
+	}
+	auto total = __atomic_add_fetch(&_cachedBytes, length, __ATOMIC_RELAXED);
+	if(total <= cachedBytesMax) {
+		uint64_t word = ((address >> 12) << 20) | (length / cachePage);
+		for(auto &slot : _cachedBlocks) {
+			uint64_t empty = 0;
+			if(!__atomic_load_n(&slot, __ATOMIC_RELAXED)
+					&& __atomic_compare_exchange_n(&slot, &empty, word, false,
+						__ATOMIC_RELEASE, __ATOMIC_RELAXED))
+				return;
+		}
+	}
+	__atomic_fetch_sub(&_cachedBytes, length, __ATOMIC_RELAXED);
+	unmap(address, length);
+}
+
