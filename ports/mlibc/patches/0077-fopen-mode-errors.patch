A stream mode that does not start with 'r', 'w' or 'a' fails with EINVAL,
as in glibc, for fopen, fdopen, freopen, fmemopen and fopencookie.
parse_modestring logged "Illegal fopen() mode" and went on with flags of
0, so fopen(path, "\xc2\x80") opened the file for reading, and an empty
mode too. parse_modestring now returns -1 for a mode that is none, and
its callers fail before they open anything. Characters after the first
that are not known are ignored without a log line, as glibc ignores them.
Meant for upstream.

diff --git a/options/ansi/generic/file-io.cpp b/options/ansi/generic/file-io.cpp
index 8f0fb9c..94fdaa5 100644
--- a/options/ansi/generic/file-io.cpp
+++ b/options/ansi/generic/file-io.cpp
@@ -521,6 +521,8 @@ int fd_file::reopen(const char *path, const char *mode) {
 	flush();
 
 	int mode_flags = parse_modestring(mode);
+	if (mode_flags < 0)
+		return EINVAL;
 	const char *reopen_path = path;
 
 	if (!path) {
@@ -621,6 +623,10 @@ int fd_file::io_seek(off_t offset, int whence, off_t *new_offset) {
 	return 0;
 }
 
+// The open flags a stream mode names, or -1 if it is no mode: its first
+// character must be 'r', 'w' or 'a', which glibc's fopen fails with EINVAL
+// for. Characters after it that are not known are ignored, as glibc
+// ignores them.
 int fd_file::parse_modestring(const char *mode) {
 	// Consume the first char; this must be 'r', 'w' or 'a'.
 	int flags = 0;
@@ -646,7 +652,7 @@ int fd_file::parse_modestring(const char *mode) {
 		}
 		flags |= O_CREAT;
 	} else {
-		mlibc::infoLogger() << "Illegal fopen() mode '" << *mode << "'" << frg::endlog;
+		return -1;
 	}
 	mode += 1;
 
@@ -663,7 +669,6 @@ int fd_file::parse_modestring(const char *mode) {
 			flags |= O_EXCL;
 			mode++;
 		} else {
-			mlibc::infoLogger() << "Illegal fopen() flag '" << mode << "'" << frg::endlog;
 			mode++;
 		}
 	}
@@ -730,6 +735,10 @@ int fileno(FILE *file_base) {
 
 FILE *fopen(const char *path, const char *mode) {
 	int flags = mlibc::fd_file::parse_modestring(mode);
+	if(flags < 0) {
+		errno = EINVAL;
+		return nullptr;
+	}
 
 	int fd;
 	if(int e = mlibc::sysdep<Open>(path, flags, 0666, &fd); e) {
