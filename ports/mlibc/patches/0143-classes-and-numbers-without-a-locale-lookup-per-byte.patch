 template<typename Char> Char widen(char c) { return static_cast<Char>(c); }
 
+// The value of c as a digit, 0 to 35, by the digits and the letters of
+// ASCII, which C ascribes 10 to 35 to; 36 for any other character. A
+// character a locale counts as a digit or a letter beyond ASCII was
+// worth 36 or more as before, and ended a number in any base, as it does
+// in glibc.
+template<typename Char>
+unsigned int digitValue(Char c) {
+	if(c >= widen<Char>('0') && c <= widen<Char>('9'))
+		return c - widen<Char>('0');
+	if(c >= widen<Char>('a') && c <= widen<Char>('z'))
+		return c - widen<Char>('a') + 10;
+	if(c >= widen<Char>('A') && c <= widen<Char>('Z'))
+		return c - widen<Char>('A') + 10;
+	return 36;
+}
