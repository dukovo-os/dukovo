 #include <stdint.h>
 
+#include <mlibc/charcode.hpp>
+#include <mlibc/charset.hpp>
 #include <mlibc/locale.hpp>
 
 namespace mlibc {
 
+// Whether the byte nc is in the class `is` tests, by the locale l, as
+// isalpha(3) and the rest answer. A byte up to 0x7F is its own code point
+// in each character code mlibc has (each preserves 7-bit units), so it
+// is classed at once, without current_charcode(), which compares the
+// locale's codeset name with "ANSI_X3.4-1968" on every call; any other
+// byte is decoded by the locale's character code first, as before.
+template<bool (charset::*is)(codepoint, localeinfo *)>
+int byte_in_class(int nc, localeinfo *l) {
+	auto uc = static_cast<unsigned char>(nc);
+	if(uc <= 0x7F)
+		return (current_charset()->*is)(uc, l);
+	codepoint cp;
+	if(auto e = current_charcode()->promote(nc, cp); e != transcode_status::input_exhausted)
+		return 0;
+	return (current_charset()->*is)(cp, l);
+}
+
 int isalpha_l(int c, localeinfo *l);
 int isdigit_l(int c, localeinfo *l);
 int isspace_l(int c, localeinfo *l);
