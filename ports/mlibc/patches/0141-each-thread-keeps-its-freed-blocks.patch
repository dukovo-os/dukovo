+// Links `block` in at the head of its bucket's list.
+inline void pushBlock(ThreadCache &cache, CachedBlock *block, unsigned int bucket) {
+	block->link = reinterpret_cast<uintptr_t>(cache.heads[bucket])
+			^ (reinterpret_cast<uintptr_t>(block) >> 12) ^ cache.secret;
+	block->key = cache.key;
+	cache.heads[bucket] = block;
+	cache.counts[bucket]++;
+}
+
+// Takes a batch of blocks of `bucket` from the pool when the cache has
+// none: returns one of them, and keeps the rest. Returns nullptr when the
+// cache is closed, for malloc to take its block from the pool itself.
+[[gnu::noinline]] void *refillCache(ThreadCache &cache, unsigned int bucket) {
+	if(cache.state != CacheState::open && !openCache(cache))
+		return nullptr;
