+template<typename Policy, typename Mutex>
+void slab_pool<Policy, Mutex>::free_batch(int index, void *const *blocks, size_t count) {
+	FRG_ASSERT(index >= 0 && index < policy_traits::num_buckets);
+	if(enable_checking)
+		_verify_integrity();
+
+	size_t item_size = policy_traits::bucket_to_size(index);
+	for(size_t i = 0; i < count; i++) {
+		slab::trace(_plcy, 'f', blocks[i], 0);
+		if constexpr (slab::has_poisoning_support<Policy>) {
+			_plcy.unpoison_expand(blocks[i], item_size);
+			_plcy.poison(blocks[i], item_size);
+			_plcy.unpoison(blocks[i], sizeof(freelist));
+		}
+	}
+
+	// As free_in_slab_(), for each block, under one hold of the lock.
+	auto bkt = &_bkts[index];
+	unique_lock<Mutex> bucket_guard(bkt->bucket_mutex);
+	for(size_t i = 0; i < count; i++) {
+		auto address = reinterpret_cast<uintptr_t>(blocks[i]);
+		auto slb = static_cast<slab_frame *>(
+				reinterpret_cast<frame *>((address - 1) & ~(sb_size - 1)));
+		FRG_ASSERT(slb->type == frame_type::slab && slb->index == index);
+		FRG_ASSERT(slb->contains(blocks[i]));
+		FRG_ASSERT(!enable_checking || !((address - slb->address) % item_size));
