+void mlibc::thread_cache_close() {
+	if(!mlibc::tcb_available_flag)
+		return;
+	auto &cache = threadCache;
+	cache.state = CacheState::closed;
+	for(unsigned int bucket = cacheFirst; bucket <= cacheLast; bucket++) {
+		if(cache.counts[bucket])
+			releaseBlocks(cache, cache.heads[bucket], bucket, cache.counts[bucket]);
+		cache.heads[bucket] = nullptr;
+		cache.counts[bucket] = 0;
+	}
+}
