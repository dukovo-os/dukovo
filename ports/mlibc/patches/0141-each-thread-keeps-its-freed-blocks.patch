+	return blocks[0];
+}
+
+// Unlinks the `count` blocks from `block` on, which end the list, and
+// gives them back to the pool.
+void releaseBlocks(const ThreadCache &cache, CachedBlock *block,
+		unsigned int bucket, unsigned int count) {
+	void *blocks[cacheLimit(1)];
+	static_assert(cacheLimit(1) >= cacheLimit(cacheLast));
+	for(unsigned int i = 0; i < count; i++) {
+		// The pool writes its own link over the block's.
+		auto next = followLink(cache, block, bucket, i + 1 < count);
+		block->key = 0;
+		blocks[i] = block;
+		block = next;
+	}
+	getAllocator().free_batch(bucket, blocks, count);
+}
+
+// Gives the oldest half of a full bucket back to the pool, and keeps the
+// half freed last, likelier to be in the CPU's cache.
+[[gnu::noinline]] void spillCache(ThreadCache &cache, unsigned int bucket) {
+	unsigned int keep = cacheLimit(bucket) - cacheBatch(bucket);
+	auto last = cache.heads[bucket];
+	for(unsigned int i = 1; i < keep; i++)
+		last = followLink(cache, last, bucket, true);
+	auto rest = followLink(cache, last, bucket, true);
+	last->link = (reinterpret_cast<uintptr_t>(last) >> 12) ^ cache.secret;
+	releaseBlocks(cache, rest, bucket, cache.counts[bucket] - keep);
+	cache.counts[bucket] = keep;
+}
+
+// A block of `size` bytes from the calling thread's cache, or nullptr
+// when the pool has to give it.
+inline void *cacheTake(size_t size) {
+	if(!mlibc::tcb_available_flag || size > cacheMaxSize)
+		return nullptr;
+	auto &cache = threadCache;
+	auto bucket = cacheBucket(size);
+	unsigned int count = cache.counts[bucket];
+	if(!count)
+		return refillCache(cache, bucket);
+	auto block = cache.heads[bucket];
+	cache.heads[bucket] = followLink(cache, block, bucket, count > 1);
+	cache.counts[bucket] = count - 1;
+	block->key = 0;
+	return block;
+}
+
+// Keeps the block at `pointer` in the calling thread's cache, or returns
+// false when the block is too large or too small for it or the cache is
+// closed.
+inline bool cachePut(void *pointer) {
+	if(!mlibc::tcb_available_flag || !pointer)
+		return false;
+	auto &cache = threadCache;
+	if(cache.state != CacheState::open && !openCache(cache))
+		return false;
+	int index = MemoryPool::bucket_of(pointer);
+	if(index < static_cast<int>(cacheFirst) || index > static_cast<int>(cacheLast))
+		return false;
+	auto bucket = static_cast<unsigned int>(index);
+	auto block = static_cast<CachedBlock *>(pointer);
+	if(block->key == cache.key) [[unlikely]]
+		checkNotCached(cache, block, bucket);
+	if(cache.counts[bucket] >= cacheLimit(bucket)) [[unlikely]]
+		spillCache(cache, bucket);
+	pushBlock(cache, block, bucket);
+	return true;
+}
