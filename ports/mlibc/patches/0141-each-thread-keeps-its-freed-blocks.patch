 template<typename Policy, typename Mutex>
+size_t slab_pool<Policy, Mutex>::allocate_batch(int index, void **out, size_t count) {
+	FRG_ASSERT(index >= 0 && index < policy_traits::num_buckets);
+	if(enable_checking)
+		_verify_integrity();
+
+	size_t item_size = policy_traits::bucket_to_size(index);
+	auto bkt = &_bkts[index];
+	size_t taken = 0;
+	unique_lock<Mutex> bucket_guard(bkt->bucket_mutex);
+	while(taken < count) {
+		auto slb = bkt->head_slb;
+		if(!slb) {
+			// As allocate(): call into the Policy without holding locks.
+			bucket_guard.unlock();
+
+			slb = _construct_slab(index);
+			if(!slb)
+				return taken;
+
+			unique_lock<Mutex> tree_guard(_tree_mutex);
+#ifdef FRG_SLAB_TRACK_REGIONS
+			_frame_tree.insert(slb);
+#endif
+			_usedPages += (slb->length + huge_padding) / page_size;
+			tree_guard.unlock();
+
+			bucket_guard.lock();
+			bkt->partial_tree.insert(slb);
+			if(!bkt->head_slb || slb->address < bkt->head_slb->address)
+				bkt->head_slb = slb;
+			continue;
+		}
+
+		auto object = take_from_slab_(slb);
+		if(!has_room_(slb)) {
+			bkt->partial_tree.remove(slb);
+			bkt->head_slb = bkt->partial_tree.first();
+		}
+		object->~freelist();
+		if constexpr (slab::has_poisoning_support<Policy>) {
+			_plcy.poison(object, sizeof(freelist));
+			_plcy.unpoison(object, item_size);
+		}
+		out[taken++] = object;
+	}
+	bucket_guard.unlock();
+
+	for(size_t i = 0; i < taken; i++)
+		slab::trace(_plcy, 'a', out[i], item_size);
+	if(enable_checking)
+		_verify_integrity();
+	return taken;
+}
