+		object->link = slb->available;
+		slb->available = object;
+
+		if(reinsert_into_bucket) {
+			bkt->partial_tree.insert(slb);
+			if(!bkt->head_slb || slb->address < bkt->head_slb->address)
+				bkt->head_slb = slb;
+		}
+	}
+	bucket_guard.unlock();
+
+	if(enable_checking)
+		_verify_integrity();
+}
