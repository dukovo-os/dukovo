+// The block after `block` in its bucket's list, which goes on past it
+// when `more` is set, from the link the block holds.
+inline CachedBlock *followLink(const ThreadCache &cache, CachedBlock *block,
+		unsigned int bucket, bool more) {
+	auto next = block->link ^ (reinterpret_cast<uintptr_t>(block) >> 12) ^ cache.secret;
+	if(more ? (!next || (next & (cacheSize(bucket) - 1))) : next)
+		cacheCorrupted("a freed block was written to: its link to the next is not a block");
+	return reinterpret_cast<CachedBlock *>(next);
+}
+
+// Opens the calling thread's cache when it is first used; returns
+// whether it is open.
+[[gnu::noinline]] bool openCache(ThreadCache &cache) {
+	if(cache.state == CacheState::closed)
+		return false;
+	if(mlibc::globalConfig().debugMalloc) {
+		cache.state = CacheState::closed;
+		return false;
+	}
+	cache.secret = processWord(&processSecret);
+	cache.key = processWord(&processKey);
+	cache.state = CacheState::open;
+	return true;
+}
+
+// A free found the key in a block: it is in this cache, a double free,
+// or in another thread's, or the program wrote the key there by chance.
+[[gnu::noinline, gnu::cold]] void checkNotCached(const ThreadCache &cache,
+		CachedBlock *block, unsigned int bucket) {
+	auto entry = cache.heads[bucket];
+	for(unsigned int left = cache.counts[bucket]; left; left--) {
+		if(entry == block)
+			cacheCorrupted("free(): double free detected");
+		entry = followLink(cache, entry, bucket, left > 1);
