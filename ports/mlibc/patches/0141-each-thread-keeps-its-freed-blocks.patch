+
+uintptr_t processWord(uintptr_t *word) {
+	auto value = __atomic_load_n(word, __ATOMIC_ACQUIRE);
+	if(value)
+		return value;
+	uintptr_t chosen;
+	if(mlibc::sysdep_or_enosys<GetEntropy>(&chosen, sizeof(chosen))) {
+		// A process with no randomness mixes where its stack, its TLS and
+		// the word are, which its address space's layout varies.
+		chosen = mixBits(reinterpret_cast<uintptr_t>(&chosen)
+				^ mixBits(reinterpret_cast<uintptr_t>(&threadCache))
+				^ mixBits(reinterpret_cast<uintptr_t>(word)));
+	}
+	// Zero is "not chosen yet".
+	if(!chosen)
+		chosen = 1;
+	if(__atomic_compare_exchange_n(word, &value, chosen, false,
+			__ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE))
+		return chosen;
+	return value;
