+	//--------------------------------------------------------------------------------------
+	// Large blocks kept after free().
+	//--------------------------------------------------------------------------------------
+
+	// A program that allocates a large block, frees it and allocates one
+	// of the size again, as one that draws a picture a frame does, would
+	// map the block, take a page fault for each of its pages and unmap
+	// it, every time. The pool keeps the last large blocks that were
+	// freed, mapped and with their pages, and hands one out again to a
+	// request it fits, as glibc's malloc does by serving from its heap
+	// what was once freed as a mapping of its own.
+	//
+	// At most kept_blocks blocks are kept, of kept_bytes in all; the one
+	// kept longest goes back to the system first. A block larger than
+	// that, or placed on an alignment above a page, is never kept.
+	static constexpr size_t kept_blocks = 4;
+	static constexpr size_t kept_bytes = size_t(16) << 20;
+
+	// Whether the block of `sup`, which is being freed, is one to keep.
+	bool keeps_(frame *sup) {
+		return sup->sb_reservation <= kept_bytes
+				&& sup->address == reinterpret_cast<uintptr_t>(sup) + huge_padding;
+	}
+
+	// Takes the kept block at `index` out of the kept ones. Called with
+	// _tree_mutex held.
+	frame *take_kept_(size_t index) {
+		FRG_ASSERT(index < _keptCount);
+		frame *fra = _kept[index];
+		for(size_t i = index + 1; i < _keptCount; i++)
+			_kept[i - 1] = _kept[i];
+		_keptCount--;
+		_keptBytes -= fra->sb_reservation;
+		return fra;
+	}
+
+	// The smallest kept block that holds `area_size` bytes with at most
+	// a quarter as much again left over, taken out of the kept ones, or
+	// nullptr. Called with _tree_mutex held.
+	frame *take_kept_for_(size_t area_size) {
+		size_t best = kept_blocks;
+		for(size_t i = 0; i < _keptCount; i++) {
+			size_t length = _kept[i]->length;
+			if(length < area_size || length - area_size > area_size / 4)
+				continue;
+			if(best == kept_blocks || length < _kept[best]->length)
+				best = i;
+		}
+		return best == kept_blocks ? nullptr : take_kept_(best);
 	}
 
