diff -ruN a/options/internal/include/mlibc/ctype.hpp b/options/internal/include/mlibc/ctype.hpp
--- a/options/internal/include/mlibc/ctype.hpp
+++ b/options/internal/include/mlibc/ctype.hpp
@@ -1,5 +1,7 @@
 #pragma once
 
+#include <stdint.h>
+
 #include <mlibc/locale.hpp>
 
 namespace mlibc {
@@ -10,6 +12,40 @@ int isspace_l(int c, localeinfo *l);
 int isxdigit_l(int c, localeinfo *l);
 
 int tolower_l(int c, localeinfo *l);
+int toupper_l(int c, localeinfo *l);
+
+// A locale's lowercase or uppercase of each byte and of EOF, as tolower(3)
+// and toupper(3) give them: LC_CTYPE's tables of 384 entries, for -128 to
+// 255. A caller that converts many bytes, as strcasecmp(3) does, fetches
+// the table once rather than looking up the locale for each byte. nullptr
+// when the locale's table is shorter, and then only ASCII letters change.
+inline const uint32_t *lower_table(localeinfo *l) {
+	auto table = l->ctype.map_tolower();
+	return table.size() >= 384 ? table.data() : nullptr;
+}
+
+inline const uint32_t *upper_table(localeinfo *l) {
+	auto table = l->ctype.map_toupper();
+	return table.size() >= 384 ? table.data() : nullptr;
+}
+
+// c in a table from lower_table: unchanged unless it is a byte or EOF.
+inline int lower_by(const uint32_t *table, int c) {
+	if(c < -128 || c > 255)
+		return c;
+	if(table)
+		return static_cast<int>(table[c + 128]);
+	return c >= 'A' && c <= 'Z' ? c - 'A' + 'a' : c;
+}
+
+// c in a table from upper_table: unchanged unless it is a byte or EOF.
+inline int upper_by(const uint32_t *table, int c) {
+	if(c < -128 || c > 255)
+		return c;
+	if(table)
+		return static_cast<int>(table[c + 128]);
+	return c >= 'a' && c <= 'z' ? c - 'a' + 'A' : c;
+}
 
 int iswascii(int nc);
 int iswspace_l(wint_t nc, localeinfo *l);
