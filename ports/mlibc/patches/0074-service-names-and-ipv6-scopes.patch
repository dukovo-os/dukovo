+// An IPv6 address, which may name its scope (RFC 4007) after a '%': an
+// interface's number, or for a link-local address its name, as glibc and
+// musl read it ("fe80::1%eth0"). False if it is not one.
+bool parse_ipv6(const char *name, uint8_t *addr, uint32_t *scope_id) {
+	const char *percent = strchr(name, '%');
+	*scope_id = 0;
+	if (!percent)
+		return inet_pton(AF_INET6, name, addr) > 0;
+	char text[INET6_ADDRSTRLEN];
+	size_t len = percent - name;
+	if (len >= sizeof(text))
+		return false;
+	memcpy(text, name, len);
+	text[len] = 0;
+	if (inet_pton(AF_INET6, text, addr) <= 0)
+		return false;
+	const char *zone = percent + 1;
+	if (!*zone)
+		return false;
+	char *end;
+	unsigned long number = strtoul(zone, &end, 10);
+	if (isdigit(static_cast<unsigned char>(*zone)) && !*end) {
+		if (number > UINT32_MAX)
+			return false;
+		*scope_id = static_cast<uint32_t>(number);
+		return true;
 	}
+	bool link_local = addr[0] == 0xfe && (addr[1] & 0xc0) == 0x80;
+	bool multicast_link_local = addr[0] == 0xff && (addr[1] & 0xf) == 2;
+	if (!link_local && !multicast_link_local)
+		return false;
+	*scope_id = if_nametoindex(zone);
+	return *scope_id != 0;
+}
 
