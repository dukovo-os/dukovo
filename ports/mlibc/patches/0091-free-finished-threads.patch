+// The values of a TCB's isJoinable: a thread that is detached, one that
+// may be joined, and one that exited while it still could be. Whoever
+// changes it last frees the TCB: the joiner, or for a detached thread
+// the next pthread_create.
+constexpr int thread_detached = 0;
+constexpr int thread_joinable = 1;
+constexpr int thread_exited_joinable = 2;
+
+// Detached threads that have exited or are exiting, linked by their
+// nextFinished, whose TCBs wait to be freed: a thread runs with its TCB
+// until its last instruction, so another frees it once its didExit is
+// set. Pushed and taken whole without a lock, which a fork could leave
+// held in the child.
+constinit Tcb *finished_threads = nullptr;
+
+void add_finished(Tcb *tcb) {
+	auto head = __atomic_load_n(&finished_threads, __ATOMIC_RELAXED);
+	do {
+		tcb->nextFinished = head;
+	} while (!__atomic_compare_exchange_n(&finished_threads, &head, tcb, true,
+			__ATOMIC_RELEASE, __ATOMIC_RELAXED));
+}
+
+// Frees the TCBs of the finished threads that have gone, and puts back
+// those still on their way out.
+void free_finished() {
+	auto tcb = __atomic_exchange_n(&finished_threads, nullptr, __ATOMIC_ACQUIRE);
+	while (tcb) {
+		auto next = tcb->nextFinished;
+		if (__atomic_load_n(&tcb->didExit, __ATOMIC_ACQUIRE))
+			__rtld_freeTcb(tcb);
+		else
+			add_finished(tcb);
+		tcb = next;
+	}
+}
