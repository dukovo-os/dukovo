+// Gives back what allocateTcb took for `tcb`, and what loading objects
+// with TLS since added to it: its dynamic TLS blocks, its DTV, its keys
+// and the TCB itself, with its initial TLS. The thread has exited.
+void freeTcb(Tcb *tcb) {
+	frg::unique_lock lock{*runtimeTlsMapLock};
+	auto &tcbs = runtimeTlsMap->tcbs;
+	for (size_t i = 0; i < tcbs.size(); i++) {
+		if (tcbs[i] == tcb) {
+			tcbs[i] = tcbs.back();
+			tcbs.pop();
+			break;
+		}
+	}
+	for (size_t i = 0; i < tcb->dtvSize; i++) {
+		if (runtimeTlsMap->indices[i]->tlsModel == TlsModel::dynamic)
+			getAllocator().free(tcb->dtvPointers[i]);
+	}
+	getAllocator().free(tcb->dtvPointers);
+	getAllocator().free(tcb->localKeys);
+	getAllocator().free(tcb->allocation);
+}
