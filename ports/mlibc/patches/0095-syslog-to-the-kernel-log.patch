+// Writes a message that /dev/log did not take where the system's log
+// takes it (ADR 0506): to the kernel log, or, where the program cannot
+// see that, as a service whose file does not name it cannot, to standard
+// error, which Spark keeps in the log as the service's; not there with
+// LOG_PERROR, which copies the message there already. Either way it is
+// one line, <N> with the message's facility and level, then the message.
+// The kernel or Spark puts the program's name in front of it and marks
+// it with the process, so the line has the ident only when the ident is
+// not the program's name, and no process number. Says whether it was
+// taken.
+static bool to_the_log(int priority, const char *text, int length) {
+	char line[1088];
+	const char *name = program_invocation_short_name;
+	int n;
+	if(log_ident[0] && !(name && !strcmp(log_ident, name)))
+		n = snprintf(line, sizeof line, "<%d>%s: %.*s", priority, log_ident, length, text);
+	else
+		n = snprintf(line, sizeof line, "<%d>%.*s", priority, length, text);
+	if(n < 0)
+		return false;
+	if(n >= (int)sizeof line)
+		n = sizeof line - 1;
+	int fd = open("/devices/kmsg", O_WRONLY | O_NOCTTY | O_CLOEXEC);
+	if(fd >= 0) {
+		bool taken = write(fd, line, n) == n;
+		close(fd);
+		return taken;
 	}
+	if(log_options & LOG_PERROR)
+		return false;
+	return write(STDERR_FILENO, line, n) == n;
 }
 
