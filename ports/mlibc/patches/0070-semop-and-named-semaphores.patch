-sem_t *sem_open(const char *, int, ...) {
-	errno = ENOSYS;
-	return SEM_FAILED;
+// Named semaphores, after musl's: a semaphore named /NAME is a file
+// /dev/shm/sem.NAME, as glibc names it, holding one sem_t that every
+// process that opens it maps shared. A process maps each one once, however
+// often it opens it, and keeps the mapping until it closes it as often.
+namespace {
+
+constexpr int namedMax = 256; // SEM_NSEMS_MAX, as musl's
+
+struct Named {
+	ino_t ino;
+	sem_t *sem;
+	int opens;
+};
+
+Named *named;
+FutexLock namedLock;
+
+// The file of semaphore `name` in `buf`, or nullptr with errno set.
+char *named_path(const char *name, char *buf) {
+	while(*name == '/')
+		name++;
+	const char *end = strchrnul(name, '/');
+	if(*end || end == name || (end - name <= 2 && name[0] == '.' && end[-1] == '.')) {
+		errno = EINVAL;
+		return nullptr;
+	}
+	if(end - name > NAME_MAX - 4) {
+		errno = ENAMETOOLONG;
+		return nullptr;
+	}
+	memcpy(buf, "/dev/shm/sem.", 13);
+	memcpy(buf + 13, name, end - name + 1);
+	return buf;
+}
+
+constexpr int namedFlags = O_RDWR | O_NOFOLLOW | O_CLOEXEC | O_NONBLOCK;
+
+} // namespace
+
+sem_t *sem_open(const char *name, int flags, ...) {
+	char buf[NAME_MAX + 10];
+	if(!(name = named_path(name, buf)))
+		return SEM_FAILED;
+
+	// A slot is kept first, as nothing can fail once the file is made.
+	int slot = -1;
+	{
+		frg::unique_lock guard{namedLock};
+		if(!named) {
+			named = static_cast<Named *>(getAllocator().allocate(sizeof(Named) * namedMax));
+			if(!named) {
+				errno = ENOMEM;
+				return SEM_FAILED;
+			}
+			memset(named, 0, sizeof(Named) * namedMax);
+		}
+		long opens = 0;
+		for(int i = 0; i < namedMax; i++) {
+			opens += named[i].opens;
+			if(!named[i].sem && slot < 0)
+				slot = i;
+		}
+		if(opens >= INT_MAX || slot < 0) {
+			errno = EMFILE;
+			return SEM_FAILED;
+		}
+		named[slot].sem = reinterpret_cast<sem_t *>(-1);
+	}
+
+	flags &= O_CREAT | O_EXCL;
+	int cs;
+	pthread_setcancelstate(PTHREAD_CANCEL_DISABLE, &cs);
+	auto fail = [&] {
+		pthread_setcancelstate(cs, nullptr);
+		frg::unique_lock guard{namedLock};
+		named[slot].sem = nullptr;
+		return SEM_FAILED;
+	};
+
+	if(flags == (O_CREAT | O_EXCL) && access(name, F_OK) == 0) {
+		errno = EEXIST;
+		return fail();
+	}
+
+	struct stat st;
+	void *map;
+	bool first = true;
+	sem_t made;
+	mode_t mode = 0;
+	for(;;) {
+		// Unless it must be new, the semaphore may be there already.
+		if(flags != (O_CREAT | O_EXCL)) {
+			int fd = open(name, namedFlags);
+			if(fd >= 0) {
+				if(fstat(fd, &st) < 0
+						|| (map = mmap(nullptr, sizeof(sem_t), PROT_READ | PROT_WRITE,
+							MAP_SHARED, fd, 0)) == MAP_FAILED) {
+					close(fd);
+					return fail();
+				}
+				close(fd);
+				break;
+			}
+			if(errno != ENOENT)
+				return fail();
+		}
+		if(!(flags & O_CREAT))
+			return fail();
+		if(first) {
+			first = false;
+			va_list ap;
+			va_start(ap, flags);
+			mode = va_arg(ap, mode_t) & 0666;
+			unsigned int value = va_arg(ap, unsigned int);
+			va_end(ap);
+			if(value > SEM_VALUE_MAX) {
+				errno = EINVAL;
+				return fail();
+			}
+			sem_init(&made, 1, value);
+		}
+		// Made whole under a name of its own, then linked to its name, so
+		// that no process opens it half made.
+		struct timespec ts;
+		clock_gettime(CLOCK_REALTIME, &ts);
+		char tmp[64];
+		snprintf(tmp, sizeof(tmp), "/dev/shm/tmp-%d", static_cast<int>(ts.tv_nsec));
+		int fd = open(tmp, O_CREAT | O_EXCL | namedFlags, mode);
+		if(fd < 0) {
+			if(errno == EEXIST)
+				continue;
+			return fail();
+		}
+		if(write(fd, &made, sizeof(made)) != sizeof(made) || fstat(fd, &st) < 0
+				|| (map = mmap(nullptr, sizeof(sem_t), PROT_READ | PROT_WRITE, MAP_SHARED,
+					fd, 0)) == MAP_FAILED) {
+			int e = errno;
+			close(fd);
+			unlink(tmp);
+			errno = e;
+			return fail();
+		}
+		close(fd);
+		int e = link(tmp, name) ? errno : 0;
+		unlink(tmp);
+		if(!e)
+			break;
+		munmap(map, sizeof(sem_t));
+		// Someone else made it first: open theirs, unless it had to be new.
+		if(e != EEXIST || flags == (O_CREAT | O_EXCL)) {
+			errno = e;
+			return fail();
+		}
+	}
+
+	// A semaphore this process has mapped already keeps its mapping.
+	frg::unique_lock guard{namedLock};
+	int i = 0;
+	while(i < namedMax && !(named[i].opens && named[i].ino == st.st_ino))
+		i++;
+	if(i < namedMax) {
+		munmap(map, sizeof(sem_t));
+		named[slot].sem = nullptr;
+		slot = i;
+		map = named[i].sem;
+	}
+	named[slot].opens++;
+	named[slot].sem = static_cast<sem_t *>(map);
+	named[slot].ino = st.st_ino;
+	guard.unlock();
+	pthread_setcancelstate(cs, nullptr);
+	return static_cast<sem_t *>(map);
 }
 
-int sem_close(sem_t *) {
-	errno = ENOSYS;
-	return -1;
+int sem_close(sem_t *sem) {
+	frg::unique_lock guard{namedLock};
+	int i = 0;
+	while(named && i < namedMax && !(named[i].opens && named[i].sem == sem))
+		i++;
+	if(!named || i == namedMax) {
+		errno = EINVAL;
+		return -1;
+	}
+	if(--named[i].opens)
+		return 0;
+	named[i].sem = nullptr;
+	named[i].ino = 0;
+	guard.unlock();
+	munmap(sem, sizeof(*sem));
+	return 0;
 }
 
