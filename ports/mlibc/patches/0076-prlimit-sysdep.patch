 int prlimit(pid_t pid, int resource, const struct rlimit *new_limit, struct rlimit *old_limit) {
+	// A system whose kernel reads and sets the limits of other processes
+	// does it in one call.
+	if constexpr (mlibc::IsImplemented<Prlimit>) {
+		if(int e = mlibc::sysdep<Prlimit>(pid, resource, new_limit, old_limit); e) {
+			errno = e;
+			return -1;
+		}
+		return 0;
+	}
 	if(pid && pid != getpid()) {
 		errno = ENOSYS;
