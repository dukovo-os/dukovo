-struct InotifyAddWatch {};
-// int sys_inotify_rm_watch(int ifd, int wd);
-struct InotifyRmWatch {};
 // int sys_mount(const char *source, const char *target, const char *fstype, unsigned long flags, const void *data);
 struct Mount {};
