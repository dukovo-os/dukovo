nl_langinfo() and nl_langinfo_l() give LC_MONETARY's items, as glibc
does: its strings (INT_CURR_SYMBOL, MON_DECIMAL_POINT, MON_THOUSANDS_SEP,
MON_GROUPING, POSITIVE_SIGN and NEGATIVE_SIGN, beside CURRENCY_SYMBOL and
CRNCYSTR, which it gave already), and its numbers (INT_FRAC_DIGITS to
N_SIGN_POSN and INT_P_CS_PRECEDES to INT_N_SIGN_POSN), each a string of
one byte. They were the empty string, so a program that reads a
locale's money from them, as PostgreSQL does where glibc's items are
declared, found no digits after the point and the sign and symbol at
place 0, and wrote $123.00 as (123$). Meant for upstream.

--- a/options/internal/generic/locale.cpp
+++ b/options/internal/generic/locale.cpp
@@ -813,6 +813,26 @@ char *nl_langinfo(nl_item item) {
 	return nl_langinfo_l(item, mlibc::getActiveLocale());
 }
 
+namespace {
+
+// Each byte as a string of its own: nl_langinfo gives the numbers of
+// LC_MONETARY, such as FRAC_DIGITS, as a string of one byte, as glibc
+// does, and a caller reads its first character.
+struct ByteStrings {
+	char strings[256][2];
+};
+
+constexpr ByteStrings makeByteStrings() {
+	ByteStrings table{};
+	for (int i = 0; i < 256; i++)
+		table.strings[i][0] = static_cast<char>(i);
+	return table;
+}
+
+constexpr ByteStrings byteStrings = makeByteStrings();
+
+} // namespace
+
 char *nl_langinfo_l(nl_item item, localeinfo * loc) {
 	__ensure(loc != nullptr);
 #ifdef LC_GLOBAL_LOCALE
@@ -842,10 +862,16 @@ char *nl_langinfo_l(nl_item item, localeinfo * loc) {
 		case YESEXPR ... NOSTR:
 			return const_cast<char *>(l->messages.get(item).asString().data());
 
+		case INT_CURR_SYMBOL ... MON_THOUSANDS_SEP:
+		case POSITIVE_SIGN:
+		case NEGATIVE_SIGN:
 		case CRNCYSTR:
-			return const_cast<char *>(l->monetary.get(CRNCYSTR).asString().data());
-		case CURRENCY_SYMBOL:
-			return const_cast<char *>(l->monetary.get(CURRENCY_SYMBOL).asString().data());
+			return const_cast<char *>(l->monetary.get(item).asString().data());
+		case MON_GROUPING:
+			return const_cast<char *>(reinterpret_cast<const char *>(l->monetary.get(MON_GROUPING).asByteSpan().data()));
+		case INT_FRAC_DIGITS ... N_SIGN_POSN:
+		case INT_P_CS_PRECEDES ... INT_N_SIGN_POSN:
+			return const_cast<char *>(byteStrings.strings[l->monetary.get(item).asUint32() & 0xFF]);
 
 		default: {
 			mlibc::infoLogger() << "mlibc: nl_langinfo item " << frg::hex_fmt{item & 0xFFFF}
