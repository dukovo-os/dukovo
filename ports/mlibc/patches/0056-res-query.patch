+// Asks the nameservers of /etc/resolv.conf in turn for dname's records of
+// type and class, without the search list, as glibc does, with the lookups'
+// own queries: the answer's length, and as much of it as anslen bytes hold
+// in answer, with TC set when it is cut short there, or -1 with h_errno
+// saying why: HOST_NOT_FOUND when the name is not there, NO_DATA when it
+// has no such records, TRY_AGAIN when no server answered or one failed,
+// and NO_RECOVERY when they would not answer or DNS cannot carry the name.
+int res_query(const char *dname, int klass, int type, unsigned char *answer, int anslen) {
+	if(!dname || klass < 0 || klass > 0xFFFF || type < 0 || type > 0xFFFF
+			|| !answer || anslen < NS_HFIXEDSZ) {
+		h_errno = NO_RECOVERY;
+		errno = EINVAL;
+		return -1;
+	}
+	frg::vector<uint8_t, MemoryAllocator> msg{getAllocator()};
+	switch(mlibc::lookup_raw_dns(dname, klass, type, msg)) {
+	case 0:
+		break;
+	case -EAI_AGAIN:
+		h_errno = TRY_AGAIN;
+		return -1;
+	case -EAI_NONAME:
+		h_errno = NO_RECOVERY;
+		errno = EMSGSIZE;
+		return -1;
+	default:
+		h_errno = NO_RECOVERY;
+		return -1;
+	}
+	// The header's RCODE, answer count and TC bit, by its bytes.
+	if((msg[3] & 0xF) == ns_r_nxdomain) {
+		h_errno = HOST_NOT_FOUND;
+		return -1;
+	}
+	if(!msg[6] && !msg[7]) {
+		h_errno = NO_DATA;
+		return -1;
+	}
+	size_t length = msg.size() < static_cast<size_t>(anslen) ? msg.size() : anslen;
+	memcpy(answer, msg.data(), length);
+	if(length < msg.size())
+		answer[2] |= 0x02;
+	return length;
 }
 
