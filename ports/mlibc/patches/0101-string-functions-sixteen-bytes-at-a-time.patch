diff -ruN a/options/ansi/x86_64/string.cpp b/options/ansi/x86_64/string.cpp
--- a/options/ansi/x86_64/string.cpp
+++ b/options/ansi/x86_64/string.cpp
@@ -0,0 +1,197 @@
+// memcmp, memchr, strchr, strchrnul, strncmp and strcpy for x86-64,
+// sixteen bytes at a time with SSE2, which every x86-64 processor has;
+// the portable versions in options/ansi/generic/string.cpp look at one
+// byte at a time. strcmp is __mlibc_strcmp_sse2, in strcmp.cpp.
+//
+// A function may read past the end of what it looks at, but never into
+// another page, where the bytes may not be mapped: an aligned 16-byte
+// load never crosses one, and an unaligned one is made only where the
+// page has 16 bytes left.
+
+#include <emmintrin.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+namespace {
+
+using Vector = __m128i;
+
+constexpr uintptr_t page_size = 4096;
+
+[[gnu::always_inline]] inline Vector load(const unsigned char *p) {
+	return _mm_loadu_si128(reinterpret_cast<const Vector *>(p));
+}
+
+[[gnu::always_inline]] inline Vector load_aligned(const unsigned char *p) {
+	return _mm_load_si128(reinterpret_cast<const Vector *>(p));
+}
+
+// A bit for each of the 16 bytes at which a and b are equal.
+[[gnu::always_inline]] inline unsigned int equal(Vector a, Vector b) {
+	return _mm_movemask_epi8(_mm_cmpeq_epi8(a, b));
+}
+
+// The bytes from p to the end of its page.
+[[gnu::always_inline]] inline size_t page_left(const unsigned char *p) {
+	return page_size - (reinterpret_cast<uintptr_t>(p) & (page_size - 1));
+}
+
+template<typename T>
+[[gnu::always_inline]] inline T load_word(const unsigned char *p) {
+	T word;
+	__builtin_memcpy(&word, p, sizeof(word));
+	return word;
+}
+
+// Compares n bytes, from sizeof(T) to twice that, as two words that
+// overlap in the middle.
+template<typename T>
+int compare_words(const unsigned char *a, const unsigned char *b, size_t n) {
+	size_t at = 0;
+	T x = load_word<T>(a);
+	T y = load_word<T>(b);
+	if(x == y) {
+		at = n - sizeof(T);
+		x = load_word<T>(a + at);
+		y = load_word<T>(b + at);
+		if(x == y)
+			return 0;
+	}
+	// The first byte that differs holds the lowest bit that does, as
+	// x86-64 is little-endian.
+	at += __builtin_ctzll(x ^ y) / 8;
+	return a[at] - b[at];
+}
+
+// The first c, or the end of the string when or_end is true or c is 0;
+// nullptr when the string ends first and or_end is false.
+template<bool or_end>
+char *find(const char *string, int c) {
+	auto s = reinterpret_cast<const unsigned char *>(string);
+	auto byte = static_cast<unsigned char>(c);
+	auto wanted = _mm_set1_epi8(static_cast<char>(byte));
+	auto zero = _mm_setzero_si128();
+	// The bytes of the first block before the string are masked off.
+	auto offset = reinterpret_cast<uintptr_t>(s) & 15;
+	auto block = s - offset;
+	auto chunk = load_aligned(block);
+	unsigned int mask = (equal(chunk, wanted) | equal(chunk, zero)) & (0xffffu << offset);
+	while(!mask) {
+		block += 16;
+		chunk = load_aligned(block);
+		mask = equal(chunk, wanted) | equal(chunk, zero);
+	}
+	auto found = block + __builtin_ctz(mask);
+	if(!or_end && *found != byte)
+		return nullptr;
+	return const_cast<char *>(reinterpret_cast<const char *>(found));
+}
+
+} // namespace
+
+int memcmp(const void *left, const void *right, size_t n) {
+	auto a = static_cast<const unsigned char *>(left);
+	auto b = static_cast<const unsigned char *>(right);
+	if(n >= 16) {
+		size_t i = 0;
+		while(true) {
+			unsigned int mask = ~equal(load(a + i), load(b + i)) & 0xffff;
+			if(mask) {
+				i += __builtin_ctz(mask);
+				return a[i] - b[i];
+			}
+			if(i + 16 == n)
+				return 0;
+			i += 16;
+			// The last 16 bytes, overlapping those before.
+			if(n - i < 16)
+				i = n - 16;
+		}
+	}
+	if(n >= 8)
+		return compare_words<uint64_t>(a, b, n);
+	if(n >= 4)
+		return compare_words<uint32_t>(a, b, n);
+	for(size_t i = 0; i < n; i++) {
+		if(a[i] != b[i])
+			return a[i] - b[i];
+	}
+	return 0;
+}
+
+void *memchr(const void *memory, int c, size_t n) {
+	if(!n)
+		return nullptr;
+	auto s = static_cast<const unsigned char *>(memory);
+	auto wanted = _mm_set1_epi8(static_cast<char>(c));
+	// Counted from the start of the block s is in, whose bytes before s
+	// are masked off. An n that runs past the end of memory runs to it.
+	auto offset = reinterpret_cast<uintptr_t>(s) & 15;
+	auto block = s - offset;
+	size_t end = n + offset;
+	if(end < n)
+		end = SIZE_MAX;
+	unsigned int mask = equal(load_aligned(block), wanted) & (0xffffu << offset);
+	size_t at = 0;
+	while(true) {
+		if(mask) {
+			size_t found = at + __builtin_ctz(mask);
+			if(found >= end)
+				return nullptr;
+			return const_cast<unsigned char *>(block + found);
+		}
+		at += 16;
+		if(at >= end)
+			return nullptr;
+		mask = equal(load_aligned(block + at), wanted);
+	}
+}
+
+char *strchr(const char *s, int c) {
+	return find<false>(s, c);
+}
+
+// This is a GNU extension.
+char *strchrnul(const char *s, int c) {
+	return find<true>(s, c);
+}
+
+int strncmp(const char *left, const char *right, size_t n) {
+	auto a = reinterpret_cast<const unsigned char *>(left);
+	auto b = reinterpret_cast<const unsigned char *>(right);
+	auto zero = _mm_setzero_si128();
+	while(n) {
+		size_t room = page_left(a) < page_left(b) ? page_left(a) : page_left(b);
+		if(room >= 16) {
+			auto x = load(a);
+			// A byte that differs, or the end of both strings.
+			unsigned int mask = (~equal(x, load(b)) | equal(x, zero)) & 0xffff;
+			if(n < 16)
+				mask &= (1u << n) - 1;
+			if(mask) {
+				auto i = __builtin_ctz(mask);
+				return a[i] - b[i];
+			}
+			if(n <= 16)
+				return 0;
+			a += 16;
+			b += 16;
+			n -= 16;
+			continue;
+		}
+		// Up to the end of the page that ends first, a byte at a time.
+		for(; room && n; room--, n--) {
+			if(*a != *b || !*a)
+				return *a - *b;
+			a++;
+			b++;
+		}
+	}
+	return 0;
+}
+
+char *strcpy(char *__restrict dest, const char *src) {
+	memcpy(dest, src, strlen(src) + 1);
+	return dest;
+}
