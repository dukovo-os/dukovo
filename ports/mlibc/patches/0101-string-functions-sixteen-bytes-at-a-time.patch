diff -ruN a/options/ansi/x86_64/essential.cpp b/options/ansi/x86_64/essential.cpp
--- a/options/ansi/x86_64/essential.cpp
+++ b/options/ansi/x86_64/essential.cpp
@@ -0,0 +1,227 @@
+// memcpy, memmove, memset and strlen for x86-64, sixteen bytes at a time
+// with SSE2, which every x86-64 processor has. The portable versions in
+// options/internal/generic/essential.cpp move eight bytes at a time,
+// memmove one when it copies backwards, and strlen reads one. The
+// dynamic linker has these too.
+
+#include <emmintrin.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+
+namespace {
+
+using Vector = __m128i;
+
+[[gnu::always_inline]] inline Vector load(const unsigned char *p) {
+	return _mm_loadu_si128(reinterpret_cast<const Vector *>(p));
+}
+
+[[gnu::always_inline]] inline void store(unsigned char *p, Vector v) {
+	_mm_storeu_si128(reinterpret_cast<Vector *>(p), v);
+}
+
+[[gnu::always_inline]] inline void store_aligned(unsigned char *p, Vector v) {
+	_mm_store_si128(reinterpret_cast<Vector *>(p), v);
+}
+
+template<typename T>
+[[gnu::always_inline]] inline T load_word(const unsigned char *p) {
+	T word;
+	__builtin_memcpy(&word, p, sizeof(word));
+	return word;
+}
+
+template<typename T>
+[[gnu::always_inline]] inline void store_word(unsigned char *p, T word) {
+	__builtin_memcpy(p, &word, sizeof(word));
+}
+
+// Copies up to 64 bytes. Every byte is read before any is written, so
+// the two may overlap either way. The first and the last piece of each
+// size overlap in the middle when n is not twice the size.
+[[gnu::always_inline]] inline void copy_short(unsigned char *d, const unsigned char *s, size_t n) {
+	if(n >= 32) {
+		auto a = load(s);
+		auto b = load(s + 16);
+		auto c = load(s + n - 32);
+		auto e = load(s + n - 16);
+		store(d, a);
+		store(d + 16, b);
+		store(d + n - 32, c);
+		store(d + n - 16, e);
+	} else if(n >= 16) {
+		auto a = load(s);
+		auto b = load(s + n - 16);
+		store(d, a);
+		store(d + n - 16, b);
+	} else if(n >= 8) {
+		auto a = load_word<uint64_t>(s);
+		auto b = load_word<uint64_t>(s + n - 8);
+		store_word(d, a);
+		store_word(d + n - 8, b);
+	} else if(n >= 4) {
+		auto a = load_word<uint32_t>(s);
+		auto b = load_word<uint32_t>(s + n - 4);
+		store_word(d, a);
+		store_word(d + n - 4, b);
+	} else if(n >= 2) {
+		auto a = load_word<uint16_t>(s);
+		auto b = load_word<uint16_t>(s + n - 2);
+		store_word(d, a);
+		store_word(d + n - 2, b);
+	} else if(n) {
+		*d = *s;
+	}
+}
+
+// Copies more than 64 bytes upwards, 64 at a time to aligned stores. The
+// first 16 bytes and the last 64 are read before the loop, and written
+// after it: a destination below an overlapping source then works, as the
+// loop writes only below where it reads next.
+void copy_up(unsigned char *d, const unsigned char *s, size_t n) {
+	auto head = load(s);
+	auto t0 = load(s + n - 64);
+	auto t1 = load(s + n - 48);
+	auto t2 = load(s + n - 32);
+	auto t3 = load(s + n - 16);
+	// From 1 to 16 bytes on, to the next 16-byte boundary.
+	size_t skip = 16 - (reinterpret_cast<uintptr_t>(d) & 15);
+	unsigned char *to = d + skip;
+	const unsigned char *from = s + skip;
+	// The loop stops once 64 bytes or fewer are left: the tail has them.
+	unsigned char *end = d + n - 64;
+	while(to < end) {
+		auto a = load(from);
+		auto b = load(from + 16);
+		auto c = load(from + 32);
+		auto e = load(from + 48);
+		store_aligned(to, a);
+		store_aligned(to + 16, b);
+		store_aligned(to + 32, c);
+		store_aligned(to + 48, e);
+		to += 64;
+		from += 64;
+	}
+	store(d, head);
+	store(d + n - 64, t0);
+	store(d + n - 48, t1);
+	store(d + n - 32, t2);
+	store(d + n - 16, t3);
+}
+
+// Copies more than 64 bytes downwards, to a destination above an
+// overlapping source: copy_up turned around.
+void copy_down(unsigned char *d, const unsigned char *s, size_t n) {
+	auto h0 = load(s);
+	auto h1 = load(s + 16);
+	auto h2 = load(s + 32);
+	auto h3 = load(s + 48);
+	auto tail = load(s + n - 16);
+	// The last 16-byte boundary in the destination, from 0 to 15 bytes
+	// before its end.
+	auto to = reinterpret_cast<unsigned char *>(
+			reinterpret_cast<uintptr_t>(d + n) & ~uintptr_t{15});
+	const unsigned char *from = s + (to - d);
+	// The loop stops once 64 bytes or fewer are left: the head has them.
+	unsigned char *start = d + 64;
+	while(to > start) {
+		to -= 64;
+		from -= 64;
+		auto a = load(from);
+		auto b = load(from + 16);
+		auto c = load(from + 32);
+		auto e = load(from + 48);
+		store_aligned(to, a);
+		store_aligned(to + 16, b);
+		store_aligned(to + 32, c);
+		store_aligned(to + 48, e);
+	}
+	store(d + n - 16, tail);
+	store(d, h0);
+	store(d + 16, h1);
+	store(d + 32, h2);
+	store(d + 48, h3);
+}
+
+[[gnu::always_inline]] inline void move(void *dest, const void *src, size_t n) {
+	auto d = static_cast<unsigned char *>(dest);
+	auto s = static_cast<const unsigned char *>(src);
+	if(n <= 64)
+		copy_short(d, s, n);
+	// Upwards when the destination starts below the source or at or past
+	// its end; the difference wraps around when it is below.
+	else if(reinterpret_cast<uintptr_t>(d) - reinterpret_cast<uintptr_t>(s) >= n)
+		copy_up(d, s, n);
+	else
+		copy_down(d, s, n);
+}
+
+} // namespace
+
+void *memcpy(void *__restrict dest, const void *__restrict src, size_t n) {
+	move(dest, src, n);
+	return dest;
+}
+
+void *memmove(void *dest, const void *src, size_t n) {
+	move(dest, src, n);
+	return dest;
+}
+
+void *memset(void *dest, int c, size_t n) {
+	auto d = static_cast<unsigned char *>(dest);
+	auto byte = static_cast<unsigned char>(c);
+	if(n < 16) {
+		uint64_t word = byte * 0x0101010101010101;
+		if(n >= 8) {
+			store_word(d, word);
+			store_word(d + n - 8, word);
+		} else if(n >= 4) {
+			store_word(d, static_cast<uint32_t>(word));
+			store_word(d + n - 4, static_cast<uint32_t>(word));
+		} else if(n >= 2) {
+			store_word(d, static_cast<uint16_t>(word));
+			store_word(d + n - 2, static_cast<uint16_t>(word));
+		} else if(n) {
+			*d = byte;
+		}
+		return dest;
+	}
+	auto v = _mm_set1_epi8(static_cast<char>(byte));
+	store(d, v);
+	store(d + n - 16, v);
+	if(n <= 32)
+		return dest;
+	// Between the first 16 bytes and the last 16, aligned.
+	auto to = reinterpret_cast<unsigned char *>(
+			(reinterpret_cast<uintptr_t>(d) + 16) & ~uintptr_t{15});
+	unsigned char *end = d + n - 16;
+	for(; end - to >= 64; to += 64) {
+		store_aligned(to, v);
+		store_aligned(to + 16, v);
+		store_aligned(to + 32, v);
+		store_aligned(to + 48, v);
+	}
+	for(; to < end; to += 16)
+		store_aligned(to, v);
+	return dest;
+}
+
+size_t strlen(const char *s) {
+	// An aligned load never crosses a page, so the block the string
+	// starts in can be read whole: its bytes before the string are
+	// shifted out of the mask.
+	auto offset = reinterpret_cast<uintptr_t>(s) & 15;
+	auto block = reinterpret_cast<const Vector *>(reinterpret_cast<uintptr_t>(s) - offset);
+	auto zero = _mm_setzero_si128();
+	unsigned int mask = _mm_movemask_epi8(_mm_cmpeq_epi8(_mm_load_si128(block), zero)) >> offset;
+	if(mask)
+		return __builtin_ctz(mask);
+	while(true) {
+		block++;
+		mask = _mm_movemask_epi8(_mm_cmpeq_epi8(_mm_load_si128(block), zero));
+		if(mask)
+			return reinterpret_cast<const char *>(block) + __builtin_ctz(mask) - s;
+	}
+}
