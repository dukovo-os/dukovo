# GRUB configuration of an installed Dukovo Server @VERSION@, on its EFI
# system partition. `ob image --installed` generates boot/grub/grub.cfg
# from image/grub/installed.cfg.in by filling in the VERSION, TIMEOUT,
# CMDLINE, MODULES, ROOT_UUID and CONSOLE placeholders. See dukovo-boot(7)
# and ADR 0307. CONSOLE is ` console=ttyS0` on a system installed over
# the first serial port, whose sign-in is then there too, and nothing
# otherwise (ADR 0318).
#
# GRUB finds the Dukovo root by its Btrfs UUID and loads the kernel and
# the startup archive from the system's slot, @system.a, so that they
# change together with the system. The kernel command line names the same
# root to Spark, which mounts it and runs everything else from it.

set timeout=@TIMEOUT@
set default=0

# The entry chosen last, Dukovo or Windows, is chosen again: GRUB keeps it
# in its environment block beside this file, which the installer makes
# (ADR 0314). The other entries are never remembered.
if [ -f "${prefix}/grubenv" ]; then
    load_env saved_entry
fi
if [ -n "${saved_entry}" ]; then
    set default="${saved_entry}"
fi

# Mirror the menu on the first serial port, where Radix also writes.
if serial --unit=0 --speed=115200; then
    terminal_input --append serial
    terminal_output --append serial
fi

# As on the USB stick: only the firmware's video drivers, GOP under UEFI
# and VESA under BIOS, with the mode UEFI set kept for Radix's console.
if [ "${grub_platform}" = "efi" ]; then
    insmod efi_gop
    insmod efi_uga
    set gfxpayload=keep
else
    insmod vbe
fi

search --no-floppy --fs-uuid --set=system @ROOT_UUID@

# An installed system restarts 10 seconds after a panic, so that a machine
# nobody is at comes back by itself.
menuentry "Dukovo Server @VERSION@ (Radix)" --id dukovo {
    if [ -f "${prefix}/grubenv" -a "${saved_entry}" != dukovo ]; then
        set saved_entry=dukovo
        save_env saved_entry
    fi
    multiboot2 ($system)/@system.a/startup/radix root=UUID=@ROOT_UUID@ panic=10@CONSOLE@ @CMDLINE@
    module2 ($system)/@system.a/startup/archive bootfs
@MODULES@    boot
}

# Windows, when this computer has it: Windows Boot Manager on Windows'
# own EFI system partition, which GRUB starts as the firmware would, and
# Windows' boot files are left as they are. With Windows here the menu
# always shows, long enough to choose (ADR 0314).
if [ "${grub_platform}" = "efi" ]; then
    if search --no-floppy --file --set=windows /EFI/Microsoft/Boot/bootmgfw.efi; then
        set timeout_style=menu
        if [ "${timeout}" -lt 5 ]; then
            set timeout=5
        fi
        menuentry "Windows Boot Manager" --id windows {
            if [ -f "${prefix}/grubenv" -a "${saved_entry}" != windows ]; then
                set saved_entry=windows
                save_env saved_entry
            fi
            chainloader ($windows)/EFI/Microsoft/Boot/bootmgfw.efi
            boot
        }
    fi
fi

# For a lost administrator's password (ADR 0253). The flags come first,
# so they are the kernel's whatever the command line holds after a lone
# `--`.
menuentry "Dukovo Server @VERSION@: startup trouble" {
    multiboot2 ($system)/@system.a/startup/radix startup-trouble root=UUID=@ROOT_UUID@ panic=10@CONSOLE@ @CMDLINE@
    module2 ($system)/@system.a/startup/archive bootfs
@MODULES@    boot
}

# The firmware's own settings, where the firmware lets GRUB restart into
# them.
if [ "${grub_platform}" = "efi" ]; then
    if fwsetup --is-supported; then
        menuentry "UEFI firmware settings" --id uefi-settings {
            fwsetup
        }
    fi
fi
