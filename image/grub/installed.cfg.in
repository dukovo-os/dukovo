# GRUB configuration of an installed Dukovo Server, on its EFI system
# partition. `ob image --installed` generates boot/grub/grub.cfg from
# image/grub/installed.cfg.in by filling in the TIMEOUT, CMDLINE,
# MODULES, ROOT_UUID and CONSOLE placeholders; the installer fills the
# last two. See dukovo-boot(7) and ADRs 0307 and 0452. CONSOLE is
# ` console=ttyS0` on a system installed over the first serial port, whose
# sign-in is then there too, and nothing otherwise (ADR 0318).
#
# This file stays as the install wrote it. It finds the Dukovo root by
# its Btrfs UUID, reads the slot state beside it, and hands over to the
# menu of the default slot, startup/menu.cfg, which comes and goes with
# the slot's kernel and startup archive, so that an update changes the
# menu as it changes the rest of the system, all at once (ADR 0451). On a
# mirror, each disk's EFI system partition holds this same file and its
# own copies of the slot state, which the system writes on both.

# Quiet boot (ADR 0426): the menu stays hidden for a second, in which
# Esc or F4 shows it, and shows at once when Shift is held as the
# computer starts, for TIMEOUT seconds. A TIMEOUT of 0 starts Dukovo at
# once, with no hidden second. The menu shows too after a start that did
# not finish, and with Windows here, as the slot's menu decides.
set timeout_style=hidden
set timeout=1
set default=0
set dukovo_timeout=@TIMEOUT@
if [ @TIMEOUT@ -eq 0 ]; then
    set timeout=0
fi
if keystatus --shift; then
    set timeout_style=menu
    set timeout=@TIMEOUT@
fi

# The entry chosen last, Dukovo or Windows, is chosen again: GRUB keeps it
# in its environment block beside this file, which the installer makes
# (ADR 0314). The other entries are never remembered.
if [ -f "${prefix}/grubenv" ]; then
    load_env saved_entry
fi
if [ -n "${saved_entry}" ]; then
    set default="${saved_entry}"
fi

# Mirror the menu on the first serial port, where Radix also writes.
if serial --unit=0 --speed=115200; then
    terminal_input --append serial
    terminal_output --append serial
fi

# As on the USB stick: only the firmware's video drivers, GOP under UEFI
# and VESA under BIOS, with the mode UEFI set kept for Radix's console.
if [ "${grub_platform}" = "efi" ]; then
    insmod efi_gop
    insmod efi_uga
    set gfxpayload=keep
else
    insmod vbe
fi

# What the slot's menu starts the kernel with: the root, the serial
# console if the system keeps one, and the machine's own flags.
search --no-floppy --fs-uuid --set=system @ROOT_UUID@
set dukovo_root=@ROOT_UUID@
set dukovo_console="@CONSOLE@"
set dukovo_cmdline="@CMDLINE@"

# More modules the kernel is started with, such as the CPU's microcode,
# from this partition.
function dukovo_modules {
    set dukovo_modules=done
@MODULES@}

# The slot state (ADR 0452): two copies, state1 and state2, each a whole
# GRUB environment block. A copy is whole when its check holds its fields
# and each field is one it can hold; of two whole copies the newer counts,
# by its generation, 0, 1, 2 and round. sysupdate(8) reads them the same
# way. The slot's menu writes the next state over the older copy.
function slot_read {
    unset slot_gen
    unset slot_default
    unset slot_previous
    unset slot_try
    unset slot_tries
    unset slot_boot
    unset slot_check
    set slot_ok=0
    if [ -f "$1" ]; then
        if load_env --file "$1" slot_gen slot_default slot_previous slot_try slot_tries slot_boot slot_check; then
            if [ "${slot_check}" = "${slot_gen}:${slot_default}:${slot_previous}:${slot_try}:${slot_tries}:${slot_boot}" ]; then
                set slot_ok=1
            fi
        fi
    fi
    if [ "${slot_gen}" != 0 -a "${slot_gen}" != 1 -a "${slot_gen}" != 2 ]; then
        set slot_ok=0
    fi
    if [ "${slot_default}" != a -a "${slot_default}" != b ]; then
        set slot_ok=0
    fi
    if [ -n "${slot_previous}" -a "${slot_previous}" != a -a "${slot_previous}" != b ]; then
        set slot_ok=0
    fi
    if [ -n "${slot_try}" -a "${slot_try}" != a -a "${slot_try}" != b ]; then
        set slot_ok=0
    fi
    if [ "${slot_tries}" != 0 -a "${slot_tries}" != 1 -a "${slot_tries}" != 2 -a "${slot_tries}" != 3 ]; then
        set slot_ok=0
    fi
    if [ -n "${slot_boot}" -a "${slot_boot}" != a -a "${slot_boot}" != b ]; then
        set slot_ok=0
    fi
}

slot_read "${prefix}/state1"
set first_ok="${slot_ok}"
set first_gen="${slot_gen}"
set first_default="${slot_default}"
set first_previous="${slot_previous}"
set first_try="${slot_try}"
set first_tries="${slot_tries}"
set first_boot="${slot_boot}"
slot_read "${prefix}/state2"
set second_ok="${slot_ok}"
set slot_older="${prefix}/state1"
set slot_newer="${prefix}/state2"
set slot_take=2
if [ "${first_ok}" = 1 ]; then
    set slot_pair="${slot_gen}:${first_gen}"
    if [ "${second_ok}" != 1 ]; then
        set slot_take=1
    elif [ "${slot_pair}" != "1:0" -a "${slot_pair}" != "2:1" -a "${slot_pair}" != "0:2" ]; then
        set slot_take=1
    fi
fi
if [ "${slot_take}" = 1 ]; then
    set slot_gen="${first_gen}"
    set slot_default="${first_default}"
    set slot_previous="${first_previous}"
    set slot_try="${first_try}"
    set slot_tries="${first_tries}"
    set slot_boot="${first_boot}"
    set slot_older="${prefix}/state2"
    set slot_newer="${prefix}/state1"
fi
# The menu writes over the older copy, or over one that is not whole.
# With neither whole, which no single cut write leaves, slot A starts,
# with slot B offered beside it on the menu, which shows, and nothing is
# written: the system writes the state afresh once it has started.
if [ "${first_ok}" = 1 -o "${second_ok}" = 1 ]; then
    set slot_ok=1
else
    set slot_ok=0
    set slot_gen=0
    set slot_default=a
    set slot_previous=b
    set slot_try=""
    set slot_tries=0
    set slot_boot=a
fi
if [ "${slot_default}" = b ]; then
    set slot_other=a
else
    set slot_other=b
fi

# The default slot's menu, or, if the default cannot be read, the other
# slot's, which then starts as the default.
if [ -f "($system)/@system.${slot_default}/startup/menu.cfg" ]; then
    source "($system)/@system.${slot_default}/startup/menu.cfg"
elif [ -f "($system)/@system.${slot_other}/startup/menu.cfg" ]; then
    set slot_default="${slot_other}"
    set slot_previous=""
    set slot_try=""
    set slot_tries=0
    source "($system)/@system.${slot_default}/startup/menu.cfg"
else
    set timeout_style=menu
    echo "Dukovo cannot find its system on the root @ROOT_UUID@."
    echo "Check that its disk is connected, or start Try Dukovo from an install stick."
fi

# Entries kept on this partition beside the menu, which work without the
# root.
if [ -f "${prefix}/rescue.cfg" ]; then
    source "${prefix}/rescue.cfg"
fi
if [ "${grub_platform}" = "efi" ]; then
    if fwsetup --is-supported; then
        menuentry "UEFI firmware settings" --id uefi-settings {
            fwsetup
        }
    fi
fi
