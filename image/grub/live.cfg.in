# GRUB configuration of the Dukovo Server @VERSION@ install stick and ISO.
# `ob image` generates boot/grub/grub.cfg from image/grub/live.cfg.in by
# filling in the VERSION, TIMEOUT, CMDLINE, MODULES and ENTRIES
# placeholders; ENTRIES holds the disk check's entry of
# `ob image --disk-check`, or nothing. See dukovo-boot(7) and ADR 0308.
#
# Every entry that starts Dukovo starts the live system: the whole system
# from the boot archive, in memory, with `live` on the command line, so
# that Spark takes no disk's root and mounts no disk but the stick's own
# DUKOVO_LIVE partition, read-only. The installer's entries come with the
# installer.

set timeout=@TIMEOUT@
set default=0

# Mirror the menu on the first serial port, where Radix also writes.
if serial --unit=0 --speed=115200; then
    terminal_input --append serial
    terminal_output --append serial
fi

# Only the firmware's video drivers, GOP under UEFI and VESA under BIOS,
# with the mode UEFI set kept for Radix's console, as on an installed
# system.
if [ "${grub_platform}" = "efi" ]; then
    insmod efi_gop
    insmod efi_uga
    set gfxpayload=keep
else
    insmod vbe
fi

# A shell on every console, with no sign-in: the live system has no
# accounts, and nothing on it outlives the boot.
menuentry "Try Dukovo @VERSION@ (live console)" {
    multiboot2 /boot/radix live console-sign-in=off @CMDLINE@
@MODULES@    boot
}

# The machine's own system, as if the stick were not there. GRUB calls the
# disk it started from hd0, so the machine's first disk is hd1. Under UEFI
# it starts the boot loader the firmware would, EFI/BOOT/BOOTX64.EFI on
# that disk's EFI system partition; under a BIOS, the disk's first sector,
# with the disks' BIOS numbers swapped so that it finds itself first, as
# it would with no stick.
menuentry "Boot from first disk" {
    if [ "${grub_platform}" = "efi" ]; then
        for part in (hd1,gpt1) (hd1,gpt2) (hd1,gpt3) (hd1,gpt4); do
            if [ -f "${part}/EFI/BOOT/BOOTX64.EFI" ]; then
                chainloader "${part}/EFI/BOOT/BOOTX64.EFI"
                boot
            fi
        done
        echo "The first disk has no EFI system partition with EFI/BOOT/BOOTX64.EFI."
    else
        set root=(hd1)
        drivemap -s (hd0) (hd1)
        chainloader +1
        boot
    fi
}
@ENTRIES@
