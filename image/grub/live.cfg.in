# GRUB configuration of the Dukovo Server @VERSION@ install stick and ISO.
# `ob image` generates boot/grub/grub.cfg from image/grub/live.cfg.in by
# filling in the VERSION, TIMEOUT, CMDLINE, MODULES, ENTRIES and DEFAULT
# placeholders; ENTRIES holds the disk check's entry of
# `ob image --disk-check`, or nothing. See dukovo-boot(7) and ADR 0308.
#
# Every entry that starts Dukovo starts the live system: the whole system
# from the boot archive, in memory, with `live` on the command line, so
# that Spark takes no disk's root and mounts no disk but the stick's own
# DUKOVO_LIVE partition, read-only. With `install` too, consoled starts
# the installer's screens on tty1 (ADR 0310), or serial-console on the
# first serial port with `console=ttyS0` (ADR 0318). DEFAULT is the entry
# started when nobody chooses one: `install` on a release's stick and
# ISO, `try` in the boot tests' image, whose cases add `install` to
# their own command line when they test the screens.

set timeout=@TIMEOUT@
set default=@DEFAULT@

# Only the firmware's video drivers, GOP under UEFI and VESA under BIOS,
# with the mode UEFI set kept for Radix's console, as on an installed
# system. UEFI's menu keeps that mode too; a BIOS's takes the first of
# these its card has, each wide enough for the menu's box.
if [ "${grub_platform}" = "efi" ]; then
    insmod efi_gop
    insmod efi_uga
    set gfxpayload=keep
    set gfxmode=auto
else
    insmod vbe
    set gfxmode=1280x800,1024x768,800x600,auto
fi

# The menu drawn in Dukovo's colours and the console's font, as the
# installer's screens are (ADR 0402): `ob image` writes the theme and its
# fonts into boot/grub/theme. Where the screen cannot be drawn on, the
# plain menu shows.
if loadfont ${prefix}/theme/spleen-24.pf2; then
    loadfont ${prefix}/theme/spleen-32.pf2
    if terminal_output gfxterm; then
        set theme=${prefix}/theme/theme.txt
    fi
fi

# Mirror the menu on the first serial port, where Radix also writes. It
# keeps GRUB's plain menu.
if serial --unit=0 --speed=115200; then
    terminal_input --append serial
    terminal_output --append serial
fi

# The installer's screens on tty1, and a shell on the other consoles
# with no sign-in: the live system has no accounts.
menuentry "Install Dukovo @VERSION@" --id install {
    multiboot2 /boot/radix live install console-sign-in=off @CMDLINE@
@MODULES@    boot
}

# A shell on every console, with no sign-in: the live system has no
# accounts, and nothing on it outlives the boot.
menuentry "Try Dukovo @VERSION@ (live console)" --id try {
    multiboot2 /boot/radix live console-sign-in=off @CMDLINE@
@MODULES@    boot
}

# The installer's screens on the first serial port, ttyS0, for a
# computer with no screen, and a shell there after them (ADR 0318); this
# menu already shows on that port. The installed system keeps
# `console=ttyS0`, so that its sign-in is on the port too.
menuentry "Install Dukovo @VERSION@ (serial console)" --id install-serial {
    multiboot2 /boot/radix live install console=ttyS0 console-sign-in=off @CMDLINE@
@MODULES@    boot
}

# The machine's own system, as if the stick were not there. Under UEFI
# it starts the boot loader the firmware would, EFI/BOOT/BOOTX64.EFI on
# an EFI system partition, from the first disk that has one: UEFI's GRUB
# numbers disks as the firmware lists them, which need not put the stick
# first, so every disk is looked at, and a partition that holds the live
# system's kernel, boot/radix, is passed over as this stick's own, or
# another Dukovo stick's. The partition becomes GRUB's root first: the
# chainloader tells the loader it starts that it was loaded from the
# root, and a GRUB told the stick finds the stick's menu again, not its
# own. Under a BIOS, GRUB calls the disk it started from hd0, so the
# machine's first disk is hd1: it starts that disk's first sector, with
# the disks' BIOS numbers swapped so that it finds itself first, as it
# would with no stick.
menuentry "Boot from first disk" --id first-disk {
    if [ "${grub_platform}" = "efi" ]; then
        # Eight partitions each: the manual layout can put the EFI system
        # partition after others.
        for d in hd0 hd1 hd2 hd3 hd4 hd5 hd6 hd7; do
            for n in 1 2 3 4 5 6 7 8; do
                set part="(${d},gpt${n})"
                if [ -f "${part}/EFI/BOOT/BOOTX64.EFI" -a ! -f "${part}/boot/radix" ]; then
                    set root="${part}"
                    chainloader /EFI/BOOT/BOOTX64.EFI
                    boot
                fi
            done
        done
        echo "No disk but the stick has an EFI system partition with EFI/BOOT/BOOTX64.EFI."
    else
        set root=(hd1)
        drivemap -s (hd0) (hd1)
        chainloader +1
        boot
    fi
}
@ENTRIES@
